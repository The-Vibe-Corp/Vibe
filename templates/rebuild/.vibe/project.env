TYPE=rebuild
REVIEWER=code-reviewer_glm
TESTER=test-agent
SANDBOX=on
SANDBOX_TOOLS="git python3 wine java ghidra analyzeHeadless gdb strace ltrace strings objdump readelf appimagetool linuxdeploy patchelf podman"
VERIFY_TOOLS="bash python3 git"
VERIFY_QUICK="python3 scripts/rebuild-env.py --check"
VERIFY_PACKAGE="python3 scripts/rebuild-env.py --check"
VERIFY_FULL="python3 scripts/rebuild-env.py --check && python3 -m unittest discover -s tests -v"
VERIFY_TESTS="tests"
VERIFY_MIN_TESTS=1
VERIFY_TEST_PATTERN="Ran ([0-9]+) tests?"
# Pflichtgruppen: ohne diese Werkzeuge ist keine belastbare Analyse möglich.
# Für reine Quellcode-Rebuilds kann "analyse" entfernt werden; Ghidra,
# Packaging und CI bleiben optional, bis die Anwendung sie braucht.
REBUILD_REQUIRED_GROUPS="core analyse"
# MAX_PACKAGES=80   # Kostenbremse: bei bezahlten Modellen z. B. 5 setzen

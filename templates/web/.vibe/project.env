TYPE=web
REVIEWER=code-reviewer_glm
TESTER=test-agent
SANDBOX=on
SANDBOX_TOOLS="git node npm"
VERIFY_QUICK="npm test --silent"
VERIFY_PACKAGE="npm test --silent"
VERIFY_FULL="npm ci --silent && npm test --silent && npm run build --if-present"
# MAX_PACKAGES=80   # Kostenbremse: bei bezahlten Modellen z. B. 5 setzen

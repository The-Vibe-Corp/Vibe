UI_BIND = PATHS.ui_bind
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9_-]*$")
# GH-76: Die code-gewirkten Vorgaben für laufzeitgesteuerte Agentenarbeit
# stehen nicht mehr in einer sichtbaren AGENTS.md. Der Läufer schreibt diesen
# Text in eine versteckte Datei außerhalb jedes Projekts und übergibt sie
# opencode als zusätzliche `instructions`-Quelle (höhere Priorität als
# AGENTS.md).
PLATFORM_INSTRUCTIONS = vibe_harness.PLATFORM_INSTRUCTIONS
FRONTMATTER_RE = re.compile(r"---[ \t]*\r?\n(.*?)\r?\n---[ \t]*(?:\r?\n|$)", re.S)
FRONT_KEY_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_-]*):[ \t]*(.*)$")
AGENT_FIELDS = ("description", "mode", "model", "temperature", "steps")
_AGENT_VERSION = None
C = {"g": "\033[32m", "r": "\033[31m", "y": "\033[33m", "b": "\033[1m", "d": "\033[2m", "0": "\033[0m"}
def col(c, s, stream=None): return f"{C[c]}{s}{C['0']}" if (stream or sys.stdout).isatty() else s

def run(argv, cwd=None, timeout=60, env=None):
    """Startet ein Programm ohne Shell und liefert (Exitcode, Ausgabe).

    ``argv`` ist eine Liste aus Programm und Argumenten. Namen, Pfade und
    Agenten bleiben getrennte Listenelemente und werden nie von einer Shell
    ausgewertet. Exitcode 127 bedeutet "Programm nicht gefunden", 124 eine
    Zeitüberschreitung.
    """
    if (not isinstance(argv, (list, tuple)) or not argv
            or not all(isinstance(arg, str) for arg in argv)):
        raise ValueError("Argumentliste erwartet: Programm und Argumente als Zeichenketten")
    argv = list(argv)
    try:
        p = subprocess.run(argv, cwd=cwd, env=env, capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout + p.stderr).strip()
    except FileNotFoundError:
        return 127, "Programm nicht gefunden: " + argv[0]
    except subprocess.TimeoutExpired:
        return 124, f"Zeitüberschreitung nach {timeout:g} s: {argv[0]}"
    except OSError as error:
        return 126, f"Programm nicht ausführbar: {argv[0]}: {error}"

def git_run(root, *args):
    """Liest Git-Informationen, ohne Projekt-Hooks (core.fsmonitor) auszuführen."""
    return run(["git", "--no-pager", "-c", "core.fsmonitor=false", *args], cwd=root)

def require_agent(agent):
    """Bricht bei Agentennamen ab, die keine Shell als ein Wort sehen würde."""
    if not NAME_RE.match(agent or ""):
        sys.exit("Agentenname: nur a-z, 0-9, _ und - (keine Leerzeichen oder Shellzeichen)")
    return agent

def in_container(): return os.path.exists("/run/.containerenv") or bool(os.environ.get("CONTAINER_ID"))
def safe(name): return re.sub(r"[^A-Za-z0-9_-]", "_", name)

def run_key(name):
    """Eindeutiger Laufschlüssel je Projekt (Logs, tmux-Sitzung, Pause, Register).

    Zwei Projekte dürfen nach dem Normalisieren nicht denselben Schlüssel
    erhalten: Sobald ein Name Zeichen enthält, die ``safe`` ersetzt, oder ein
    anderer Projektname auf denselben normalisierten Namen zeigt, kommt ein
    Fingerabdruck des Projektpfads hinzu. Eindeutige, unveränderte Namen
    behalten ihren Namen, damit bestehende Logs und Sitzungen weiter passen.
    """
    base = safe(name)
    mapping = project_map()
    others = [other for other in mapping if other != name and safe(other) == base]
    # "ui" und "server" sind bereits die Sitzungen des Dashboards und des
    # opencode-Servers. Ein gleichnamiges Projekt darf sie nicht übernehmen.
    if base in ("ui", "server"):
        return f"{base}-{vibe_runs.digest(mapping.get(name) or name)}"
    if base == name and not others:
        return base
    return f"{base}-{vibe_runs.digest(mapping.get(name) or name)}"

def logpath(name, kind="run"): return os.path.join(LOGS, run_key(name) + (".verify.log" if kind == "verify" else ".log"))

def child_exports(paths=None):
    """Exportiert die aufgelösten Pfade für tmux-Kindprozesse.

    ``paths`` erlaubt ein erneut aufgelöstes Paths-Objekt (AP13: Der
    Dashboard-Start berücksichtigt ui.json im Zustandsordner; die effektiv
    geltenden Werte werden dem Kind übergeben). Ohne Übergabe gelten die
    beim Import aufgelösten Pfade. Schlüssel sind feste Konstanten, Werte
    werden mit ``shlex.quote`` als ein Argument geschützt. Pfade mit
    Leerzeichen bleiben dadurch unverändert.
    """
    return " ".join(
        f"export {key}={shlex.quote(value)};"
        for key, value in (paths or PATHS).child_env().items()
    )

def profile_session(base):
    """Eigene tmux-Sitzung je Profil, damit Dev und Prod parallel laufen."""
    return base if PATHS.profile == "prod" else base + "-" + PATHS.profile

def run_socket(session):
    """Eigener tmux-Server je Agentenlauf (V-026).

    Der Socket-Name ist der Sitzungsname. Ein fremdes ``tmux kill-server`` auf
    dem Standard-Server beendet damit weder Dashboard noch laufende Läufe.
    Dashboard und opencode-Server bleiben auf dem Standard-Server.
    """
    return session

def tmux_argv(session, *arguments, own_socket=False):
    """tmux-Aufruf als Argumentliste; Laufsitzungen auf ihrem eigenen Server."""
    argv = ["tmux"]
    if own_socket and session:
        argv += ["-L", run_socket(session)]
    return argv + list(arguments)

def tmux_session_state(session, own_socket=False):
    """Prüft eine bereits aufgelöste Sitzung: True, False oder None.

    ``True`` bedeutet vorhanden, ``False`` sicher nicht vorhanden (tmux
    antwortet regulär mit Exit 1). Fehlt tmux oder endet die Abfrage anders
    (nicht ausführbar, Zeitüberschreitung, unerwarteter Fehlercode), ist das
    Ergebnis ``None``: nicht prüfbar. Aufrufer dürfen ``None`` nie als
    "Sitzung fehlt" behandeln. ``own_socket`` prüft eine Laufsitzung auf
    ihrem eigenen tmux-Server.
    """
    if not session:
        return None
    code = run(tmux_argv(session, "has-session", "-t", session,
                         own_socket=own_socket))[0]
    if code == 0:
        return True
    if code == 1:
        return False
    return None

def tmux_session_exists(session):
    """Prüft eine bereits aufgelöste Sitzung (nicht den Projektnamen)."""
    return tmux_session_state(session) is True

def session_marker(session, own_socket=False):
    """Markierung einer tmux-Sitzung: run, ui, server oder fremd.

    ``VIBE_MANAGED`` wird beim Anlegen der Sitzung gesetzt. Fehlt die
    Variable, ist die Sitzung fremd; ein leerer Erfolg (z. B. eine Attrappe
    ohne Umgebungsauskunft) bleibt ``unbekannt`` und wird nie als Nachweis
    für eine fremde Sitzung verwendet.
    """
    rc, out = run(tmux_argv(session, "show-environment", "-t", session,
                            MANAGED_VAR, own_socket=own_socket))
    if rc == 0:
        line = out.strip().splitlines()[-1] if out.strip() else ""
        prefix = MANAGED_VAR + "="
        if line.startswith(prefix):
            return line[len(prefix):].strip() or "unbekannt"
        return "unbekannt"
    if "unknown variable" in out.lower():
        return "unmanaged"
    return "unbekannt"

def session_owned(session, kind, own_socket=False):
    return session_marker(session, own_socket=own_socket) == kind

def port_in_use(host, port):
    """Erkennt einen bereits lauschenden Dienst auf einem Loopback-Port."""
    try:
        with socket.create_connection((str(host), int(port)), timeout=0.5):
            return True
    except OSError:
        return False

def dashboard_health(bind=None, port=None):
    """Health-Antwort des eigenen Dashboards; fremde Dienste zählen nicht.

    Der Health-Endpunkt ist absichtlich ohne Token lesbar. ``bind``/``port``
    erlauben die Abfrage gegen erneut aufgelöste Werte (AP13: ui.json). Zusätzlich
    zur App-Kennung muss die Instanzkennung der laufenden Laufzeit entsprechen;
    ein fremder Dienst auf dem Port wird dadurch nicht für vibe gehalten.
    """
    bind = UI_BIND if bind is None else bind
    port = UI_PORT if port is None else port
    rc, out = run(["curl", "-sf", "--max-time", "2",
                   f"http://{bind}:{port}/api/health"])
    if rc != 0:
        return None
    try:
        data = json.loads(out)
    except ValueError:
        return None
    if not isinstance(data, dict) or data.get("app") != "vibe":
        return None
    try:
        expected = open(INSTFILE, encoding="utf-8").read().strip()
    except OSError:
        expected = ""
    if expected and data.get("instance") != expected:
        return None
    return data

# ---------- Entwicklungsordner (Roots) und Projekte ----------
BAD_ROOTS = {"/", "/usr", "/etc", "/bin", "/sbin", "/lib", "/lib64", "/proc", "/sys", "/dev", "/boot", "/root", "/run", "/var", "/tmp", "/home", "/opt", "/mnt", "/media"}

def conf_extra():
    try:
        with open(CONF, encoding="utf-8") as f:
            return [str(x) for x in json.load(f).get("roots", [])]
    except Exception:
        return []

def _real(path):
    """Vergleichspfad für Verzeichnisse; Symlink-Aliase gelten als gleich."""
    return os.path.realpath(os.path.abspath(os.path.expanduser(path)))

def roots():
    out = [VIBE]
    seen = {_real(VIBE)}
    for r in conf_extra():
        p = os.path.abspath(os.path.expanduser(r))
        real = _real(p)
        if real in seen or not os.path.isdir(p): continue
        seen.add(real)
        out.append(p)
    return out

def roots_save(extra, expected=None):
    os.makedirs(PATHS.state, exist_ok=True)
    vibe_storage.write_text(CONF, json.dumps({"roots": extra}, indent=1), expected=expected)

def root_add(path):
    text = (path or "").strip() if isinstance(path, str) else ""
    if not text: raise ValueError("Pfad fehlt")
    p = os.path.abspath(os.path.expanduser(text))
    real = _real(p)
    if real in {_real(x) for x in BAD_ROOTS} or real == _real(os.path.expanduser("~")):
        raise ValueError("Pfad zu allgemein, bitte einen Entwicklungsordner wählen: " + p)
    if not os.path.isdir(p): raise ValueError("Ordner existiert nicht: " + p)
    if real == _real(VIBE):
        _pm.clear()
        return VIBE
    extra = conf_extra()
    for existing in extra:
        existing_path = os.path.abspath(os.path.expanduser(existing))
        if _real(existing_path) == real:
            _pm.clear()
            return existing_path
    before = vibe_storage.read_snapshot(CONF)
    extra.append(p)
    roots_save(extra, expected=before.digest if before.exists else vibe_storage.MISSING)
    _pm.clear()
    return p

def root_remove(path):
    text = (path or "").strip() if isinstance(path, str) else ""
    if not text: raise ValueError("Pfad fehlt")
    p = os.path.abspath(os.path.expanduser(text))
    real = _real(p)
    if real == _real(VIBE): raise ValueError("Der Standardordner kann nicht entfernt werden.")
    before = vibe_storage.read_snapshot(CONF)
    extra = conf_extra()
    remaining = [x for x in extra if _real(x) != real]
    if remaining != extra:
        roots_save(remaining, expected=before.digest if before.exists else vibe_storage.MISSING)
    _pm.clear()

_pm = {}
def _project_rank(path, name):
    """Bevorzugt den echten Projektpfad gegenüber einem Symlink-Alias."""
    return (os.path.islink(path), os.path.basename(os.path.realpath(path)) != name)

def _project_candidates(root):
    try: names = sorted(os.listdir(root))
    except OSError: return
    for n in names:
        if n.startswith(("_", ".")): continue
        p = os.path.join(root, n)
        try:
            if not os.path.isdir(p): continue
            if not (os.path.exists(os.path.join(p, ".git")) or os.path.isdir(os.path.join(p, ".vibe"))): continue
            real = os.path.realpath(p)
        except OSError:
            continue
        yield n, p, real

def _project_key(name, root, taken):
    """Macht gleiche Projektnamen aus mehreren Wurzeln eindeutig und stabil."""
    if name not in taken: return name
    base = os.path.basename(os.path.normpath(root)) or "root"
    key = f"{name}@{base}"
    counter = 2
    while key in taken:
        key = f"{name}@{base}-{counter}"
        counter += 1
    return key

def project_map():
    if _pm.get("t", 0) > time.time() - 2: return _pm["m"]
    found = {}
    for root in roots():
        for name, path, real in _project_candidates(root):
            current = found.get(real)
            if current is None or _project_rank(path, name) < _project_rank(current[0], current[1]):
                found[real] = (path, name, root)
    m = {}
    for real in sorted(found, key=lambda item: (found[item][1], found[item][2], item)):
        path, name, root = found[real]
        m[_project_key(name, root, m)] = path
    _pm["t"], _pm["m"] = time.time(), m
    return m

def projects(): return list(project_map())

def ppath(name):
    p = project_map().get(name)
    if not p: sys.exit(f"Projekt '{name}' nicht gefunden. Entwicklungsordner: {', '.join(roots())}")
    return p

def read_env(path):
    d = {}
    if os.path.exists(path):
        with open(path, encoding="utf-8") as f:
            for l in f:
                m = re.match(r'\s*([A-Z_]+)=(.*)', l)
                if m: d[m.group(1)] = m.group(2).strip().strip('"').strip("'")
    return d

def penv(name): return read_env(os.path.join(ppath(name), ".vibe", "project.env"))
def is_init(name): return os.path.exists(os.path.join(ppath(name), ".vibe", "project.env"))

# Datei-Marker je Projekttyp; gemeinsam für die Typ-Erkennung registrierter
# Projekte (ptype) und frisch ausgecheckter Projekte (AP8, _detect_project_type).
TYPE_MARKERS = (
    ("gradlew", "android"),
    ("pubspec.yaml", "flutter"),
    ("package.json", "web"),
    ("pyproject.toml", "python"),
    ("docker-compose.yml", "docker"),
    ("compose.yaml", "docker"),
)

def ptype(name):
    p = ppath(name)
    t = penv(name).get("TYPE")
    if t: return t
    return type_from_markers(p)

def type_from_markers(project):
    """Erkennt den Projekttyp anhand von Datei-Markern im Projektordner."""
    for f, ty in TYPE_MARKERS:
        if os.path.exists(os.path.join(project, f)): return ty
    return "generic"

def cmd_roots(action=None, path=None):
    try:
        if action == "add" and path:
            p = root_add(path); print(col("g", "Eingelesen: " + p))
        elif action in ("rm", "remove") and path:
            root_remove(path); print("Entfernt:", path)
        elif action:
            sys.exit("vibe roots [add <pfad>|rm <pfad>]")
    except ValueError as e:
        sys.exit(str(e))
    print(col("b", "Entwicklungsordner:"))
    pm = project_map()
    for r in roots():
        n = [k for k, v in pm.items() if os.path.dirname(v) == r]
        print(f"  {r}  ({len(n)} Projekte{': ' + ', '.join(n) if n else ''})")
    uninit = [k for k in pm if not is_init(k)]
    if uninit: print(col("y", "Nicht für vibe vorbereitet: " + ", ".join(uninit) + "  -> vibe init <projekt>"))

# ---------- Arbeitspakete und Feedback (Ticketspeicher) ----------
# Seit GH-48 liegen Arbeitspakete, Bugs und Feedback einheitlich und
# maschinenlesbar im Ticketspeicher (.vibe/tickets.json). Die getrennten
# Markdown-Ledger TICKETS.md/FEEDBACK.md sind entfallen; die Oberflächen
# lesen und schreiben ausschließlich über bin/vibe_tickets.

def _ticket_row(record):
    """Zeilenform eines Tickets für Oberflächen und Dienste."""
    state = record.get("state")
    return {
        "id": record.get("id"),
        "title": record.get("title"),
        "description": record.get("description") or "",
        "state": vibe_tickets.display_state(record),
        "completed": state == "done",
        "status": state if state in ("draft", "in-progress") else "",
        "github": record.get("github"),
    }


def open_items(name):
    """Alle nicht erledigten Tickets als ``(id, Titel[:60], Anzeigezustand)``.

    Die Reihenfolge entspricht dem Ticketspeicher; erledigte Tickets
    entfallen.
    """
    out = []
    for record in vibe_tickets.load(ppath(name)):
        if record.get("state") == "done":
            continue
        out.append((record.get("id"), (record.get("title") or "")[:60],
                    vibe_tickets.display_state(record)))
    return out


def ticket_items(name):
    """Arbeitspakete (type task/feature) mit Titel, Beschreibung und Status."""
    return [_ticket_row(record) for record in vibe_tickets.load(ppath(name))
            if record.get("type") in ("task", "feature")]


def feedback_items(name):
    """Bug-/Feedback-Punkte mit ``kind`` (bug oder feedback)."""
    rows = []
    for record in vibe_tickets.load(ppath(name)):
        if record.get("type") not in ("bug", "feedback"):
            continue
        row = _ticket_row(record)
        row["kind"] = "bug" if record.get("type") == "bug" else "feedback"
        rows.append(row)
    return rows


def add_ticket(name, tid, title, description="", type="task", state="open"):
    """Legt ein Arbeitspaket an; ohne ID wird eine Auto-ID (AP<n>) vergeben.

    ``state`` ist optional (Standard ``open``); gültig sind draft/open/
    in-progress. Erledigt-/Blockiert-Zustände bleiben dem Läufer vorbehalten.
    """
    record = vibe_tickets.add(ppath(name), title, description, type=type,
                              tid=(tid or "").strip(), state=state)
    return record["id"]


def add_feedback(name, title, description="", state="open"):
    """Legt einen Feedback-Punkt an (Typ feedback, Auto-ID F<n>)."""
    return vibe_tickets.add(ppath(name), title, description,
                            type="feedback", state=state)["id"]


def add_bug(name, title, description="", state="open"):
    """Legt eine Bugmeldung an (Typ bug, Auto-ID B<n>)."""
    return vibe_tickets.add(ppath(name), title, description,
                            type="bug", state=state)["id"]


def ticket_update(name, fid, title, description=""):
    """Ändert Titel und Beschreibung eines vorhandenen Arbeitspakets."""
    vibe_tickets.update(ppath(name), fid, title=title, description=description)


def ticket_delete(name, fid):
    """Entfernt genau ein Arbeitspaket; erledigte bleiben als Nachweis erhalten."""
    vibe_tickets.delete(ppath(name), fid)


def feedback_update(name, fid, title, description=""):
    """Ändert Titel und Beschreibung eines vorhandenen Feedback-Punkts."""
    vibe_tickets.update(ppath(name), fid, title=title, description=description)


def feedback_delete(name, fid):
    """Entfernt genau einen Feedback-Punkt; erledigte bleiben erhalten."""
    vibe_tickets.delete(ppath(name), fid)


# ---------- Schreibrechte je Projekt ----------
WRITE_DIRS_DEFAULT = "/tmp/opencode"

def _norm_write_dir(value):
    """Prüft und normalisiert ein erlaubtes Schreibverzeichnis (Quelle: vibe_sandbox)."""
    import vibe_sandbox
    return vibe_sandbox.normalize_dir(value)

def write_dirs_path(name): return os.path.join(ppath(name), ".vibe", "permissions.json")

def write_dirs_default(name):
    import vibe_sandbox
    return [vibe_sandbox.normalize_dir(vibe_sandbox.WRITE_DIRS_DEFAULT), os.path.realpath(ppath(name))]

def write_dirs_custom(name): return os.path.exists(write_dirs_path(name))

def write_dirs(name):
    """Erlaubte Schreibverzeichnisse des Projekts; ohne Datei gelten die Standards."""
    import vibe_sandbox
    return vibe_sandbox.project_write_dirs(ppath(name))

def write_dirs_save(name, paths, expected=None):
    normalized = []
    for value in paths:
        path = _norm_write_dir(value)
        if path not in normalized: normalized.append(path)
    fp = write_dirs_path(name)
    os.makedirs(os.path.dirname(fp), exist_ok=True)
    vibe_storage.write_text(fp, json.dumps({"write_dirs": normalized}, indent=1, ensure_ascii=False) + "\n", expected=expected)
    return normalized

def _write_dirs_expectation(name):
    snapshot = vibe_storage.read_snapshot(write_dirs_path(name))
    return snapshot.digest if snapshot.exists else vibe_storage.MISSING

def write_dirs_add(name, path):
    expected = _write_dirs_expectation(name)
    dirs = write_dirs(name); target = _norm_write_dir(path)
    if target in dirs: raise ValueError("Verzeichnis ist bereits erlaubt: " + target)
    return write_dirs_save(name, dirs + [target], expected=expected)

def write_dirs_remove(name, path):
    expected = _write_dirs_expectation(name)
    dirs = write_dirs(name); target = _norm_write_dir(path)
    if target not in dirs: raise ValueError("Verzeichnis ist nicht in der Liste: " + target)
    return write_dirs_save(name, [d for d in dirs if d != target], expected=expected)

def write_dirs_reset(name):
    fp = write_dirs_path(name)
    if os.path.exists(fp): os.remove(fp)
    return write_dirs_default(name)

def cmd_rights(name, action=None, path=None):
    try:
        if action in ("add", "rm", "remove"):
            if not path: sys.exit("Pfad fehlt: vibe rights <projekt> " + action + " <pfad>")
            if action == "add": write_dirs_add(name, path)
            else: write_dirs_remove(name, path)
        elif action == "reset": write_dirs_reset(name)
        elif action not in (None, "list"): sys.exit("vibe rights <projekt> [list|add <pfad>|rm <pfad>|reset]")
        dirs = write_dirs(name)
    except ValueError as e:
        sys.exit(str(e))
    defaults = write_dirs_default(name)
    print(col("b", f"Schreibrechte für {name}:") + ("" if write_dirs_custom(name) else "  (Standard)"))
    for d in dirs: print(f"  {d}" + ("  (Standard)" if d in defaults else ""))
    print(col("d", "Anpassen: vibe rights " + name + " add|rm <pfad>, zurücksetzen: vibe rights " + name + " reset"))
    print(col("d", "Die Liste begrenzt edit, nicht Shell-Befehle (bash): Agenten mit Shellzugriff können außerhalb der Liste schreiben."))

# ---------- Priorisierung der Arbeitspakete (AP11) ----------
# Die Reihenfolge der Arbeitspakete/Feedback/Bugs ist je Projekt einstellbar
# (PACKAGE_ORDER in .vibe/project.env) und für die Agentenläufe verbindlich.
def cmd_priority(name, action=None, values=None):
    try:
        if action == "set":
            if not values or not values.strip():
                sys.exit("Kennungen fehlen: vibe priority " + name + " set <Kennungen>")
            order = vibe_packages.normalize_order(ppath(name), values)
            set_env_values(name, {vibe_packages.ORDER_KEY: " ".join(order)})
        elif action == "clear":
            set_env_values(name, {vibe_packages.ORDER_KEY: ""})
        elif action not in (None, "list"):
            sys.exit("vibe priority <projekt> [list|set <Kennungen>|clear]")
        view = vibe_packages.priority_view(ppath(name))
    except ValueError as e:
        sys.exit(str(e))
    print(col("b", f"Priorisierung für {name}:")
          + ("" if view["order"] else "  (keine; Standardordnung: TICKETS vor FEEDBACK, dann Priorität)"))
    marks = {"erledigt": col("d", "  (erledigt — der Priorisierung entnommen)"),
             "gesperrt": col("y", "  (BLOCKIERT)"),
             "wartet auf Merge": col("y", "  (wartet auf Merge)"),
             "fehlt": col("y", "  (unbekannt)")}
    for entry in view["order"]:
        print(f"  {entry['id']}" + marks.get(entry["status"], ""))
    print(col("b", "Effektive Abarbeitungsreihenfolge:"))
    for index, item in enumerate(view["queue"], 1):
        print(f"  {index}. {item['id']}" + (col("d", "  (priorisiert)") if item["ordered"] else ""))
    print(col("d", "Ändern: vibe priority " + name + " set <Kennungen>, leeren: vibe priority " + name + " clear"))
    print(col("d", "Die Priorisierung ist verbindlich: der Läufer wählt den ersten geeigneten Eintrag vor der Standardordnung; erledigte Aufgaben werden der Priorisierung entnommen."))

# ---------- Shell-Sandbox je Projekt ----------
def set_env_values(name, values, quote=True):
    """Ersetzt oder ergänzt Schlüssel in .vibe/project.env und erhält alle anderen Zeilen.

    ``quote=False`` schreibt die Werte ohne Anführungszeichen (AP10-Schranken:
    reine Zahlen und ``ask``/``off`` brauchen keine Quotierung und der
    Abnahmetest verlangt die Zeilenform ``SCHLUESSEL=WERT``).
    """
    fp = os.path.join(ppath(name), ".vibe", "project.env")
    snapshot = vibe_storage.read_snapshot(fp)
    if not snapshot.exists:
        raise ValueError("Nicht für vibe vorbereitet: " + fp)
    text = snapshot.text
    newline = "\r\n" if "\r\n" in text else "\n"
    lines = text.splitlines(True)
    for key, value in values.items():
        if not re.fullmatch(r"[A-Z_]+", key):
            raise ValueError("Ungültiger Einstellungsschlüssel: " + key)
        if value is None:
            # AP10: Ein leerer Projektwert entfernt die Zeile vollständig,
            # damit die Schranke wieder als „nicht gesetzt“ gilt.
            pattern = re.compile(r"^\s*" + re.escape(key) + r"\s*=")
            lines = [line for line in lines if not pattern.match(line)]
            continue
        text_value = str(value)
        if any(c in text_value for c in ("\x00", "\n", "\r")):
            raise ValueError("Einstellung enthält unerlaubte Steuerzeichen: " + key)
        if quote:
            line = f'{key}="{text_value}"' if text_value else f'{key}=""'
        else:
            line = f"{key}={text_value}"
        pattern = re.compile(r"^\s*" + re.escape(key) + r"\s*=")
        replaced = False
        target = None
        for i, current in enumerate(lines):
            if pattern.match(current): target = i
        if target is not None:
            current = lines[target]
            ending = "\r\n" if current.endswith("\r\n") else ("\n" if current.endswith("\n") else "")
            lines[target] = line + ending
            replaced = True
        if not replaced:
            if lines and not lines[-1].endswith(("\n", "\r")): lines[-1] += newline
            lines.append(line + newline)
    _write_text_atomic(fp, "".join(lines), expected=snapshot.digest)

def sandbox_tools_default(typ):
    import vibe_sandbox
    return list(vibe_sandbox.TOOL_DEFAULTS.get(typ, vibe_sandbox.TOOL_DEFAULTS["generic"]))

def sandbox_status(name):
    """Sandbox-Zustand eines Projekts; lesend, ohne Programme zu starten."""
    import vibe_sandbox
    return vibe_sandbox.status(ppath(name))

def sandbox_check(name):
    import vibe_sandbox
    return vibe_sandbox.check(ppath(name))

def sandbox_set(name, enabled):
    if enabled:
        values = {"SANDBOX": "on"}
        if not penv(name).get("SANDBOX_TOOLS"):
            values["SANDBOX_TOOLS"] = " ".join(sandbox_tools_default(ptype(name)))
        set_env_values(name, values)
    else:
        set_env_values(name, {"SANDBOX": "off"})
    return sandbox_status(name)

def sandbox_tools(name, tools):
    import vibe_sandbox
    normalized = vibe_sandbox.normalize_tools(tools)
    set_env_values(name, {"SANDBOX_TOOLS": " ".join(normalized)})
    return sandbox_status(name)

def cmd_sandbox(name, action=None, value=None):
    try:
        if action in ("on", "off"):
            st = sandbox_set(name, action == "on")
        elif action == "tools":
            if value is None: sys.exit("Liste fehlt: vibe sandbox <projekt> tools \"git node npm\"")
            st = sandbox_tools(name, value)
        elif action == "check":
            result = sandbox_check(name)
            print(result["message"])
            sys.exit(0 if result["ok"] else 1)
        elif action in (None, "status", "list"):
            st = sandbox_status(name)
        else:
            sys.exit("vibe sandbox <projekt> [status|on|off|tools \"<liste>\"|check]")
    except ValueError as e:
        sys.exit(str(e))
    state = "an" if st["enabled"] else "aus"
    print(col("b", f"Sandbox für {name}: {state}"))
    print("bubblewrap:", st["bwrap"] or "fehlt")
    print("Build-Werkzeuge:", " ".join(st["tools"]) or "(keine)")
    if st["missing_tools"]: print(col("r", "Fehlende Werkzeuge: " + ", ".join(st["missing_tools"])))
    print("Schreibverzeichnisse:")
    for d in st["write_dirs"]: print("  " + d)
    print("opencode-Zustand:", st["state_dir"])
    if st["error"]: print(col("r", "Fehler: " + st["error"]))
    print(col("d", "Anpassen: vibe sandbox " + name + " on|off|tools \"git node npm\". Die Sandbox begrenzt Schreiben auf diese Verzeichnisse und Tool-Caches; /tmp ist privat und schreibgeschützt, Temporärdateien liegen im Zustandsordner. MCP und Netzwerk bleiben erlaubt, Lesezugriffe werden nicht eingeschränkt."))

# ---------- GitHub-Verknüpfung je Projekt (AP6) ----------
def github_env_path(name):
    return os.path.join(ppath(name), ".vibe", "project.env")

def github_status(name):
    """Zustandsansicht mit bewusstem Fern-Abgleich: ls-remote (kein Merge)."""
    return vibe_github.status(ppath(name))

def github_branches(name):
    return vibe_github.branches(ppath(name))

def github_link(name, url):
    """Neue/aktualisierte GitHub-Verknüpfung: Remote origin + Konfiguration."""
    slug = vibe_github.parse_remote_url(url)
    rc, out = vibe_github.git(ppath(name), "remote", "get-url", "origin")
    if rc == 0:
        rc, out = vibe_github.git(ppath(name), "remote", "set-url", "origin", url)
    else:
        rc, out = vibe_github.git(ppath(name), "remote", "add", "origin", url)
    if rc != 0:
        raise ValueError("Git-Remote konnte nicht gesetzt werden: " + (out or "unbekannt"))
    # origin/HEAD gleich mit versorgen, damit der Merge-Request-Fluss
    # (auch aus der Oberfläche) ohne Vorarbeit eine Basis kennt.
    vibe_github.set_head_default(ppath(name))
    # AP4 (T-G3): Upstream für lokale Branches mit origin-Pendant best effort
    # setzen; Fehler werden gesammelt und sind nicht fatal.
    upstream_errors = []
    rc, out = vibe_github.git(ppath(name), "for-each-ref", "refs/heads",
                              "--format=%(refname:short)")
    if rc == 0:
        for local_branch in out.splitlines():
            local_branch = local_branch.strip()
            if not local_branch:
                continue
            rc_remote, _ = vibe_github.git(
                ppath(name), "rev-parse", "--verify", "--quiet",
                "refs/remotes/origin/" + local_branch)
            if rc_remote != 0:
                continue
            rc_set, set_out = vibe_github.git(
                ppath(name), "branch", "--set-upstream-to",
                "origin/" + local_branch, local_branch)
            if rc_set != 0:
                upstream_errors.append(local_branch + ": "
                                       + (set_out or "unbekannter Fehler"))
    for error in upstream_errors:
        print("WARNUNG: Upstream konnte nicht gesetzt werden: " + error,
              file=sys.stderr)
    values = {"GITHUB_ENABLED": "1"}
    if slug:
        values["GITHUB_REPO"] = slug
    set_env_values(name, values)
    return github_status(name)

def github_unlink(name):
    """Löst die GitHub-Verknüpfung (Remote origin + Schlüssel) ohne Fremdänderungen."""
    rc, out = vibe_github.git(ppath(name), "remote", "remove", "origin")
    if rc != 0 and "No such remote" not in out:
        raise ValueError("Git-Remote konnte nicht entfernt werden: " + (out or "unbekannt"))
    set_env_values(name, {"GITHUB_ENABLED": "", "GITHUB_REPO": ""})
    return github_status(name)

def github_issues_sync(name):
    """Führt den Issues-Sync aus (Pull + Push + Close); Opt-in-Pflicht."""
    project = ppath(name)
    config = vibe_github.read_config(github_env_path(name))
    if not config["issues_enabled"]:
        raise ValueError("Issues-Sync ist für dieses Projekt nicht aktiv "
                         "(GITHUB_ISSUES_ENABLED=1).")
    stats = vibe_issues.sync_issues(project, config)
    return True, vibe_issues.sync_message(stats)

def github_issues_state(name, ticket_id, state):
    """Setzt den Issues-Zustand (draft/ready/in-progress/open)."""
    project = ppath(name)
    config = vibe_github.read_config(github_env_path(name))
    if not config["issues_enabled"]:
        raise ValueError("Issues-Sync ist für dieses Projekt nicht aktiv "
                         "(GITHUB_ISSUES_ENABLED=1).")
    number = vibe_issues.set_issue_state(project, config, ticket_id, state)
    return True, ("Zustand von " + str(ticket_id) + " (Issue #" + str(number)
                  + ") auf " + str(state) + " gesetzt.")

def github_pr(name, title=None, base=None, branch=None, confirm=False):
    """Merge-Request stellen; Push und API nur mit ausdrücklicher Freigabe."""
    config = vibe_github.read_config(github_env_path(name))
    if not config["enabled"]:
        raise ValueError("GitHub ist für dieses Projekt nicht aktiv (GITHUB_ENABLED=1)")
    if not config["repo"]:
        raise ValueError("Kein Repository verknüpft: GITHUB_REPO fehlt")
    project = ppath(name)
    branch = (branch or vibe_github.current_branch(project)).strip()
    if not branch:
        raise ValueError("Kein Branch ausgecheckt: Merge-Request verweigert")
    if not confirm:
        planned_base = (base or config["base"]
                        or vibe_github.default_base(project)
                        or "(unbekannt; --base angeben)")
        return {"ok": False, "planned": branch + " -> " + planned_base,
                "message": "Vorgesehener Merge-Request: "
                           + branch + " -> " + planned_base
                           + "  (ausführen mit --confirm bzw. Bestätigung in der Oberfläche)"}
    ok, message = vibe_github.push(project, branch)
    if not ok:
        raise ValueError(message)
    if not (base or config["base"]) and not vibe_github.default_base(project):
        # Bewusster, einmaliger Nachversuch in der bestätigten Aktion:
        # origin/HEAD nachziehen, statt mit unbekannter Basis zu scheitern.
        vibe_github.set_head_default(project)
    request = vibe_github.create_pull_request(
        project, config["repo"], branch,
        base=base or config["base"] or None, title=title or ("Merge-Request: " + branch),
        body=None, api=config["api"])
    return {"ok": True, "branch": branch, "base": request.get("base"),
            "number": request.get("number"), "url": request.get("url"),
            "message": "Merge-Request erstellt: " + (request.get("url") or branch)}

def cmd_github(name=None, action="status", value=None, label=None, title=None,
               base=None, branch=None, confirm=False, out=None, state=None):
    """CLI-Zugang zu den GitHub-Funktionen (optional, pro Projekt)."""
    if name is None:
        print(__doc__)
        sys.exit(2)
    out = out or sys.stdout
    def line(*parts): print(*parts, file=out)
    try:
        if action in (None, "", "status"):
            st = github_status(name)
            state = "verknüpft mit " + st["repo"] if st["repo"] else "nicht verknüpft"
            line(col("b", "GitHub für " + name + ": ") + state)
            line("Aktiv:", "ja" if st["enabled"] else "nein", " Label:", st["label"],
                 " API:", st["api"])
            line("Branch:", st["branch"],
                 "Ahead/Behind: %d/%d" % (st["ahead"], st["behind"]),
                 "(ungesendete Commits)" if st["unpushed"] else "")
            for remote in st["remotes"]:
                line("Remote " + remote["name"] + ": " + remote["url"])
            auth = st.get("auth") or {}
            line("Zugangstoken:", (auth.get("source") or "-"
                                   ) + (" (hinterlegt)" if auth.get("set") else
                                        "(kein Token)"))
            line("Auto-Merge:", "ja (Läufer mergt freigegebene Merge-Requests selbst)"
                 if st["auto_merge"] else
                 "nein (PR-only: Eigentümer mergt und schließt mit 'vibe package close')")
            line("Issues-Sync:", "aktiv (Label: " + st.get("issues_in_progress_label", "in-progress")
                 + ", Ready: " + st.get("issues_ready_label", "ready") + ")"
                 if st.get("issues_enabled") else "aus (GITHUB_ISSUES_ENABLED=1)")
            line("Branchübersicht: vibe github " + name + " branches")
        elif action == "link":
            if not value:
                raise ValueError("URL fehlt: vibe github <projekt> link https://github.com/owner/name.git")
            github_link(name, value)
            line("Verknüpft: " + vibe_github.mask_url(value))
        elif action == "unlink":
            github_unlink(name)
            line("Verknüpfung gelöst (Remote origin entfernt)")
        elif action == "branches":
            rows = github_branches(name)
            if not rows:
                line("Keine lokalen Branches.")
            for row in rows:
                mark = "*" if row["current"] else " "
                line(f"{mark} {row['name']:24} Ahead/Behind: {row['ahead']}/{row['behind']}  {row['last'][:60]}")
        elif action == "fetch":
            ok, message = vibe_github.fetch(ppath(name))
            line(message)
            sys.exit(0 if ok else 1)
        elif action == "pull":
            ok, message = vibe_github.pull(ppath(name))
            line(message)
            sys.exit(0 if ok else 1)
        elif action == "push":
            ok, message = vibe_github.push(ppath(name), branch=value or "")
            line(message)
            sys.exit(0 if ok else 1)
        elif action == "checkout":  # AP9: bewusster Branch-Wechsel
            if not value:
                raise ValueError("Branch fehlt: vibe github <projekt> checkout <branch>")
            ok, message = vibe_github.checkout_branch(ppath(name), value)
            line(message)
            sys.exit(0 if ok else 1)
        elif action == "test":  # AP9: Verbindungsprüfung für den Nutzer
            view = vibe_github.connection(ppath(name))
            line("Verbindung: " + ("OK" if view["ok"] else "FEHLER"))
            line(str(view["message"] or ""))
            sys.exit(0 if view["ok"] else 1)
        elif action == "token":  # B7/AP9: Token je Projekt (nicht als Argument)
            if value in ("clear", "--clear"):
                vibe_github.delete_project_token(ppath(name))
                line("GitHub-Token für dieses Projekt entfernt")
            elif value in (None, ""):
                if sys.stdin.isatty():
                    import getpass
                    token = getpass.getpass(
                        "GitHub-Token für dieses Projekt (Eingabe bleibt unsichtbar): ")
                else:
                    # Nicht-interaktive Nutzung (Skripte/Tests): Eine Zeile
                    # aus der Standardeingabe; der Inhalt wird nie echoen.
                    token = sys.stdin.readline().rstrip("\r\n")
                vibe_github.save_project_token(ppath(name), token)
                line("GitHub-Token für dieses Projekt gespeichert (verschlüsselt)")
            else:
                raise ValueError('Token nie als Argument angeben. Befehle: '
                                 '"vibe github <projekt> token" (Eingabe, unsichtbar) '
                                 'oder "vibe github <projekt> token clear"')
        elif action == "issues-sync":
            ok, message = github_issues_sync(name)
            line(message)
            sys.exit(0 if ok else 1)
        elif action == "issues-state":
            if value is None or state is None:
                raise ValueError("ID und Zustand fehlen: vibe github <projekt> "
                                 "issues-state <id> draft|ready|in-progress|open")
            ok, message = github_issues_state(name, value, state)
            line(message)
            sys.exit(0 if ok else 1)
        elif action == "pr":
            result = github_pr(name, title=title, base=base, branch=branch,
                               confirm=confirm)
            line(result["message"])
        else:
            raise ValueError('Aktion unbekannt: "%s" (status|link|unlink|branches|'
                             'fetch|pull|push|checkout|test|'
                             'issues-sync|issues-state|token|pr)' % action)
    except ValueError as e:
        sys.exit(str(e))
    except Exception as e:  # GitHubError u. a.: verständlich, ohne Token
        sys.exit(str(e))

def _parse_github_cli(rest):
    """CLI-Optionen (--confirm, --label/--title/--base/--branch Wert, Position)."""
    options = {"label": None, "title": None, "base": None, "branch": None,
               "confirm_on": False}
    positional = []
    index = 0
    while index < len(rest):
        token = rest[index]
        if token == "--confirm":
            options["confirm_on"] = True
        elif token in ("--label", "--title", "--base", "--branch"):
            if index + 1 >= len(rest):
                raise ValueError("Option " + token + " erwartet einen Wert")
            options[{"--label": "label", "--title": "title", "--base": "base",
                     "--branch": "branch"}[token]] = rest[index + 1]
            index += 1
        else:
            positional.append(token)
        index += 1
    if len(positional) < 1:
        raise ValueError("Projekt fehlt: vibe github <projekt> [aktion]")
    return positional[0], (positional[1] if len(positional) > 1 else "status"), \
           (positional[2] if len(positional) > 2 else None), \
           (positional[3] if len(positional) > 3 else None), options

def github_cli(rest):
    """CLI-Dispatch: vibe github <projekt> [aktion|optionen]."""
    try:
        name, action, value, state, options = _parse_github_cli(rest)
    except ValueError as e:
        sys.exit(str(e))
    cmd_github(name, action, value, label=options["label"], title=options["title"],
               base=options["base"], branch=options["branch"],
               confirm=options["confirm_on"], state=state)

def sess(name): return profile_session("vibe-" + run_key(name))
def tmux_has_session(name):
    """Laufsitzung auf ihrem eigenen tmux-Server (V-026)."""
    session = sess(name)
    return run(tmux_argv(session, "has-session", "-t", session,
                         own_socket=True))[0] == 0
tmux_has = tmux_has_session

# ---------- Laufregister und Laufzustand ----------
def run_registry():
    """Register aller Läufe im Laufzeitordner (siehe bin/vibe_runs.py)."""
    return vibe_runs.RunRegistry(LOGS)

def run_state(name):
    """Zustand des jüngsten Laufs eines Projekts.

    ``running`` bedeutet: Das Register kennt einen laufenden Lauf **und** seine
    tmux-Sitzung existiert. Ein beendeter Prozess erscheint als ``ended`` und
    wird nicht mehr als laufend gemeldet.

    Zugeordnet wird ausschließlich über den Projektpfad, nicht über den
    Laufschlüssel: Ein Eintrag eines anderen Projekts darf nie als Lauf dieses
    Projekts erscheinen, auch wenn der Schlüssel gleich lautet.
    """
    project = _real(ppath(name))
    registry = run_registry()
    record = registry.latest(project=project)
    live = tmux_has_session(name)
    if record:
        state = record.get("state") or "running"
        if state in vibe_runs.LIVE_STATES and not live:
            state = "ended"
        elif state in vibe_runs.LIVE_STATES:
            state = "running"
    else:
        state = "running" if live else "idle"
    return {
        "run_id": (record or {}).get("id"),
        "state": state,
        "running": state == "running",
        "started": bool(record),
        "agent": (record or {}).get("agent", ""),
        "session": (record or {}).get("session") or sess(name),
        "log": (record or {}).get("log") or logpath(name),
        "verify_log": (record or {}).get("verify_log") or logpath(name, "verify"),
        "exit_code": (record or {}).get("exit_code"),
    }

# ---------- Pause nach dem aktuellen Arbeitspaket ----------
def pause_after_path(name):
    """Markierung im Laufzeitordner; sie gilt für genau einen Lauf."""
    return os.path.join(LOGS, run_key(name) + ".pause-after")

def pause_after_active(name):
    return os.path.exists(pause_after_path(name))

def pause_after_request(name):
    """Fordert an, nach dem laufenden Arbeitspaket kein neues zu starten."""
    os.makedirs(LOGS, exist_ok=True)
    try:
        _write_text_atomic(pause_after_path(name), "Pause nach dem aktuellen Arbeitspaket\n")
    except OSError as error:
        raise ValueError("Pause-Anforderung nicht speicherbar: " + str(error))

def pause_after_cancel(name):
    fp = pause_after_path(name)
    try:
        if not os.path.exists(fp): return False
        os.remove(fp)
        return True
    except OSError as error:
        raise ValueError("Pause-Anforderung nicht aufhebbar: " + str(error))

def cmd_pause(name, action=None):
    ppath(name)
    released = False
    try:
        if action in (None, "status", "list"): pass
        elif action in ("on", "an", "request"): pause_after_request(name)
        elif action in ("off", "aus", "cancel"): released = pause_after_cancel(name)
        else: sys.exit("vibe pause <projekt> [on|off]")
    except ValueError as e:
        sys.exit(str(e))
    if pause_after_active(name):
        print(col("y", "Pause nach dem aktuellen Arbeitspaket: angefordert"))
        print(col("d", "Der laufende Agent wird nicht unterbrochen. Danach wird kein neues Paket gestartet; die Anforderung gilt einmalig."))
    elif released:
        print("Pause nach dem aktuellen Arbeitspaket: aufgehoben")
    else:
        print("Pause nach dem aktuellen Arbeitspaket: nicht angefordert")
        print(col("d", "Anfordern: vibe pause " + name + " on"))


def git_info(name):
    p = ppath(name)
    rc, out = git_run(p, "symbolic-ref", "--short", "HEAD")
    br = out if rc == 0 and out else "-"
    rc, out = git_run(p, "status", "--porcelain")
    dirty = len([l for l in out.splitlines() if l.strip()]) if rc == 0 else 0
    rc, last = git_run(p, "log", "-1", "--format=%h %s (%cr)")
    last = last[:70] if rc == 0 and last else "(noch kein Commit)"
    return br, dirty, last

def cmd_list():
    ps = projects()
    if not ps: print(f"Keine Projekte. Entwicklungsordner: {', '.join(roots())}. Neu: vibe new <name> <typ> oder vibe roots add <pfad>"); return
    print(col("b", f"{'Projekt':22}{'Typ':9}{'Branch':14}{'Offen':6}{'Änd.':5}{'Lauf':7}Letzter Commit"))
    for n in ps:
        br, dirty, last = git_info(n)
        run = col("g", "läuft") if tmux_has(n) else "-"
        flag = "" if is_init(n) else col("y", " [nicht vorbereitet]")
        print(f"{n[:21]:22}{ptype(n):9}{br[:13]:14}{len(open_items(n)):<6}{dirty:<5}{run:7}{last}{flag}")

def cmd_status(name):
    br, dirty, last = git_info(name)
    print(col("b", f"{name}  ({ptype(name)})"), f" Branch {br}, {dirty} geänderte Dateien")
    print("Pfad:", ppath(name)); print("Letzter Commit:", last)
    state = run_state(name)
    if state["running"]:
        print("Lauf:", col("g", f"aktiv {state['run_id']} (vibe attach {name})"))
    elif state["run_id"]:
        print("Lauf:", f"beendet {state['run_id']} ({state['state']}, Exit {state['exit_code']})")
    else:
        print("Lauf: keiner")
    try:
        sb = sandbox_status(name)
        print("Sandbox:", (col("g", "an") if sb["enabled"] else "aus") + ("" if not sb["enabled"] else (", bereit" if not sb["error"] and sb["bwrap"] else ", nicht startbar")))
    except Exception as e:
        print("Sandbox:", col("r", str(e)))
    if pause_after_active(name): print(col("y", "Pause nach dem aktuellen Arbeitspaket angefordert (vibe pause " + name + " off hebt sie auf)"))
    if not is_init(name): print(col("y", "Nicht für vibe vorbereitet: vibe init " + name))
    items = open_items(name)
    print(col("b", f"Offene Arbeitspakete: {len(items)}"))
    for pid, title, st in items[:25]:
        print(f"  {col('y' if st != 'BLOCKIERT' else 'r', st):14} {pid:8} {title}")
    lg = logpath(name)
    if os.path.exists(lg): print("Log:", lg, time.strftime("(%d.%m. %H:%M)", time.localtime(os.path.getmtime(lg))))

def default_agent():
    """Erster global konfigurierter Agent mit der Rolle coder, sonst leer."""
    for agent, role in profiles_load().get("rollen", {}).items():
        if role == "coder": return agent
    return ""

def pending_changes(project):
    """Nicht committete Projektänderungen ohne die verwalteten Arbeitsnotizen."""
    return vibe_packages.dirty_report(project)


def changed_file(project, name):
    """True, wenn genau diese Datei nicht committete Änderungen hat."""
    result = vibe_packages.run_git(project, "status", "--porcelain", "--", name)
    return result.returncode == 0 and bool(result.stdout.strip())


def cmd_run(name, agent=None, out=None, keep_changes=False, continue_session=None,
            resume_package=None, resume_worktree=None, resume_branch=None):
    out = out or sys.stdout
    p = ppath(name)
    # AP14: Fortsetzung in derselben Modell-Session. Die Kennung reist als
    # Umgebungsvariable zum Läufer und wird vor der Übergabe rigoros
    # geprüft, damit sie nie als zusätzliches Kommando ausgewertet wird.
    if continue_session is not None and not re.fullmatch(r"[A-Za-z0-9_-]+", continue_session):
        sys.exit("Ungültige Session-Kennung für die Fortsetzung: " + continue_session)
    # AP4 (T-W1): Resume-Hinweise auf den Worktree-Anhang. Die Paket-Kennung
    # unterliegt derselben harten Zeichenklasse wie die Session-Kennung; die
    # übrigen Werte werden als reine Umgebungsvariablen durchgereicht.
    if resume_package is not None and not re.fullmatch(r"[A-Za-z0-9_-]+", resume_package):
        sys.exit("Ungültige Paket-Kennung für die Fortsetzung: " + resume_package)
    if agent is not None: require_agent(agent)
    if tmux_has(name): print("Läuft bereits. vibe attach", name, file=out); return
    if not is_init(name): sys.exit("Projekt ist nicht für vibe vorbereitet: vibe init " + name)
    # F27: Ein ausdrücklich angeforderter Neustart darf vorhandene Änderungen
    # behalten. Sie werden nur genannt, nie gestaged, committet, gestasht oder
    # wiederhergestellt; der Preflight lässt ausschließlich diesen Befund zu.
    pending = pending_changes(p) if keep_changes else ""
    if pending:
        print(col("y", "Lauf startet trotz nicht committeter Änderungen; sie bleiben unverändert:\n" + pending), file=out)
    # GH-76: AGENTS.md gehört dem Projekt und wird bei einem Lauf weder
    # angelegt noch verändert. Die verbindlichen Läuferregeln liefert der
    # Läufer aus einer versteckten Plattformdatei.
    sandbox = sandbox_status(name)
    if sandbox["enabled"]:
        checked = sandbox_check(name)
        if not checked["ok"]: sys.exit(checked["message"])
    if pause_after_active(name): print(col("y", "Pause angefordert: der Lauf startet kein Arbeitspaket. Aufheben: vibe pause " + name + " off", out), file=out)
    os.makedirs(LOGS, exist_ok=True)
    env = penv(name)
    # Der Vibe-Agent ist der Standardagent. Eine Coder-Rolle greift nur noch,
    # solange kein Vibe-Agent definiert ist; damit bleibt ein Altbestand ohne
    # Rollenzuweisung startbar, ohne den Standardagenten zu verdrängen.
    status = vibe_agent_status()
    # Ein definierter Vibe-Agent muss ein Modell haben. Diese Sperre gilt
    # ausnahmslos und damit auch dann, wenn in der Projektdatei noch ein
    # alter AGENT-Eintrag steht: Der Vibe-Agent ist der Standardagent.
    if status["name"] and not status["configured"]:
        sys.exit("Der Vibe-Agent '" + status["name"] + "' hat kein Modell konfiguriert. Ohne Modell können keine Projekte ausgeführt werden.")
    # Die Ausnahme für Altbestände gilt nur, solange gar kein Vibe-Agent
    # definiert ist: dann bleibt ein ausdrücklich gewählter Agent oder die
    # Coder-Rolle startbar. Ein gespeicherter AGENT kann nach einer Umbenennung
    # veraltet sein; er wird deshalb gegen die systemweit vorhandenen und im
    # Projekt aktiven Agenten geprüft. Nur der gespeicherte Wert wird
    # automatisch ersetzt, nie ein ausdrücklich übergebenes Argument.
    stored_agent = (env.get("AGENT") or "").strip()
    if agent is None and status["name"] and stored_agent:
        config, _snapshot = project_agents_load(name)
        active = set(config["aktiv"])
        active.add(status["name"])
        inventory = project_agent_inventory(name)
        if stored_agent not in inventory or stored_agent not in active:
            replacement = status["name"]
            if replacement in inventory and replacement in active:
                print(col("y", f"Agent '{stored_agent}' ist nicht verfügbar oder im Projekt nicht aktiv; verwende '{replacement}' und korrigiere .vibe/project.env."), file=out)
                try:
                    repair_project_agent(name, replacement)
                except (OSError, ValueError, vibe_storage.StorageError) as error:
                    print(col("r", "AGENT in .vibe/project.env konnte nicht korrigiert werden: " + str(error)), file=out)
                stored_agent = replacement
    agent = agent or stored_agent or status["name"]
    if not agent:
        agent = default_agent()
    if not agent:
        sys.exit("Kein Vibe-Agent definiert. In der Agentenverwaltung muss ein Agent die Rolle 'vibe' erhalten.")
    agent = require_agent(agent)
    # B3: Zusatzanweisungen (F19) brauchen die Kennwortdatei <runtime>/opencode.password.
    # Nur "vibe server start" legte sie bisher an; jeder andere Einstieg (Dashboard,
    # autonome Läufe) endete beim Senden mit "Kennwortdatei fehlt". Der Laufstart
    # richtet die Anmeldung deshalb automatisch ein: neue Zufallskennung nur, wenn
    # die Datei fehlt, bestehender Inhalt bleibt unverändert. Ein Anlagefehler
    # bricht den Laufstart mit der Meldung von ensure_opencode_password ab.
    ensure_opencode_password()
    try:
        model = run_agent_selection(name, agent)
    except ValueError as error:
        sys.exit(str(error))
    key = run_key(name)
    run_id = vibe_runs.new_run_id(key)
    session = sess(name)
    registry = run_registry()
    registry.start(project=_real(p), name=name, key=key, agent=agent, session=session,
                   log=logpath(name), verify_log=logpath(name, "verify"),
                   run_id=run_id, state="starting")
    # Alte, zu große Protokolle werden vor dem Start rotiert; der neue Lauf
    # beginnt immer in einer frischen Datei.
    for path in (logpath(name), logpath(name, "verify")):
        try: vibe_runs.rotate_log(path)
        except OSError: pass
    # Pfad und Agent bleiben Argumente; das Skript selbst ist konstant.
    # Kein abschließendes "read": Der Agentenlauf endet mit dem Läufer, damit
    # vibe ihn nicht weiter als aktiv meldet. Die Ausgabe bleibt im Log.
    # Der Anzeigename bleibt ein eigenes Argument ($0, wird nie ausgewertet);
    # Laufschlüssel, ID, Sitzung, Skript, Pfad und Agent folgen als Argumente.
    # Die Modellüberschreibung des Projekts reist als weitere Position mit und
    # wird erst im Läufer an opencode übergeben; Agentendateien bleiben
    # unverändert, andere Projekte sehen die Überschreibung nicht.
    # F22: Nur der Produktpfad aktiviert die Rückfrage-Assistenz im Preflight.
    # F27: Die ausdrückliche Neustart-Absicht reist als Umgebungsvariable zum
    # Läufer; sie wird nie als Positionsargument ausgewertet.
    keep_export = " export VIBE_KEEP_CHANGES=1;" if keep_changes else ""
    # AP14: Fortsetzung in derselben Session nur als geprüfte Umgebungs-
    # variable übergeben; sie wird im Läufer nie als Kommando ausgewertet.
    continue_export = (" export VIBE_CONTINUE_SESSION=" + continue_session + ";"
                       if continue_session else "")
    # AP4 (T-W1): Worktree-Anhang als Resume-Hinweise übergeben. Die Werte
    # stammen aus dem Session-Register und werden im Läufer erneut geprüft;
    # Pfad/Branch werden zusätzlich shell-sicher quotiert, damit Leer- oder
    # Sonderzeichen den Export-Befehl nicht zerreißen. Paket-/Session-Kennung
    # unterliegen bereits der harten Zeichenklasse weiter oben.
    resume_export = ""
    if resume_worktree:
        resume_export += " export VIBE_RESUME_WORKTREE=" + shlex.quote(resume_worktree) + ";"
    if resume_package:
        resume_export += " export VIBE_RESUME_PACKAGE=" + resume_package + ";"
    if resume_branch:
        resume_export += " export VIBE_RESUME_BRANCH=" + shlex.quote(resume_branch) + ";"
    inner = ("source ~/.bashrc; " + child_exports() + keep_export + continue_export
             + resume_export
             + ' export VIBE_PREFLIGHT_ASSIST=1 VIBE_LOGNAME="$1" VIBE_RUN_ID="$2" VIBE_SESSION="$3" VIBE_MODEL="$7"; bash "$4" "$5" "$6" "$7"')
    rc, output = run(tmux_argv(
                   session, "new-session", "-d", "-s", session,
                   "-e", MANAGED_VAR + "=run", "-c", p,
                   "bash", "-lc", inner, name, key, run_id, session,
                   os.path.join(BIN, "vibe-run.sh"), p, agent, model,
                   own_socket=True))
    if rc != 0:
        registry.finish(run_id, exit_code=None, state="failed")
        print(col("r", output, stream=out), file=out)
        return
    print(col("g", f"Gestartet: Lauf {run_id}, tmux-Sitzung {session}, Agent {agent}"), file=out)
    print("Zuschauen: vibe attach", name, "| Log: vibe logs", name, file=out)

def cmd_run_cli(args):
    """``vibe run <projekt> [agent] [--keep-changes]`` ohne Positionsverwechslung.

    Die Option darf vor oder nach dem Agenten stehen. Unbekannte Optionen
    werden abgelehnt, statt als Agentenname zu gelten.
    """
    keep_changes = False
    positional = []
    for arg in args:
        if arg == "--keep-changes":
            if keep_changes:
                sys.exit("--keep-changes darf nur einmal angegeben werden.")
            keep_changes = True
        elif arg.startswith("-"):
            sys.exit("Unbekannte Option für vibe run: " + arg)
        else:
            positional.append(arg)
    if not positional:
        sys.exit("Projektname fehlt: vibe run <projekt> [agent] [--keep-changes]")
    if len(positional) > 2:
        sys.exit("Aufruf: vibe run <projekt> [agent] [--keep-changes]")
    cmd_run(
        positional[0],
        positional[1] if len(positional) > 1 else None,
        keep_changes=keep_changes,
    )

def cmd_attach(name):
    if not tmux_has(name): sys.exit("Keine laufende Sitzung für " + name)
    session = sess(name)
    subprocess.run(tmux_argv(session, "attach", "-t", session, own_socket=True))

def cmd_logs(name):
    lg = logpath(name)
    if not os.path.exists(lg): sys.exit("Noch kein Log: " + lg)
    try: subprocess.run(["tail", "-n", "60", "-f", lg])
    except KeyboardInterrupt: pass

def cmd_stop(name, run_id=None, out=None):
    """Beendet genau einen Lauf des Projekts; fremde Läufe bleiben unberührt."""
    out = out or sys.stdout
    # Ein Stopp darf auch dann die Sitzung beenden, wenn das Projektverzeichnis
    # nicht (mehr) auffindbar ist; dann gibt es nur keinen Registereintrag.
    path = project_map().get(name)
    project = _real(path) if path else None
    registry = run_registry()
    record = None
    if run_id:
        record = registry.get(run_id)
        if not record:
            sys.exit(f"Lauf {run_id} ist nicht bekannt.")
        if project is None or _real(record.get("project") or "") != project:
            sys.exit(f"Lauf {run_id} gehört nicht zu Projekt {name}; nichts beendet.")
        # Ein bereits beendeter Lauf darf nicht die Sitzung eines neueren Laufs
        # desselben Projekts beenden.
        if record.get("state") not in vibe_runs.LIVE_STATES:
            print("Lauf", run_id, "ist bereits beendet ("
                  + str(record.get("state")) + ", Exit " + str(record.get("exit_code")) + ").", file=out)
            return
    else:
        record = registry.latest(project=project) if project else None
        if record and record.get("state") not in vibe_runs.LIVE_STATES:
            record = None
    session = (record or {}).get("session") or sess(name)
    if record is None and not tmux_has_session(name):
        print("Kein laufender Lauf für", name, file=out)
        return
    # Nur eine von vibe markierte Sitzung ist ein verwalteter Lauf. Ein
    # Registereintrag allein genügt nicht, weil eine fremde Sitzung denselben
    # Namen tragen kann; "unbekannt" toleriert nur Attrappen ohne Auskunft.
    marker = session_marker(session, own_socket=True)
    if record is not None:
        if marker not in ("run", "unbekannt"):
            sys.exit(f"tmux-Sitzung {session} gehört nicht zu vibe; nichts beendet.")
    elif marker != "run":
        sys.exit(f"tmux-Sitzung {session} gehört nicht zu vibe; nichts beendet.")
    rc, output = run(tmux_argv(session, "kill-session", "-t", session,
                               own_socket=True))
    if rc != 0:
        if record is not None and not tmux_has_session(name):
            # V-026: Hat der Läufer das Ende bereits festgehalten (z. B. mit
            # Signalnotiz), bleibt dieser Eintrag unverändert.
            registry.finish(record["id"], exit_code=None, state="ended",
                            only_live=True)
            print("Lauf", record["id"], "war bereits beendet.", file=out)
            return
        sys.exit("Lauf nicht beendbar: " + output)
    if record is not None:
        # V-026: Der Signalhandler des Läufers kann zuerst schreiben. Ein
        # bereits beendeter Eintrag behält dann Zustand und Notiz; der Stopp
        # überschreibt ihn nicht.
        registry.finish(record["id"], exit_code=None, state="stopped",
                        only_live=True)
        print("Beendet:", name, "Lauf", record["id"], file=out)
    else:
        print("Beendet:", name, file=out)

def cmd_runs(action="list"):
    """Zeigt das Laufregister; ``prune`` beendet verwaiste Einträge.

    Verwaist ist ein Eintrag in ``starting``/``running``, dessen tmux-Sitzung
    nicht mehr existiert. Aufgeräumt wird ausschließlich das Register, nie eine
    tmux-Sitzung; laufende Sitzungen und beendete Einträge bleiben unverändert.
    """
    action = (action or "list").lower()
    if action not in ("list", "prune"):
        sys.exit("vibe runs [list|prune]")
    registry = run_registry()
    records = registry.all()
    if action == "list":
        if not records:
            print("Keine Läufe im Register.")
            return
        for record in reversed(records):
            state = record.get("state") or "?"
            session = str(record.get("session") or "")
            line = f"{record.get('id', '?')}  {state}"
            if state in vibe_runs.LIVE_STATES:
                if not session:
                    line += "  Sitzung nicht prüfbar"
                else:
                    live = tmux_session_state(session, own_socket=True)
                    if live is True:
                        line += f"  Sitzung {session} läuft"
                    elif live is False:
                        line += f"  Sitzung {session} verwaist"
                    else:
                        line += f"  Sitzung {session} nicht prüfbar"
            print(line + "  " + str(record.get("project") or "?"))
        return
    ended = running = unknown = 0
    for record in records:
        if record.get("state") not in vibe_runs.LIVE_STATES:
            continue
        run_id = record.get("id") or "?"
        session = str(record.get("session") or "")
        if not session:
            print(f"Unverändert: {run_id} (keine Sitzungsangabe, nicht prüfbar)")
            unknown += 1
            continue
        live = tmux_session_state(session, own_socket=True)
        if live is None:
            print(f"Unverändert: {run_id} (Sitzung {session} nicht prüfbar)")
            unknown += 1
            continue
        if live:
            print(f"Läuft weiter: {run_id} (Sitzung {session})")
            running += 1
            continue
        registry.finish(run_id, exit_code=None, state="ended")
        print(f"Verwaist beendet: {run_id} (Sitzung {session} fehlt)")
        ended += 1
    print(f"{ended} verwaiste Einträge beendet, {running} laufen weiter, {unknown} nicht prüfbar.")

def cmd_sessions(args):
    """AP19: Sessions auflisten, Standardlimit pflegen, eine Session fortsetzen.

    Jede Ablehnung bricht mit einer verständlichen Meldung ab, bevor ein Lauf
    gestartet wird. Die eigentliche Fortsetzung läuft über die unveränderte
    AP14-Mechanik ``cmd_run(..., continue_session=...)``.
    """
    args = list(args or [])
    if args and args[0] == "list":
        action, rest = "list", list(args[1:])
    elif args and not str(args[0]).startswith("-"):
        action, rest = args[0], list(args[1:])
    else:
        action, rest = "list", list(args)
    usage = ("vibe sessions [list] [--limit N] [--project NAME] [suchtext]\n"
             "       vibe sessions limit [N]\n"
             "       vibe sessions resume <projekt> (--session ID | --last | --aborted)\n"
             "       vibe sessions attach <projekt> <paket> <session>\n"
             "       vibe sessions for-package <projekt> <paket>\n"
             "       vibe sessions finish-package <projekt> <paket>\n"
             "       vibe sessions migrate <projekt>")
    if action not in ("list", "limit", "resume", "attach", "for-package",
                      "finish-package", "migrate"):
        sys.exit(usage)

    if action in ("attach", "for-package", "finish-package"):
        expected = 3 if action == "attach" else 2
        if len(rest) != expected:
            sys.exit(usage)
        name, pid = rest[0], rest[1]
        project = ppath(name)
        try:
            if action == "attach":
                # Die CLI setzt die aktive Session des Pakets: eine frühere
                # Zuordnung wird erst nach vollständiger Prüfung durch die neue
                # ersetzt. Der Stream-Filter nutzt dagegen attach_session direkt
                # und sammelt mehrere.
                sessions = vibe_tickets.replace_sessions(project, pid, rest[2])
                print("Session " + rest[2] + " ist Paket " + pid
                      + " zugeordnet.")
                for session in sessions:
                    print(session)
            elif action == "for-package":
                sessions = vibe_tickets.sessions_of(
                    vibe_tickets.find(vibe_tickets.load(project), pid) or {})
                if not sessions:
                    print("Keine Sessions für Paket " + pid + ".")
                for session in sessions:
                    print(session)
            else:
                sessions = vibe_runs.finish_package(project, pid, LOGS)
                print("Paket " + pid + " abgeschlossen; "
                      + str(len(sessions)) + " Session(s) bereinigt.")
        except ValueError as error:
            sys.exit(str(error))
        return

    if action == "migrate":
        if len(rest) != 1:
            sys.exit(usage)
        name = rest[0]
        project = ppath(name)
        project_real = os.path.realpath(project)
        adopted, skipped = [], []
        for entry in vibe_runs.SessionRegistry(LOGS).all():
            session = str(entry.get("session") or "")
            pid = str(entry.get("package_id") or "")
            owner = os.path.realpath(str(entry.get("project") or ""))
            if owner != project_real or not pid:
                skipped.append(session)
                continue
            record = vibe_tickets.find(vibe_tickets.load(project), pid)
            if record is None:
                skipped.append(session)
                continue
            try:
                vibe_tickets.attach_session(project, pid, session)
            except (OSError, ValueError):
                skipped.append(session)
                continue
            adopted.append(session)
        for session in adopted:
            print("Übernommen: " + session)
        for session in skipped:
            print("Nicht übernommen (mehrdeutig oder fremd): " + session)
        print(f"Migration: {len(adopted)} übernommen, "
              f"{len(skipped)} nicht übernommen.")
        return

    if action == "limit":
        if len(rest) > 1:
            sys.exit("vibe sessions limit [N]")
        registry = vibe_runs.SessionRegistry(LOGS)
        if not rest:
            print(f"Standardlimit für Sessions: {registry.limit()}")
            return
        try:
            value = int(rest[0])
        except ValueError:
            sys.exit(f"Ungültiges Session-Limit: {rest[0]!r} "
                     f"(erlaubt: 1..{vibe_runs.SESSION_LIMIT_MAX})")
        try:
            registry.set_limit(value)
        except ValueError as error:
            sys.exit(str(error))
        print(f"Standardlimit für Sessions: {registry.limit()}")
        return

    if action == "resume":
        if not rest:
            sys.exit(usage)
        name = rest[0]
        project = ppath(name)
        options = rest[1:]
        if "--session" in options:
            position = options.index("--session")
            if position + 1 >= len(options):
                sys.exit("--session braucht eine Session-Kennung")
            session_id = options[position + 1]
            entry = vibe_runs.SessionRegistry(LOGS).get(session_id)
            if (not entry or os.path.realpath(str(entry.get("project") or ""))
                    != os.path.realpath(project)):
                sys.exit(f"Session '{session_id}' ist für Projekt '{name}' nicht im Register.")
        elif "--last" in options or "--aborted" in options:
            candidates = vibe_runs.session_overview(
                LOGS, project=project, limit=vibe_runs.SESSION_LIMIT_MAX)
            if "--aborted" in options:
                candidates = [item for item in candidates
                              if item.get("state") == "aborted"]
                label = "abgebrochene"
            else:
                label = "jüngste"
            if not candidates:
                sys.exit(f"Keine {label} Session für Projekt '{name}' im Register.")
            session_id = candidates[0]["session"]
            entry = candidates[0]
        else:
            sys.exit("--session, --last oder --aborted angeben")

        # Reihenfolge: aktiver Lauf (Register oder Sitzung) vor der Frage, ob
        # der Harness überhaupt fortsetzen kann.
        active = tmux_has(name)
        if not active:
            real = os.path.realpath(project)
            active = any(
                str(record.get("state")) in vibe_runs.LIVE_STATES
                and os.path.realpath(os.path.abspath(str(record.get("project") or ""))) == real
                for record in run_registry().all()
            )
        if active:
            sys.exit(f"Für Projekt '{name}' läuft bereits ein Lauf; "
                     "Fortsetzen ist erst nach Stoppen möglich.")
        try:
            selected = vibe_harness.read_selection(PATHS.state)
        except vibe_harness.HarnessError:
            selected = "opencode"
        if not vibe_harness.supports(selected, "continue"):
            sys.exit("Fortsetzen ist bei Pi nicht möglich: Pi läuft im "
                     "Print-Modus (--no-session) ohne fortsetzbare Session.")
        # AP4 (T-W1): Worktree-Anhang der Session als Resume-Hinweis an den
        # Läufer weiterreichen; continue_session bleibt die AP14-Mechanik.
        resume_package = str(entry.get("package_id") or "") if entry else ""
        resume_worktree = str(entry.get("worktree_path") or "") if entry else ""
        resume_branch = str(entry.get("branch") or "") if entry else ""
        cmd_run(name, continue_session=session_id,
                resume_package=resume_package or None,
                resume_worktree=resume_worktree or None,
                resume_branch=resume_branch or None)
        return

    limit = None
    project = None
    search = []
    position = 0
    while position < len(rest):
        value = rest[position]
        if value in ("--limit", "--project"):
            position += 1
            if position >= len(rest):
                sys.exit(f"{value} braucht einen Wert")
            if value == "--project":
                # AP19/Review M1: --project ist ein Projektname aus der
                # Projektkarte, kein Pfad relativ zum aktuellen Verzeichnis.
                # ppath meldet einen unbekannten Namen klar und bricht ab.
                project = ppath(rest[position])
            else:
                try:
                    limit = int(rest[position])
                except ValueError:
                    sys.exit(f"Ungültiges Session-Limit: {rest[position]!r}")
        elif str(value).startswith("-"):
            sys.exit(f"Unbekannte Option für vibe sessions: {value}")
        else:
            search.append(str(value))
        position += 1
    try:
        entries = vibe_runs.session_overview(
            LOGS, project=project, limit=limit, text=" ".join(search) or None)
    except ValueError as error:
        sys.exit(str(error))
    if not entries:
        print("Keine Sessions im Register.")
        return
    for entry in entries:
        print(f"{entry['session']}  {entry['state_label']}  "
              f"{entry.get('agent') or '?'}  "
              f"{entry.get('name') or entry.get('project') or '?'}")


def _worktree_branch_held(project, branch):
    """True, wenn ``branch`` noch in einer Arbeitskopie ausgecheckt ist."""
    rc, out = vibe_github.git(project, "worktree", "list", "--porcelain")
    if rc != 0:
        return False
    for line in out.splitlines():
        if line.startswith("branch "):
            name = line[len("branch "):].strip()
            if name.startswith("refs/heads/"):
                name = name[len("refs/heads/"):]
            if name == branch:
                return True
    return False


def package_close(name, pid):
    """Zweite Abschlussphase eines PR-only-Pakets (AP4, T-G1).

    Findet den registrierten Worktree, prüft den gemergten Merge-Request
    (REST), holt den Integrationsbranch per fetch --prune + ff-only auf die
    Fernspitze, übernimmt den Nachweis aus dem Worktree, entfernt
    Worktree/Branch/Registry und vergisst die Sessions. Liefert
    ``(ok, message)`` und wirft niemals.
    """
    pid = str(pid or "").strip()
    if not pid:
        return False, "Paket-Kennung fehlt."
    project = ppath(name)
    registry = vibe_runs.WorktreeRegistry(LOGS)
    entry = registry.get(project, pid)
    if not entry:
        return False, ("Kein registrierter Worktree für " + pid
                       + "; Paket nicht im PR-only-Abschluss.")
    branch = str(entry.get("branch") or "").strip()
    path = str(entry.get("path") or "").strip()
    config = vibe_github.read_config(github_env_path(name))
    if not config["enabled"]:
        return False, ("GitHub ist für dieses Projekt nicht aktiv; "
                       "Paket-Abschluss nur mit aktiver Verknüpfung.")
    if not config["repo"]:
        return False, "Kein Repository verknüpft (GITHUB_REPO fehlt)."
    if not any(remote["name"] == "origin" for remote in vibe_github.remotes(project)):
        return False, "Kein Remote origin: Paket-Abschluss verweigert."
    pr = vibe_github.merged_pull_request(project, branch)
    if not pr.get("found") or not pr.get("merged"):
        url = str(pr.get("url") or "")
        return False, ("Merge-Request für " + branch + " ist noch nicht gemergt"
                       + ((" (" + url + ")") if url else "")
                       + "; keine Änderungen vorgenommen.")
    performed, ok, message = vibe_github.pull_integration(project)
    if not ok:
        return False, "Integrationsbranch nicht aktualisierbar: " + message
    changed, sync_message = vibe_packages.sync_ticket(
        project, path, pid, require_commit=False)
    if not changed:
        return False, "Nachweis nicht übernehmbar: " + sync_message
    # GH-99: Erfolgreicher Abschluss spült zuerst die Kosten, dann werden die
    # Paket-Sessions bereinigt und vergessen. Scheitert das Spülen, bleibt
    # alles erhalten.
    try:
        vibe_runs.finish_package(project, pid, LOGS)
    except (OSError, ValueError) as error:
        return False, "Kosten/Sessions nicht abschließbar: " + str(error)
    # Cleanup: Arbeitskopie, Branch (ggf. -D nach Squash-Merge), Registry,
    # Sessions. Reihenfolge wie T-G4: erst Worktree, dann Branch-Prüfung.
    vibe_github.git(project, "worktree", "remove", "--force", path)
    if not _worktree_branch_held(project, branch):
        rc, _ = vibe_github.git(project, "branch", "-d", branch)
        if rc != 0:
            # Nach verifiziertem Squash-Merge erzeugt GitHub einen neuen Commit
            # ohne Abstammung; -d scheitert dann zu Recht und -D ist erlaubt.
            vibe_github.git(project, "branch", "-D", branch)
    registry.unregister(project, pid)
    vibe_runs.SessionRegistry(LOGS).forget_worktree(path)
    return True, ("Paket " + pid + " geschlossen (Branch " + branch
                  + ", Merge-Request " + str(pr.get("url") or "") + "); "
                  "der nächste Lauf wählt das nächste Paket.")


def cmd_package_close(args):
    """``vibe package close <projekt> <id>``: PR-only-Paket abschließen."""
    args = list(args or [])
    if not args or args[0] != "close":
        sys.exit("Aufruf: vibe package close <projekt> <id>")
    rest = args[1:]
    if len(rest) < 2:
        sys.exit("Aufruf: vibe package close <projekt> <id>")
    ok, message = package_close(rest[0], rest[1])
    print(message)
    sys.exit(0 if ok else 1)


class VerifyConfigError(ValueError):
    """Prüfkonfiguration ist unvollständig oder nur ein Platzhalter."""

VERIFY_MODES = ("quick", "package", "full")

def verify_command(name, mode="quick"):
    """Prüfbefehl des Projekts; ``None``, wenn keiner konfiguriert ist.

    Einzige Quelle ist ``.vibe/project.env`` des Projekts. Die Umgebung wird
    bewusst nicht gelesen: Ein exportierter ``VERIFY_FULL``-Wert eines anderen
    Projekts oder einer Prüfumgebung würde sonst still fremde Prüfungen
    ausführen. Nur für ``TYPE=android`` dient die Android-Abnahme aus
    ``_toolchain/verify`` als Rückfall; ein Nicht-Android-Projekt wird nie
    still mit Android-Abnahmedateien geprüft.
    """
    if mode not in VERIFY_MODES:
        raise VerifyConfigError(
            f"Unbekannter Prüfmodus: {mode} (erlaubt: " + ", ".join(VERIFY_MODES) + ")")
    p = ppath(name); env = penv(name)
    key = {"quick": "VERIFY_QUICK", "package": "VERIFY_PACKAGE", "full": "VERIFY_FULL"}[mode]
    cmd = (env.get(key) or "").strip()
    if "TODO" in cmd:
        raise VerifyConfigError(
            f"Platzhalter in {key} ({ppath(name)}/.vibe/project.env): "
            "ein TODO-Befehl ist keine Prüfung.")
    if cmd: return cmd
    script = os.path.join(VERIFY, "verify.sh")
    if ptype(name) == "android" and os.path.exists(script):
        return shlex.join(["bash", script, p, mode])
    return None

def verify_argv(name, mode="quick"):
    """Einzige Shellgrenze für projektkonfigurierte Prüfbefehle."""
    cmd = verify_command(name, mode)
    if not cmd: return None
    return ["bash", "-lc", "source ~/.bashrc; " + cmd]

def cmd_verify(name, mode="quick"):
    if mode not in VERIFY_MODES:
        print(f"Unbekannter Prüfmodus: {mode} (erlaubt: " + ", ".join(VERIFY_MODES) + ")", file=sys.stderr)
        sys.exit(2)
    try:
        argv = verify_argv(name, mode)
    except VerifyConfigError as error:
        print(str(error), file=sys.stderr)
        sys.exit(3)
    if not argv:
        print(f"Keine Prüfbefehle in {ppath(name)}/.vibe/project.env (VERIFY_QUICK / VERIFY_PACKAGE / VERIFY_FULL).", file=sys.stderr)
        sys.exit(3)
    # Der Exitcode der Prüfung ist das Ergebnis; er wird nicht geglättet.
    sys.exit(subprocess.run(argv, cwd=ppath(name)).returncode)

def cmd_feedback(name):
    print("Neuer Punkt für", name, "(leere Titelzeile = Abbruch)")
    title = input("Titel: ").strip()
    if not title: return
    description = input("Beschreibung: ").strip()
    n = add_feedback(name, title, description)
    print(col("g", f"{n} eingetragen. Starten mit: vibe run {name}"))

# ---------- Typen, neue und vorhandene Projekte ----------
def types():
    return sorted(t for t in os.listdir(TPL) if t != "common" and os.path.isdir(os.path.join(TPL, t))) if os.path.isdir(TPL) else []

def cmd_types():
    print("Projekttypen (Ordner unter " + TPL + "):")
    for t in types():
        e = read_env(os.path.join(TPL, t, ".vibe", "project.env"))
        print(f"  {t:10} quick: {e.get('VERIFY_QUICK','-')}")
    print("Neuen Typ anlegen = Ordner templates/<typ>/ mit AGENTS.md und .vibe/project.env.")

def copy_tree(src, dst, name):
    created = []
    if not os.path.isdir(src): return created
    for root, _, files in os.walk(src):
        for f in files:
            s = os.path.join(root, f); rel = os.path.relpath(s, src); d = os.path.join(dst, rel)
            # lexists erhält auch kaputte Symlinks; ein normales exists würde
            # beim Schreiben dem Link nach außerhalb des Projekts folgen.
            if os.path.lexists(d): continue
            os.makedirs(os.path.dirname(d), exist_ok=True)
            with open(s, encoding="utf-8") as source:
                content = source.read().replace("{{NAME}}", name)
            with open(d, "w", encoding="utf-8") as target:
                target.write(content)
            if f.endswith(".sh"): os.chmod(d, 0o755)
            created.append(rel)
    return created

def _write_text_atomic(path, text, expected=None):
    """Schreibt über die gemeinsame Storage-Schicht (V-005), nie halb geschrieben."""
    return vibe_storage.write_text(path, text, expected=expected)


def ensure_gitignore(project):
    """Stellt sicher, dass ``.vibe/`` nicht versioniert wird (GH-48).

    Eine fehlende ``.gitignore`` wird mit der Zeile ``.vibe/`` angelegt; eine
    vorhandene Datei wird nie überschrieben, sondern nur ergänzt, wenn weder
    ``.vibe/`` noch ``/.vibe/`` noch ``.vibe`` als (gestrippte) Zeile vorhanden
    ist. Liefert ``"created"``, ``"appended"`` oder ``False``. Symlinks werden
    nicht verfolgt, damit nichts außerhalb des Projekts geschrieben wird.
    """
    path = os.path.join(project, ".gitignore")
    if os.path.islink(path):
        return False
    if not os.path.isfile(path):
        _write_text_atomic(path, ".vibe/\n", expected=vibe_storage.MISSING)
        return "created"
    try:
        with open(path, encoding="utf-8") as handle:
            text = handle.read()
    except UnicodeDecodeError:
        # Kein UTF-8: lieber unverändert lassen als ungültige Bytes ersetzen.
        return False
    stripped = {line.strip() for line in text.splitlines()}
    if stripped & {".vibe/", "/.vibe/", ".vibe"}:
        return False
    expected = vibe_storage.file_digest(path)
    updated = text if text.endswith("\n") else text + "\n"
    updated += ".vibe/\n"
    _write_text_atomic(path, updated, expected=expected)
    return "appended"


def agents_file_view(name):
    """Ansicht der AGENTS.md eines Projekts (F31, GH-101).

    Liefert den vollständigen Dateiinhalt als ``text`` samt Prüfsumme für das
    spätere Speichern. ``before``, ``after`` und ``managed`` bleiben nur als
    Kompatibilitätsfelder für die eingefrorene klassische UI erhalten:
    ``before`` ist der Gesamttext, ``after`` leer und ``managed`` immer
    ``None``. Eine fehlende Datei oder ein Symlink ergibt ``exists=False``; es
    wird nichts gelesen, was außerhalb des Projekts liegen könnte.
    """
    path = os.path.join(ppath(name), "AGENTS.md")
    backups = agents_file_backups(name)
    if os.path.islink(path) or not os.path.isfile(path):
        return {"exists": False, "digest": "", "text": "", "before": "",
                "managed": None, "after": "", "backups": backups}
    digest = vibe_storage.file_digest(path)
    try:
        with open(path, encoding="utf-8") as handle:
            text = handle.read()
    except UnicodeDecodeError as error:
        raise ValueError("AGENTS.md ist nicht UTF-8 kodiert: " + str(error)) from error
    return {"exists": True, "digest": digest, "text": text, "before": text,
            "managed": None, "after": "", "backups": backups}

def agents_file_save(name, text, digest, before=None, after=None):
    """Schreibt die AGENTS.md wörtlich mit Digest-Schutz (F31, GH-101).

    ``text`` ist der vollständige neue Inhalt. Fehlt ``text`` (``None``),
    werden ``before`` und ``after`` für die eingefrorene klassische UI wörtlich
    konkateniert. Es gibt keinen verwalteten Block mehr: Marker werden weder
    erkannt noch erzeugt, aktualisiert oder abgelehnt. Der Digest-Schutz der
    Speicherschicht verhindert, dass eine zwischenzeitliche fremde Änderung
    überschrieben wird; bei jeder Ablehnung bleibt die Datei unverändert.
    """
    if text is None:
        if not isinstance(before, str) or not isinstance(after, str):
            raise ValueError(
                "Ohne Text müssen vorheriger und nachfolgender Teil Text sein.")
        content = before + after
    elif isinstance(text, str):
        content = text
    else:
        raise ValueError("Der Inhalt der AGENTS.md muss Text sein.")
    if not isinstance(digest, str) or not digest:
        raise ValueError("Prüfsumme fehlt. Bitte die Ansicht neu laden.")
    path = os.path.join(ppath(name), "AGENTS.md")
    if os.path.islink(path) or not os.path.isfile(path):
        raise ValueError(
            "AGENTS.md fehlt oder ist ein Symlink; bitte zuerst aus der "
            "Vorlage anlegen.")
    try:
        # Nur zur Wahrung der bisherigen UTF-8-Fehlerbehandlung lesen; der
        # Inhalt selbst wird nicht umgeschrieben.
        with open(path, encoding="utf-8") as handle:
            handle.read()
    except UnicodeDecodeError as error:
        raise ValueError("AGENTS.md ist nicht UTF-8 kodiert: " + str(error)) from error
    vibe_storage.write_text(path, content, expected=digest)

def agents_file_create(name):
    """Legt eine fehlende AGENTS.md aus der Typ-Vorlage an (F31).

    Vorhandene Dateien bleiben unverändert (Rückgabe ``"kept"``); Symlinks
    werden abgelehnt. Ein unbekannter Projekttyp verwendet wie ``cmd_init``
    die Vorlage ``generic``. Geschrieben wird atomar; eine zwischenzeitlich
    angelegte Datei wird nicht überschrieben.
    """
    project = ppath(name)
    path = os.path.join(project, "AGENTS.md")
    if os.path.islink(path):
        raise ValueError(
            "AGENTS.md ist ein Symlink und wird nicht verändert.")
    if os.path.lexists(path):
        return "kept"
    typ = ptype(name)
    if typ not in types():
        typ = "generic"
    template = os.path.join(TPL, typ, "AGENTS.md")
    try:
        with open(template, encoding="utf-8") as handle:
            content = handle.read().replace("{{NAME}}", name)
    except OSError as error:
        raise ValueError("Vorlage für AGENTS.md fehlt: " + template) from error
    vibe_storage.write_text(path, content, expected=vibe_storage.MISSING)
    return "created"

def cmd_platform_instructions(args):
    """Schreibt den versteckten Plattformtext für Agentenläufe (GH-76).

    Der Text liegt außerhalb jedes Projekts und wird von opencode über die
    Inline-Konfiguration als zusätzliche ``instructions``-Quelle geladen. Ein
    vorhandenes Ziel wird byte-identisch neu geschrieben; ein Symlink wird
    abgelehnt, damit nie eine fremde Datei verändert wird. Die letzte
    stdout-Zeile ist der absolute Pfad der geschriebenen Datei.
    """
    directory = None
    index = 0
    while index < len(args):
        token = args[index]
        if token == "--directory":
            if index + 1 >= len(args):
                sys.exit("Aufruf: vibe platform-instructions --directory <ordner>")
            directory = args[index + 1]
            index += 2
            continue
        sys.exit("Aufruf: vibe platform-instructions --directory <ordner>")
    if not directory:
        sys.exit("Aufruf: vibe platform-instructions --directory <ordner>")
    try:
        path = vibe_harness.write_platform_instructions(directory)
    except (vibe_harness.HarnessError, OSError, vibe_storage.StorageError) as error:
        sys.exit(str(error))
    print(path)


# AP5 (C5): Relativer Pfad der Test-Agent-Vorlage, wie ``copy_tree`` ihn in
# ``created`` liefert (``os.path.relpath``). Es wird bewusst kein Test-Agent
# hardcoded angelegt und kein ``TESTER=`` geschrieben (Commit 35233ff);
# gemeldet wird nur, wenn eine Vorlage die Datei tatsächlich neu kopiert hat.
TEST_AGENT_REL = os.path.join(".opencode", "agents", "test-agent.md")


def _test_agent_created(created):
    """C5: True, wenn die Vorlage den Test-Agent neu angelegt hat."""
    return TEST_AGENT_REL in created


def agents_file_backup_dir(name):
    """Verzeichnis der AGENTS.md-Sicherungen im Projekt (``.vibe/agents-backups``)."""
    return os.path.join(ppath(name), ".vibe", "agents-backups")


def agents_file_backups(name):
    """Vorhandene AGENTS.md-Sicherungen dieses Projekts, neueste zuerst.

    Liefert nur die Dateinamen (die bereits einen Zeitstempel tragen) und
    keinen Dateiinhalt, damit keine Geheimnisse aus einer Sicherung in die
    Ansicht gelangen. Die Sortierung ist stabil (Änderungszeit, dann Name).
    """
    directory = agents_file_backup_dir(name)
    items = vibe_storage.list_backups(directory)
    items.sort(key=lambda item: (
        os.path.getmtime(os.path.join(directory, item)), item), reverse=True)
    return [{"name": item} for item in items]


def agents_file_backup(name):
    """Sichert die AGENTS.md des Projekts; die Datei bleibt unverändert.

    Der Sicherungsname trägt einen Zeitstempel und ist kollisionsfrei. Die
    Sicherung liegt im Projekt unter ``.vibe/agents-backups`` und wird von
    ``agents_file_restore`` nur auf ausdrücklichen Namen wiederhergestellt.
    """
    target = os.path.join(ppath(name), "AGENTS.md")
    return vibe_storage.backup_file(
        target, agents_file_backup_dir(name), label="AGENTS.md")


def agents_file_restore(name, backup_name):
    """Stellt genau die benannte AGENTS.md-Sicherung des Projekts wieder her.

    Nur Sicherungen aus ``.vibe/agents-backups`` dieses Projekts werden
    akzeptiert; unbekannte, fehlende oder fremde Namen werden abgelehnt, ohne
    die Datei zu verändern. Es gibt keine implizite Auswahl der neuesten
    Sicherung. Vor dem Zurückschreiben legt die Speicherschicht den aktuellen
    Stand als Safety-Sicherung ab.
    """
    if not isinstance(backup_name, str) or not backup_name:
        raise ValueError("Name der AGENTS.md-Sicherung fehlt.")
    directory = agents_file_backup_dir(name)
    if backup_name not in vibe_storage.list_backups(directory):
        raise ValueError("AGENTS.md-Sicherung nicht gefunden: " + backup_name)
    target = os.path.join(ppath(name), "AGENTS.md")
    return vibe_storage.restore_backup(directory, backup_name, target,
                                       label="AGENTS.md")


_GLOBAL_AGENTS_TEMPLATE = """# Globale AGENTS.md

Instruktionen, die für **alle** Projekte gelten, ergänzen Sie hier —
zum Beispiel Codestil, Sicherheitsregeln oder Konsolidierungsrichtlinien.

<!-- Ausgangspunkt — passen Sie diesen Block an oder entfernen Sie ihn. -->
"""


def global_agents_path(environ=None):
    """Ort der universellen AGENTS.md im opencode-Konfigurationsordner (WP6.3).

    Auflösungsreihenfolge: ``VIBE_GLOBAL_AGENTS`` →
    ``XDG_CONFIG_HOME/opencode/AGENTS.md`` → ``~/.config/opencode/AGENTS.md``.
    Nur auflösen, nie anlegen.
    """
    env = dict(os.environ if environ is None else environ)
    override = env.get("VIBE_GLOBAL_AGENTS")
    if vibe_paths._given(override):
        return os.path.abspath(
            vibe_paths._expand_user(override, vibe_paths._home(env)))
    home = vibe_paths._home(env)
    xdg = env.get("XDG_CONFIG_HOME")
    base = vibe_paths._expand_user(xdg, home) if vibe_paths._given(xdg) \
        else os.path.join(home, ".config")
    return os.path.join(base, "opencode", "AGENTS.md")


def global_agents_backup_dir():
    """Ablage der Sicherungen der universellen AGENTS.md."""
    return os.path.join(PATHS.state, "global-agents-backups")


def global_agents_view():
    """Ansicht der universellen AGENTS.md: ``exists``, ``digest``, ``text``, ``path_hint``.

    Eine fehlende Datei ist kein Fehler (``exists`` falsch, Text leer); ein
    Symlink wird nicht gelesen. ``backups`` listet vorhandene Sicherungen.
    """
    path = global_agents_path(None)
    backups = vibe_storage.list_backups(global_agents_backup_dir())
    if os.path.islink(path):
        return {"exists": False, "digest": "", "text": "",
                "path_hint": "Symlink wird nicht gelesen: " + str(path),
                "backups": backups}
    snapshot = vibe_storage.read_snapshot(path)
    if not snapshot.exists:
        return {"exists": False, "digest": "", "text": "",
                "path_hint": str(path), "backups": backups}
    return {"exists": True, "digest": snapshot.digest,
            "text": snapshot.text, "path_hint": str(path),
            "backups": backups}


def global_agents_save(text, digest):
    """Schreibt die universelle AGENTS.md atomar mit Digest-Schutz.

    Ein überholter Digest wird abgelehnt (``ConcurrentChangeError``), Symlinks
    werden nicht verfolgt. Liefert ``{"ok", "message", "digest"}``.
    """
    if not isinstance(text, str) or not isinstance(digest, str) or not digest:
        raise ValueError("Speichern der globalen AGENTS.md verlangt Text und "
                         "Prüfsumme.")
    path = global_agents_path(None)
    if os.path.islink(path):
        raise ValueError("Symlink wird nicht überschrieben.")
    vibe_storage.write_text(path, text, expected=digest)
    return {"ok": True, "message": "Gespeichert",
            "digest": vibe_storage.digest_bytes(text.encode("utf-8"))}


def global_agents_create():
    """Legt eine minimale universelle AGENTS.md an, falls die Datei fehlt.

    Vorhandene Dateien bleiben unverändert (``"kept"``); Symlinks werden
    abgelehnt. Geschrieben wird atomar.
    """
    path = global_agents_path(None)
    if os.path.islink(path):
        raise ValueError("Symlink wird nicht überschrieben.")
    if os.path.lexists(path):
        return "kept"
    vibe_storage.write_text(
        path, _GLOBAL_AGENTS_TEMPLATE, expected=vibe_storage.MISSING)
    return "created"


def cmd_init(name, typ=None, out=None):
    out = out or sys.stdout
    p = ppath(name); typ = typ or ptype(name)
    if typ not in types(): typ = "generic"
    created = copy_tree(os.path.join(TPL, "common"), p, name) + copy_tree(os.path.join(TPL, typ), p, name)
    gitignore = ensure_gitignore(p)
    print(col("g", f"{name}: als '{typ}' vorbereitet.", stream=out) + (" Neu angelegt: " + ", ".join(created) if created else " Nichts zu ergänzen."), file=out)
    if gitignore:
        action = "angelegt" if gitignore == "created" else "ergänzt"
        print(f".gitignore {action}: .vibe/ wird nicht versioniert; vorhandene Inhalte blieben unverändert.", file=out)
    if _test_agent_created(created):
        print("Unabhängiger Test-Agent ergänzt; vorhandene Agentendateien und TESTER blieben unverändert.", file=out)
    print("Vorhandene Dateien wurden nicht verändert. Nicht committet: bitte prüfen und selbst committen.", file=out)
    if typ not in ("android",): print("Prüfbefehle in .vibe/project.env eintragen (VERIFY_QUICK / VERIFY_FULL), sonst bricht die Abschlussprüfung ab.", file=out)

def _check_template(value):
    if any(char in value for char in ("\x00", "\n", "\r")):
        sys.exit("Vorlage enthält unerlaubte Steuerzeichen.")
    return value

def _init_git(p):
    """Legt das Projekt-Repository an; jeder Schritt ist ein eigener Aufruf."""
    ident = [] if run(["git", "config", "user.email"])[1] else ["-c", "user.name=vibe", "-c", "user.email=vibe@localhost"]
    rc, out = 0, ""
    for argv in (["git", "init", "-q"], ["git", "config", "core.fileMode", "false"],
                 ["git", "add", "-A"], ["git"] + ident + ["commit", "-q", "-m", "init: vibe-Vorlage"]):
        rc, out = run(argv, cwd=p)
        if rc != 0: break
    return rc, out

def cmd_new(name, typ, tpl=None, out=None):
    out = out or sys.stdout
    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]*", name): sys.exit("Name: nur a-z, 0-9, _ und -")
    if typ not in types(): sys.exit(f"Unbekannter Typ '{typ}'. Vorhanden: {', '.join(types())}")
    p = os.path.join(VIBE, name)
    if os.path.exists(p): sys.exit("Existiert schon: " + p)
    if typ == "android":
        if tpl is not None: _check_template(tpl)
        if not tpl:
            if not sys.stdin.isatty(): sys.exit("Android braucht eine Vorlage (Parameter vorlage).")
            print(run(["android", "create", "--list"], timeout=60)[1], file=out)
            tpl = _check_template(input("Vorlage (aus der Liste, z. B. die Compose-Vorlage): ").strip())
        rc, output = run(["android", "create", f"--name={name.capitalize()}", f"--output={p}", tpl], timeout=300); print(output, file=out)
        if rc != 0 or not os.path.isdir(p): sys.exit("android create fehlgeschlagen")
    else:
        os.makedirs(p)
    copy_tree(os.path.join(TPL, "common"), p, name); copy_tree(os.path.join(TPL, typ), p, name)
    ensure_gitignore(p)
    rc, output = _init_git(p)
    if rc != 0: print(col("y", "Git-Hinweis: " + output, stream=out), file=out)
    _pm.clear()
    print(col("g", f"Projekt {name} ({typ}) angelegt: {p}", stream=out), file=out)
    print("Als Nächstes: SPEC.md füllen und Tickets im Dashboard anlegen, dann vibe run", name, file=out)

# ---------- Auschecken aus GitHub (AP8) ----------
# Ein ausgechecktes Projekt bekommt die lokale vibe-Konfiguration: Vorlagen,
# allgemeine Regeln, Test-Agent und die Agentenauswahl werden auf den lokalen
# Stand gebracht. Mit dem Repository mitgelieferte vibe-Einstellungen
# überschreiben die lokalen Einstellungen nie — jeder Nutzer passt die
# Einstellungen je Projekt individuell an seine vibe-Instanz an (analog zu
# einer IDE). Managed-Schlüssel in .vibe/project.env stammen deshalb aus der
# lokalen Vorlage; fremde, nicht verwaltete Schlüssel bleiben erhalten.


# Schlüssel in .vibe/project.env, die beim Auschecken konsequent auf den
# lokalen Stand gebracht werden (Projektordination); alle anderen Schlüssel
# eines mitgelieferten project.env bleiben unangetastet.
MANAGED_ENV_KEYS = (
    "TYPE", "REVIEWER", "TESTER", "SANDBOX", "SANDBOX_TOOLS",
    "VERIFY_QUICK", "VERIFY_PACKAGE", "VERIFY_FULL",
)


def _detect_project_type(project):
    """Erkennt den Projekttyp anhand von Markern (ohne project.env)."""
    return type_from_markers(project)


def _checkout_name(url, name):
    """Prüft einen gegebenen Namen oder leitet ihn aus der Adresse ab."""
    name = str(name or "").strip()
    if name:
        if not NAME_RE.match(name):
            raise ValueError("Projektname: nur a-z, 0-9, _ und -, beginnend mit "
                             "Buchstabe oder Ziffer (erhalten: " + repr(name) + ")")
        return name
    raw = str(url).split("?", 1)[0].split("#", 1)[0].rstrip("/")
    part = re.split(r"[/\\:]", raw)[-1]
    part = re.sub(r"\.git$", "", part, flags=re.IGNORECASE)
    part = re.sub(r"[^a-z0-9_-]+", "-", part.lower())
    part = re.sub(r"-{2,}", "-", part).strip("-_")[:64]
    if not NAME_RE.match(part):
        raise ValueError("Aus der Adresse lässt sich kein Projektname ableiten: "
                         "Namen angeben (" + vibe_github.mask_url(url) + ")")
    return part

def _adopt_project_env(project, name, typ):
    """Vereinheitlicht .vibe/project.env auf die lokale Vorlage.

    Fehlt die Datei, entsteht sie aus der Vorlage des erkannten Typs
    (kopiert von copy_tree) oder minimal. Existiert sie (mit dem Repository
    mitgeliefert), werden nur abweichende verwaltete Schlüssel auf die
    lokalen Vorlagewerte gesetzt; identische Zeilen bleiben im bisherigen
    Format, sonstige Schlüssel und Kommentare bleiben erhalten.
    """
    env_path = os.path.join(project, ".vibe", "project.env")
    if not os.path.isfile(env_path):
        os.makedirs(os.path.dirname(env_path), exist_ok=True)
        vibe_storage.write_text(env_path, "TYPE=" + typ + "\n")
        return "Projekteinstellungen angelegt (Typ " + typ + ")"
    template_env = os.path.join(TPL, typ, ".vibe", "project.env")
    values = read_env(template_env) if os.path.isfile(template_env) else {}
    values["TYPE"] = typ
    current = read_env(env_path)
    # Nur verwaltete Schlüssel gewinnen: Mit dem Repository mitgelieferte
    # Werte werden auf den lokalen Vorlagestand gebracht, fremde Schlüssel
    # (z. B. projektspezifische Zusätze) bleiben erhalten.
    diff = {key: value for key, value in values.items()
            if key in MANAGED_ENV_KEYS and current.get(key) != value}
    if diff:
        set_env_values(name, diff)
    return "Projekteinstellungen auf den lokalen Stand gebracht (Typ " + typ + ")"


def _remap_project_agents(name, project):
    """Bildet die aktiven Agenten des Projekts auf lokale Agenten ab.

    Agenten, die es lokal nicht gibt, verlieren die Aktivierung und ihre
    Modellüberschreibung; der Vibe-Agent bleibt immer aktiv. Eine unlesbare
    Auswahl bleibt unverändert und wird gemeldet, statt sie still zu
    überschreiben.
    """
    path = os.path.join(project, ".vibe", "agents.json")
    if not os.path.isfile(path):
        return ""
    try:
        config, snapshot = project_agents_load(name)
    except ValueError as error:
        return "Agentenauswahl unlesbar, bleibt unverändert (" + str(error) + ")"
    inventory = project_agent_inventory(name)
    vibe = vibe_agent_name()
    active = [agent for agent in config["aktiv"] if agent in inventory]
    if vibe and vibe not in active:
        active.append(vibe)
    models = {agent: model for agent, model in config["modelle"].items()
              if agent in inventory}
    removed = sorted(set(config["aktiv"]) - set(active)
                     | set(config["modelle"]) - set(models))
    clean = {"version": PROJECT_AGENTS_VERSION, "aktiv": sorted(set(active)),
             "modelle": models, "opencode": config.get("opencode", {})}
    if clean == config:
        return "" if not removed else \
            "Aktive Agenten: bereits auf die lokal konfigurierten Agenten begrenzt"
    project_agents_save(name, clean,
                        expected=snapshot.digest if snapshot.exists else vibe_storage.MISSING)
    return "Aktive Agenten auf die lokal konfigurierten Agenten angepasst" + \
        ("; entfernt: " + ", ".join(removed) if removed else "")


def checkout_from_github(url, name=None, branch=None):
    """Checkt ein Repository aus und richtet es als neues Projekt ein.

    Mit ``branch`` wird genau dieser Branch ausgecheckt (AP9); ohne Angabe
    gilt der Standard-Branch des Remotes.

    Liefert (Name, Zusammenfassung). Fehler werden als ValueError mit
    verständlicher Meldung geworfen; ein fehlgeschlagener Aufruf hinterlässt
    kein halbes Projekt (Auschecken und Übernahme räumen den Zielordner auf,
    wenn er vorher nicht existierte). github.com-Adressen werden zusätzlich
    verknüpft (GITHUB_REPO/GITHUB_ENABLED wie bei „vibe github link“), ohne
    einen GitHub-REST-API-Aufruf oder Token zu benötigen; das Setzen des
    Remote-Standard-Branch fragt den Git-Remote selbst ab. Andere Remotes
    bleiben ohne GitHub-Schlüssel.
    """
    url = str(url or "").strip()
    if not url:
        raise ValueError("Remote-Adresse fehlt")
    slug = vibe_github.parse_remote_url(url)
    name = _checkout_name(url, name)
    target = os.path.join(VIBE, name)
    _pm.clear()
    if os.path.lexists(target):
        raise ValueError("Zielordner existiert bereits: " + target
                         + " — anderen Namen wählen")
    if name in project_map():
        raise ValueError("Projektname ist bereits vergeben: " + name)
    # AP9: Der optionale Branch wird nur weitergereicht, wenn er gesetzt ist;
    # der AP8-Standardaufruf bleibt unverändert.
    if branch:
        rc, out = vibe_github.clone(url, target, branch=branch)
    else:
        rc, out = vibe_github.clone(url, target)
    if rc != 0:
        shutil.rmtree(target, ignore_errors=True)
        raise ValueError("Auschecken fehlgeschlagen: " + (out or "unbekannter Fehler"))
    _pm.clear()
    try:
        notes = _adopt_checked_out_project(target, name)
        if slug:
            set_env_values(name, {"GITHUB_ENABLED": "1", "GITHUB_REPO": slug})
            vibe_github.set_head_default(target)
            notes.append("GitHub verknüpft: " + slug)
    except (OSError, vibe_storage.StorageError) as error:
        # Das Projekt ist angelegt, aber nicht vollständig übernommen; ohne
        # Aufräumen bliebe ein halbes Projekt zurück und ein erneuter Versuch
        # scheiterte am Zielordner. Nur der frisch erzeugte Ordner wird
        # entfernt — bestehende Ordner wurden oben abgelehnt.
        shutil.rmtree(target, ignore_errors=True)
        _pm.clear()
        raise ValueError("Übernahme fehlgeschlagen, Zielordner entfernt: "
                         + str(error)) from None
    return name, "; ".join(notes) if notes else "Projekt übernommen (keine Anpassungen nötig)"


def _adopt_checked_out_project(project, name):
    """Bringt die vibe-Einstellungen des Projekts auf den lokalen Stand."""
    notes = []
    typ = _detect_project_type(project)
    if typ not in types():
        typ = "generic"
    created = copy_tree(os.path.join(TPL, "common"), project, name) \
        + copy_tree(os.path.join(TPL, typ), project, name)
    if created:
        notes.append("Fehlende Vorlagedateien ergänzt: " + ", ".join(created))
    gitignore = ensure_gitignore(project)
    if gitignore:
        notes.append(".gitignore " + ("angelegt" if gitignore == "created" else "ergänzt")
                     + ": .vibe/ wird nicht versioniert")
    if _test_agent_created(created):
        notes.append("Unabhängiger Test-Agent ergänzt (" + TEST_AGENT_REL + ")")
    try:
        env_note = _adopt_project_env(project, name, typ)
        notes.append(env_note)
        agents_note = _remap_project_agents(name, project)
        if agents_note:
            notes.append(agents_note)
    except (OSError, vibe_storage.StorageError) as error:
        raise ValueError("Lokale Einstellungen konnten nicht übernommen werden: "
                         + str(error)) from None
    return notes


def _parse_clone_cli(rest):
    """CLI-Optionen für „vibe clone <url> [name] --branch <branch>“."""
    positional = []
    branch = None
    index = 0
    while index < len(rest):
        token = rest[index]
        if token == "--branch":
            if index + 1 >= len(rest):
                raise ValueError("Option --branch erwartet einen Branch-Namen")
            branch = rest[index + 1]
            index += 1
        else:
            positional.append(token)
        index += 1
    if len(positional) < 1:
        raise ValueError("Remote-Adresse fehlt: vibe clone <url> [name]")
    url = positional[0]
    name = positional[1] if len(positional) > 1 else None
    return url, name, branch

def cmd_clone(url, name=None, branch=None, out=None):
    """CLI für „vibe clone <url> [name] [--branch <branch>]“."""
    out = out or sys.stdout
    try:
        found, summary = checkout_from_github(url, name, branch=branch)
    except (ValueError, OSError, vibe_storage.StorageError) as error:
        sys.exit(str(error))
    print(col("g", "Projekt " + found + " ausgecheckt und eingerichtet."), file=out)
    print(summary, file=out)
    print("Änderungen am Arbeitsbaum liegen vor: bitte prüfen und selbst committen.", file=out)

# ---------- Agenten (global und projektspezifisch) ----------
# v2-Regelblöcke: Jede Regel ist (action, resource, effect). Die Reihenfolge
# bleibt erhalten, weil in opencode v2 'die letzte passende Regel gewinnt'.
PERMS = {
 "voll": [
     ("read", "*", "allow"),
     ("glob", "*", "allow"),
     ("grep", "*", "allow"),
     ("edit", "*", "allow"),
     ("shell", "*", "allow"),
     ("subagent", "*", "deny"),
     ("webfetch", "*", "deny"),
     ("websearch", "*", "deny"),
 ],
 "lesen": [
     ("read", "*", "allow"),
     ("glob", "*", "allow"),
     ("grep", "*", "allow"),
     ("edit", "*", "deny"),
     ("shell", "*", "deny"),
     ("subagent", "*", "deny"),
     ("webfetch", "*", "deny"),
     ("websearch", "*", "deny"),
 ],
 "lesen_git": [
     ("read", "*", "allow"),
     ("glob", "*", "allow"),
     ("grep", "*", "allow"),
     ("edit", "*", "deny"),
     ("shell", "*", "deny"),
     ("shell", "git status --short", "allow"),
     ("shell", "git diff *", "allow"),
     ("shell", "git show *", "allow"),
     ("shell", "git log *", "allow"),
     ("subagent", "*", "deny"),
     ("webfetch", "*", "deny"),
     ("websearch", "*", "deny"),
 ],
}
# v1-Vorlagen nur noch zur Migration bestehender Dateien; Neuerzeugung ist v2.
V1_PERMS = {
 "voll": "  read: allow\n  glob: allow\n  grep: allow\n  list: allow\n  edit: allow\n  bash: allow\n  webfetch: deny\n  websearch: deny",
 "lesen": "  read: allow\n  glob: allow\n  grep: allow\n  list: allow\n  edit: deny\n  bash: deny\n  task: deny\n  webfetch: deny\n  websearch: deny",
 "lesen_git": '  read: allow\n  glob: allow\n  grep: allow\n  list: allow\n  edit: deny\n  bash:\n    "*": deny\n    "git status --short": allow\n    "git diff *": allow\n    "git show *": allow\n    "git log *": allow\n  task: deny\n  webfetch: deny\n  websearch: deny',
}
PERM_LABELS = {"voll": "Voll (lesen, schreiben, Shell)", "lesen": "Nur lesen", "lesen_git": "Nur lesen + Git lesend"}
PERM_LABELS_PROJECT = dict(PERM_LABELS, voll="Voll (edit nur in erlaubten Verzeichnissen, Shell erlaubt)")

def _rule_lines(action, resource, effect):
    """Eine v2-Regel als drei eingerückte YAML-Zeilen."""
    return ["  - action: " + action,
            "    resource: " + json.dumps(resource, ensure_ascii=False),
            "    effect: " + effect]

def _rules_lines(rules):
    lines = []
    for rule in rules:
        if isinstance(rule, dict):
            action, resource, effect = rule.get("action"), rule.get("resource"), rule.get("effect")
        else:
            action, resource, effect = rule
        lines += _rule_lines(action, resource, effect)
    return lines

def _edit_rules(write_dirs):
    """edit-Regeln mit breiter Deny-Regel zuerst, dann je Verzeichnis allow."""
    rules = [("edit", "*", "deny")]
    for directory in (write_dirs or []):
        rules.append(("edit", directory, "allow"))
        rules.append(("edit", directory + "/**", "allow"))
    return rules

def _v1_edit_lines(write_dirs):
    """v1-Zeilen für edit-Rechte (Kompatibilität für v1-Bestandsblöcke)."""
    if not write_dirs: return ["  edit: deny"]
    lines = ["  edit:"]
    for d in write_dirs:
        lines.append(f'    {json.dumps(d, ensure_ascii=False)}: allow')
        lines.append(f'    {json.dumps(d + "/**", ensure_ascii=False)}: allow')
    lines.append('    "*": deny')
    return lines

def edit_permission_lines(write_dirs):
    """v2-YAML-Zeilen für edit-Rechte, die nur die erlaubten Verzeichnisse zulassen."""
    return _rules_lines(_edit_rules(write_dirs))

def _permission_rules(perm="lesen", write_dirs=None):
    """Geordnete v2-Regeln einer Vorlage; 'voll' ggf. verzeichnisbeschränkt."""
    if perm not in PERMS: perm = "lesen"
    rules = [tuple(rule) for rule in PERMS[perm]]
    if perm == "voll" and write_dirs is not None:
        edit = _edit_rules(write_dirs)
        index = next((i for i, rule in enumerate(rules) if rule[0] == "edit"), len(rules))
        rules[index:index + 1] = edit
    return rules

def permission_block(perm="lesen", write_dirs=None):
    """v2-Regelblock als Zeichenkette (ohne die Kopfzeile ``permissions:``)."""
    return "\n".join(_rules_lines(_permission_rules(perm, write_dirs)))

def agent_dir(scope):
    return AGENTS_DIR if scope == "global" else vibe_opencode.agent_directory(ppath(scope))

# ---------- Agenten-Metadaten (AP03) ----------
# Ergebnis und Rolle sind keine opencode-Frontmatter-Felder. Sie werden deshalb
# getrennt vom Agenten gepflegt; eine Änderung an "Ergebnis" verändert niemals
# die Agentendatei. Der Zustand liegt im persönlichen Zustandsordner.
AGENT_META_FILE = os.path.join(PATHS.state, "agent-meta.json")
AGENT_META_KEYS = ("agents",)
AGENT_META_ENTRY_KEYS = ("result",)
ROLE_NAMES = ("coder", "reviewer", "vibe", "tester", "analyst", "sonstiges", "content-creator")


def _agent_meta_check(data):
    """Prüft und normalisiert die Metadaten ohne sie zu schreiben."""
    if not isinstance(data, dict):
        raise ValueError("Agenten-Metadaten müssen ein JSON-Objekt sein.")
    unknown = sorted(set(data) - set(AGENT_META_KEYS))
    if unknown:
        raise ValueError("Unbekannte Felder in den Agenten-Metadaten: " + ", ".join(unknown))
    agents = data.get("agents", {})
    if not isinstance(agents, dict):
        raise ValueError("'agents' muss ein Objekt mit Agentenname und Ergebnis sein.")
    clean = {}
    for name, entry in agents.items():
        if not isinstance(name, str) or not NAME_RE.match(name):
            raise ValueError("Ungültiger Agentenname in den Metadaten: " + repr(name))
        if not isinstance(entry, dict):
            raise ValueError("Metadaten von '" + name + "' müssen ein Objekt sein.")
        entry_unknown = sorted(set(entry) - set(AGENT_META_ENTRY_KEYS))
        if entry_unknown:
            raise ValueError("Unbekannte Felder bei '" + name + "': " + ", ".join(entry_unknown))
        result = entry.get("result", "")
        if not isinstance(result, str):
            raise ValueError("Das Ergebnis von '" + name + "' muss eine Zeichenkette sein.")
        if result.strip():
            clean[name] = {"result": result}
    return {"agents": dict(sorted(clean.items()))}


def agent_meta_load():
    """Liest die Agenten-Metadaten; eine fehlende Datei ist der leere Zustand."""
    snapshot = vibe_storage.read_snapshot(AGENT_META_FILE)
    if not snapshot.exists:
        return {"agents": {}}
    try:
        data = json.loads(snapshot.text)
    except (TypeError, ValueError):
        raise ValueError("Die Agenten-Metadaten sind kein gültiges JSON: " + AGENT_META_FILE)
    return _agent_meta_check(data)


def agent_meta_save(data, expected=None):
    """Schreibt die Agenten-Metadaten atomar und prüft eine erwartete Prüfsumme."""
    config = _agent_meta_check(data)
    snapshot = vibe_storage.read_snapshot(AGENT_META_FILE)
    if expected is not None:
        vibe_storage.check_expected(AGENT_META_FILE, snapshot, expected)
    os.makedirs(PATHS.state, exist_ok=True)
    text = json.dumps(config, indent=1, ensure_ascii=False, sort_keys=True) + "\n"
    vibe_storage.write_text(
        AGENT_META_FILE,
        text,
        expected=snapshot.digest if snapshot.exists else vibe_storage.MISSING,
    )
    return config


def agent_result(name):
    """Ergebnis eines Agenten oder ein leerer Wert."""
    if not NAME_RE.match(name or ""):
        raise ValueError("Name: nur a-z, 0-9, _ und -")
    return agent_meta_load()["agents"].get(name, {}).get("result", "")


def agent_result_set(name, result):
    """Setzt oder entfernt das Ergebnis eines Agenten."""
    if not NAME_RE.match(name or ""):
        raise ValueError("Name: nur a-z, 0-9, _ und -")
    if not isinstance(result, str):
        raise ValueError("Das Ergebnis muss eine Zeichenkette sein.")
    data = agent_meta_load()
    agents = dict(data["agents"])
    if result.strip():
        agents[name] = {"result": result}
    else:
        agents.pop(name, None)
    agent_meta_save({"agents": agents})
    return result


def agent_role_set(name, role):
    """Setzt die Rolle eines globalen Agenten; genau ein Agent trägt 'vibe'."""
    if not NAME_RE.match(name or ""):
        raise ValueError("Name: nur a-z, 0-9, _ und -")
    role = str(role or "").strip()
    if role and role not in ROLE_NAMES:
        raise ValueError("Unbekannte Rolle: " + role)
    if not os.path.exists(agent_path("global", name)):
        raise ValueError("Agent nicht gefunden: " + name)
    if role == "vibe":
        # F32: Der Vibe-Agent darf keine Subagenten seines eigenen Typs
        # erlauben. Die Invariante wird hier zentral für jede Rollenzuweisung
        # erzwungen (auch action:'role' aus der Agentenliste).
        try:
            policy = agent_task_policy(agent_read("global", name))
        except ValueError:
            # Defekte Datei ohne lesbares Frontmatter: bisheriges Verhalten
            # bleibt (Rolle zuweisbar); eine Selbstfreigabe ist darin nicht
            # nachweisbar. Lesbares Frontmatter wird dagegen geprüft, auch
            # wenn die Datei sonst ungültig ist (z. B. fehlende description).
            policy = {"mode": "none", "allowed": []}
        if policy["mode"] == "custom" and name in policy["allowed"]:
            raise ValueError(
                "Agent '" + name + "' erlaubt bereits Subagenten seines "
                "eigenen Typs und kann deshalb nicht der Vibe-Agent werden."
            )
    data, before = profiles_load(return_snapshot=True)
    roles = dict(data.get("rollen", {}))
    if roles.get(name) == "vibe" and role != "vibe":
        others = [agent for agent, value in roles.items() if value == "vibe" and agent != name]
        if not others:
            raise ValueError(
                "Der letzte Vibe-Agent kann nicht entfernt werden. Zuerst einem anderen Agenten die Rolle 'vibe' zuweisen."
            )
    if role == "vibe":
        for agent, value in list(roles.items()):
            if value == "vibe" and agent != name:
                roles.pop(agent)
    if role:
        roles[name] = role
    else:
        roles.pop(name, None)
    if roles == data.get("rollen", {}):
        return roles
    data["rollen"] = roles
    profiles_save(data, expected=before.digest if before.exists else vibe_storage.MISSING)
    return roles


def vibe_agent_name():
    """Name des globalen Agenten mit der reservierten Rolle 'vibe' oder ''."""
    for name, role in profiles_load().get("rollen", {}).items():
        if role == "vibe":
            return name
    return ""


def vibe_agent_status():
    """Zustand des Vibe-Agenten für Start und Oberfläche."""
    name = vibe_agent_name()
    if not name:
        return {"name": "", "model": "", "configured": False, "missing_model": True}
    model = ""
    try:
        parsed = _parse_agent_text(agent_read("global", name))
        model = (parsed.get("model") or "").strip()
    except ValueError:
        pass
    configured = bool(model)
    return {"name": name, "model": model,
            "configured": configured, "missing_model": not configured}

def _frontmatter_parts(text):
    """Zerlegt einen Agenten in Frontmatter, Prompt und Zeilen.

    Der Parser ist bewusst zeilenorientiert: Er ändert nur die ausdrücklich
    bearbeiteten Felder und erhält alle anderen Zeilen (auch unbekannte Felder,
    Kommentare und Reihenfolge) unverändert. Doppelte Top-Level-Felder werden
    abgelehnt, weil sonst nicht eindeutig wäre, welcher Wert gilt.
    """
    m = FRONTMATTER_RE.match(text)
    if not m:
        raise ValueError("Die Datei muss mit einem Frontmatter-Block beginnen (--- ... ---).")
    fm, body = m.group(1), text[m.end():]
    lines = fm.splitlines()
    seen = set()
    for section in _front_sections(lines):
        if section["key"] in seen:
            raise ValueError("Feld '" + section["key"] + "' ist doppelt im Frontmatter.")
        seen.add(section["key"])
    return m, fm, body, lines

def _front_sections(lines):
    """Top-Level-Felder mit ihren eingerückten Folgezeilen."""
    out, i = [], 0
    while i < len(lines):
        match = FRONT_KEY_RE.match(lines[i])
        if not match:
            i += 1
            continue
        start, key, inline = i, match.group(1), match.group(2).strip()
        i += 1
        while i < len(lines):
            if lines[i][:1] in (" ", "\t"):
                i += 1
            elif not lines[i].strip() and i + 1 < len(lines) and lines[i + 1][:1] in (" ", "\t"):
                i += 1
            else:
                break
        out.append({"key": key, "inline": inline, "start": start, "end": i})
    return out

def _unquote(value):
    value = (value or "").strip()
    if len(value) >= 2 and value[0] == value[-1] == '"':
        try:
            return json.loads(value)
        except ValueError:
            return value[1:-1]
    if len(value) >= 2 and value[0] == value[-1] == "'":
        # YAML maskiert ein einfaches Anführungszeichen durch Verdopplung.
        return value[1:-1].replace("''", "'")
    return value

def _v2_rules(lines):
    """Geordnete Regeln eines v2-``permissions``-Blocks; ``None`` ohne Block.

    ``lines`` ist die Frontmatter-Zeilenliste. Jede Regel ist ein Dict mit
    ``action``, ``resource`` und ``effect``; die Reihenfolge bleibt erhalten.
    """
    section = next((s for s in _front_sections(lines) if s["key"] == "permissions"), None)
    if section is None:
        return None
    rules, current = [], None
    for line in lines[section["start"] + 1:section["end"]]:
        if re.match(r"^[ \t]*-[ \t]+", line):
            if current is not None:
                rules.append(current)
            current = {}
        item = re.match(r"^[ \t]*(?:-[ \t]+)?([A-Za-z_][\w-]*):[ \t]*(.*)$", line)
        if not item:
            continue
        if current is None:
            current = {}
        current[item.group(1)] = _unquote(item.group(2))
    if current is not None:
        rules.append(current)
    return rules


def _parse_agent_text(text):
    """Liest die bearbeitbaren Felder und die unbekannten Schlüssel."""
    _m, _fm, body, lines = _frontmatter_parts(text)
    sections = _front_sections(lines)
    by_key = {section["key"]: section for section in sections}
    def inline(key):
        section = by_key.get(key)
        return _unquote(section["inline"]) if section else ""
    def block(key):
        section = by_key.get(key)
        return "\n".join(lines[section["start"]:section["end"]]) if section else ""
    fields = {key: inline(key) for key in AGENT_FIELDS}
    permission = by_key.get("permission")
    fields["permission"] = block("permission")
    fields["permission_inline"] = bool(permission and permission["inline"])
    permissions = by_key.get("permissions")
    fields["permissions"] = block("permissions")
    fields["permissions_inline"] = bool(permissions and permissions["inline"])
    fields["prompt"] = body.strip("\n")
    known = set(AGENT_FIELDS) | {"permission", "permissions"}
    fields["unknown"] = sorted({section["key"] for section in sections if section["key"] not in known})
    return fields

def _same_block(left, right):
    def normalized(value):
        return [line.rstrip() for line in value.splitlines() if line.strip()]
    return normalized(left) == normalized(right)

def agent_fields(scope, text):
    """Strukturierte Sicht auf einen Agenten für den Editor.

    ``permission`` ist die passende Vorlage oder ein leerer Wert, wenn der
    Rechteblock individuell ist. ``unknown`` nennt alle Felder, die der
    strukturierte Editor nicht kennt und deshalb unverändert stehen lässt.
    Ein v1-``permission``-Block gilt als individuell; v2-``permissions``-Blöcke
    werden gegen die Vorlagen verglichen.
    """
    parsed = _parse_agent_text(text)
    raw_permissions = parsed["permissions"]
    preset = ""
    if raw_permissions and not parsed["permissions_inline"]:
        try:
            dirs = None if scope == "global" else write_dirs(scope)
        except ValueError:
            dirs = None
        for key in PERMS:
            candidate = "permissions:\n" + permission_block(key, dirs)
            if _same_block(raw_permissions, candidate):
                preset = key
                break
    has_block = bool(raw_permissions) or bool(parsed["permission"])
    parsed["permission"] = preset
    parsed["permission_custom"] = has_block and not preset
    return parsed

def _validate_agent_field(key, value):
    """Prüft ein einzelnes bearbeitbares Feld; gibt den bereinigten Wert zurück."""
    value = str(value if value is not None else "").strip()
    if key == "description":
        if not value:
            raise ValueError("Die Beschreibung (description) darf nicht leer sein.")
        if value in ("Kurzbeschreibung eintragen", "Beschreibung fehlt"):
            raise ValueError("Bitte die Beschreibung (description) anpassen, sie ist noch der Platzhalter.")
    elif key == "mode":
        if value and value not in vibe_opencode.TESTED_PROFILE["agent_modes"]:
            raise ValueError("mode muss " + ", ".join(vibe_opencode.TESTED_PROFILE["agent_modes"]) + " sein.")
    elif key == "model":
        if value and not re.match(r"^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$", value):
            raise ValueError("Das Modell muss die Form 'anbieter/modell' ohne Leerzeichen haben.")
    elif key == "temperature":
        if value:
            try:
                number = float(value)
            except ValueError:
                raise ValueError("Temperatur muss eine Zahl zwischen 0 und 2 sein.")
            if not 0 <= number <= 2:
                raise ValueError("Temperatur muss zwischen 0 und 2 liegen.")
    elif key == "steps":
        if value:
            if not re.match(r"^\d+$", value) or int(value) < 1:
                raise ValueError("Max. Schritte muss eine ganze Zahl ab 1 sein.")
    return value

def _front_value(value):
    value = str(value).strip()
    if "\n" in value or "\r" in value or "\x00" in value:
        raise ValueError("Ein Feldwert darf keinen Zeilenumbruch enthalten.")
    # YAML-Indikatoren am Zeilenanfang würden den Wert als Sequenz, Mapping,
    # Alias, Anker, Tag, Block oder Direktive deuten. "..." beendet zudem ein
    # Dokument. Solche Werte werden als JSON-String zitiert.
    if value.startswith(tuple("-?:,[]{}#&*!|>'\"%@`")) or value == "..." \
            or ":" in value or "#" in value:
        return json.dumps(value, ensure_ascii=False)
    return value

def _apply_agent_fields(text, values, permission_lines=None):
    """Schreibt bekannte Felder in den Rohtext, ohne unbekannte zu verlieren."""
    m, fm, body, lines = _frontmatter_parts(text)
    sep = "\r\n" if "\r\n" in fm else "\n"
    def sections():
        return {section["key"]: section for section in _front_sections(lines)}
    def replace_inline(key, value):
        value = str(value).strip()
        section = sections().get(key)
        if not value:
            if section:
                del lines[section["start"]:section["end"]]
            return
        line = f"{key}: {_front_value(value)}"
        section = sections().get(key)
        if section:
            lines[section["start"]:section["end"]] = [line]
        else:
            lines.append(line)
    for key in AGENT_FIELDS:
        if key in values:
            replace_inline(key, values[key])
    if permission_lines is not None:
        # Inline-Formen beider Schlüssel werden nicht stillschweigend verändert.
        for key in ("permission", "permissions"):
            section = sections().get(key)
            if section and section["inline"]:
                raise ValueError(key + ": wird nur in Blockform unterstützt; Inline-Rechte werden nicht verändert.")
        block = ["permissions:"] + list(permission_lines)
        # Ein vorhandener v1- oder v2-Block wird durch den v2-Block ersetzt.
        target = sections().get("permissions") or sections().get("permission")
        if target:
            lines[target["start"]:target["end"]] = block
        else:
            lines.extend(block)
    new_body = body
    if "prompt" in values:
        prompt = str(values["prompt"]).strip("\n")
        if not prompt.strip():
            raise ValueError("Der Prompt darf nicht leer sein.")
        # Immer mit einem Zeilenumbruch an den Frontmatter-Block anschließen:
        # Dateien ohne Prompt enden direkt mit "---" und würden sonst zu
        # ungültigem Frontmatter ("---Neuer Prompt").
        new_body = sep + prompt + sep
    return text[:m.start(1)] + sep.join(lines) + text[m.end(1):m.end()] + new_body

def agent_render_fields(scope, text, values):
    """Wendet strukturierte Eingaben auf Rohtext an, ohne zu speichern."""
    if not isinstance(values, dict):
        raise ValueError("Felder müssen als Objekt übergeben werden.")
    clean = {}
    for key in AGENT_FIELDS:
        if key in values and values[key] is not None:
            clean[key] = _validate_agent_field(key, values[key])
    if "prompt" in values and values["prompt"] is not None:
        prompt = str(values["prompt"])
        if not prompt.strip():
            raise ValueError("Der Prompt darf nicht leer sein.")
        clean["prompt"] = prompt
    permission_lines = None
    subagent_policy = None
    permission = values.get("permission")
    if permission:
        if permission not in PERMS:
            raise ValueError("Unbekannte Rechte-Vorlage: " + str(permission))
        dirs = None if scope == "global" else write_dirs(scope)
        permission_lines = permission_block(permission, dirs).splitlines()
        # Subagenten-Policy der EINGABE vorab erfassen: Jede Vorlage enthält als
        # Standard "subagent * deny" und würde sonst die Freigabe der
        # Bestandsdatei stillschweigend zurücksetzen (B7).
        subagent_policy = agent_task_policy(text)
    new_text = _apply_agent_fields(text, clean, permission_lines)
    if permission_lines is not None and subagent_policy["mode"] != "none":
        # Rechte-Vorlage und Subagenten-Rechte sind unabhängige Dimensionen:
        # Nur die Nicht-subagent-Regeln kommen aus der Vorlage, die
        # Subagenten-Regeln geben die Policy der Eingabedatei wieder. Ohne
        # vorhandene Freigabe (mode "none") bleibt der Vorlagen-Standard
        # "subagent * deny" unangetastet, damit der Block weiterhin als reine
        # Vorlage erkennbar bleibt.
        new_text = _subagent_policy_to_v2(new_text, subagent_policy)
    agent_validate(new_text)
    return new_text

def _subagent_policy_to_v2(text, policy):
    """Ersetzt in einem v2-``permissions``-Block nur die ``subagent``-Regeln.

    Nach dem Anwenden einer Rechte-Vorlage liegt immer ein v2-Block vor; dessen
    ``subagent``-Regeln werden durch den Freigabestand aus ``policy`` ersetzt,
    sodass die Subagenten-Policy der Eingabedatei erhalten bleibt. Gibt es
    wider Erwarten keinen v2-Block, bleibt der Text unverändert.
    """
    m, fm, _body, lines = _frontmatter_parts(text)
    sep = "\r\n" if "\r\n" in fm else "\n"
    v2 = next(
        (section for section in _front_sections(lines) if section["key"] == "permissions"),
        None,
    )
    if v2 is None or v2["inline"]:
        return text
    rules = [rule for rule in (_v2_rules(lines) or []) if rule.get("action") != "subagent"]
    rules += _subagent_rules(policy["allowed"], allow_all=policy["mode"] == "all")
    lines[v2["start"]:v2["end"]] = ["permissions:"] + _rules_lines(rules)
    return text[:m.start(1)] + sep.join(lines) + text[m.end(1):]

def _subagent_policy(rules):
    """Wertet geordnete v2-``subagent``-Regeln aus; die letzte passende Regel gewinnt."""
    mode, allowed = "none", set()
    for rule in rules:
        resource = rule.get("resource")
        effect = (rule.get("effect") or "").lower()
        if resource == "*":
            mode = "all" if effect == "allow" else "none"
            allowed = set()
        elif effect == "allow":
            allowed.add(resource)
            if mode != "all":
                mode = "custom"
        else:
            allowed.discard(resource)
    if mode == "all":
        return {"mode": "all", "allowed": []}
    unique = sorted(allowed)
    return {"mode": "custom" if unique else "none", "allowed": unique}


def agent_task_policy(text):
    """Liest Subagenten-Rechte als Modus und erlaubte Namen.

    Bei einem v2-``permissions``-Block gelten die ``subagent``-Regeln (die
    letzte passende Regel gewinnt). Ohne v2-Block bleibt der bisherige
    v1-``permission.task``-Fallback wirksam. ``all`` bedeutet alles erlaubt,
    ``none`` gesperrt (auch der Standard ohne Eintrag) und ``custom`` nennt die
    ausdrücklich erlaubten Namen. Unbekannte Werte werden sicher gesperrt.
    """
    _m, _fm, _body, lines = _frontmatter_parts(text)
    v2 = next((section for section in _front_sections(lines) if section["key"] == "permissions"), None)
    if v2 is not None:
        rules = _v2_rules(lines) or []
        return _subagent_policy([rule for rule in rules if rule.get("action") == "subagent"])
    permission = next(
        (section for section in _front_sections(lines) if section["key"] == "permission"),
        None,
    )
    if not permission:
        return {"mode": "none", "allowed": []}
    block = lines[permission["start"]:permission["end"]]
    task_index, task_indent, task_inline = None, 0, ""
    for index, line in enumerate(block):
        match = re.match(r"^([ \t]+)task:[ \t]*(.*)$", line)
        if match:
            task_index = index
            task_indent = len(match.group(1))
            task_inline = match.group(2).strip()
            break
    if task_index is None:
        return {"mode": "none", "allowed": []}
    if task_inline:
        value = _unquote(task_inline).lower()
        if value == "allow":
            return {"mode": "all", "allowed": []}
        return {"mode": "none", "allowed": []}
    allowed, star = [], False
    for line in block[task_index + 1:]:
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip(" \t"))
        if indent <= task_indent:
            break
        match = re.match(r"^[ \t]+([^:]+):[ \t]*(.*)$", line)
        if not match:
            continue
        key = _unquote(match.group(1).strip())
        value = _unquote(match.group(2).strip()).lower()
        if key == "*":
            star = value == "allow"
            continue
        if value == "allow":
            allowed.append(key)
    if star:
        return {"mode": "all", "allowed": []}
    unique = sorted(set(allowed))
    return {"mode": "custom" if unique else "none", "allowed": unique}


def _global_agent_map():
    """Alle systemweiten Agenten mit Rohtext; projektlokale bleiben außen vor."""
    folder = agent_dir("global")
    if not os.path.isdir(folder):
        return {}
    agents = {}
    for filename in sorted(os.listdir(folder)):
        if not filename.endswith(".md"):
            continue
        name = filename[:-3]
        if not NAME_RE.match(name):
            continue
        try:
            with open(os.path.join(folder, filename), encoding="utf-8", errors="replace") as handle:
                text = handle.read()
            parsed = _parse_agent_text(text)
        except (OSError, ValueError):
            continue
        agents[name] = {
            "name": name,
            "scope": "global",
            "model": (parsed.get("model") or "").strip(),
            "mode": parsed.get("mode") or "",
            "description": (parsed.get("description") or "")[:110],
            "text": text,
        }
    return agents


def agent_validate_hierarchy(name, allowed, own_text=None, vibe_agent=None):
    """Prüft erlaubte Subagenten auf Existenz, Modus und Zyklen.

    F32 erlaubt den Selbstaufruf: Ein Agent darf Subagenten seines eigenen
    Typs aufrufen, wenn er selbst im Modus ``subagent`` oder ``all`` läuft und
    nicht der Vibe-Agent ist. ``own_text`` ist der gerade gespeicherte Entwurf
    und hat Vorrang vor der vorhandenen Datei. ``vibe_agent`` überschreibt die
    Auflösung über die Rolle (``""`` schaltet die Vibe-Prüfung ab).
    """
    if not NAME_RE.match(name or ""):
        raise ValueError("Name: nur a-z, 0-9, _ und -")
    if not isinstance(allowed, list) or any(
        not isinstance(agent, str) or not NAME_RE.match(agent) for agent in allowed
    ):
        raise ValueError("Erlaubte Subagenten müssen eine Liste gültiger Agentennamen sein.")
    if vibe_agent is None:
        vibe_agent = vibe_agent_name()
    elif not isinstance(vibe_agent, str):
        raise ValueError("Vibe-Agent muss ein Name oder eine leere Zeichenkette sein.")
    global_agents = _global_agent_map()
    for target in allowed:
        if target == name:
            # F32: Der Selbstaufruf ist zulässig, aber die Vibe-Rolle und der
            # eigene Modus bleiben verbindlich (Vibe-Prüfung zuerst).
            if name == vibe_agent:
                raise ValueError(
                    "Der Vibe-Agent darf keine Subagenten seines eigenen Typs aufrufen."
                )
            if own_text is not None:
                own_mode = (_parse_agent_text(own_text).get("mode") or "").strip()
            else:
                own_info = global_agents.get(name)
                if not own_info:
                    raise ValueError("Unbekannter oder nicht systemweiter Subagent: " + name)
                own_mode = own_info["mode"]
            if own_mode not in ("subagent", "all", ""):
                raise ValueError(
                    "Agent '" + name + "' ist kein Subagent (mode " + own_mode
                    + ") und darf nicht aufgerufen werden."
                )
            continue
        info = global_agents.get(target)
        if not info:
            raise ValueError("Unbekannter oder nicht systemweiter Subagent: " + target)
        mode = info["mode"] or "all"
        if mode not in ("subagent", "all"):
            raise ValueError(
                "Agent '" + target + "' ist kein Subagent (mode " + mode + ") und darf nicht aufgerufen werden."
            )
    graph = {
        agent: {t for t in agent_task_policy(info["text"])["allowed"] if t != agent}
        for agent, info in global_agents.items()
    }

    def reachable(start, goal, seen):
        if start == goal:
            return True
        if start in seen or start not in graph:
            return False
        seen.add(start)
        return any(reachable(nxt, goal, seen) for nxt in graph[start])

    for target in allowed:
        if target == name:
            continue  # F32: eine Selbstkante ist kein Zyklus
        if reachable(target, name, set()):
            raise ValueError(
                "Zyklus in der Agentenhierarchie: '" + name + "' ruft '" + target + "' auf, der wiederum zurückruft."
            )
    return sorted(set(allowed))


def _subagent_rules(allowed, allow_all=False):
    """Geordnete v2-``subagent``-Regeln für den gewünschten Freigabestand."""
    if allow_all:
        return [("subagent", "*", "allow")]
    names = sorted(set(allowed))
    if not names:
        return [("subagent", "*", "deny")]
    return [("subagent", "*", "deny")] + [("subagent", name, "allow") for name in names]


def agent_render_task(scope, text, allowed, allow_all=False):
    """Schreibt Subagenten-Rechte (v2, sonst v1-Fallback) und erhält alles andere."""
    if not allow_all:
        if not isinstance(allowed, list) or any(
            not isinstance(agent, str) or not NAME_RE.match(agent)
            for agent in allowed
        ):
            raise ValueError("Erlaubte Subagenten müssen eine Liste gültiger Agentennamen sein.")
    m, fm, _body, lines = _frontmatter_parts(text)
    sep = "\r\n" if "\r\n" in fm else "\n"
    sections = _front_sections(lines)
    v2 = next((section for section in sections if section["key"] == "permissions"), None)
    if v2 is not None:
        if v2["inline"]:
            raise ValueError("permissions: wird nur in Blockform unterstützt; Inline-Rechte werden nicht verändert.")
        rules = [rule for rule in (_v2_rules(lines) or []) if rule.get("action") != "subagent"]
        rules += _subagent_rules(allowed, allow_all)
        lines[v2["start"]:v2["end"]] = ["permissions:"] + _rules_lines(rules)
        return text[:m.start(1)] + sep.join(lines) + text[m.end(1):]
    permission = next((section for section in sections if section["key"] == "permission"), None)
    if permission is None:
        # Kein Rechteblock vorhanden: komplett als v2 anlegen.
        lines.extend(["permissions:"] + _rules_lines(_subagent_rules(allowed, allow_all)))
        return text[:m.start(1)] + sep.join(lines) + text[m.end(1):]
    if permission["inline"]:
        raise ValueError("permission: wird nur in Blockform unterstützt; Inline-Rechte werden nicht verändert.")
    # v1-Block: Passt er zu einer Vorlage, wird komplett auf v2 migriert;
    # ein individueller Block behält die v1-task-Syntax (Verhalten erhalten).
    raw_permission = "\n".join(lines[permission["start"]:permission["end"]])
    preset = None
    for key in V1_PERMS:
        if _same_block(raw_permission, "permission:\n" + V1_PERMS[key]):
            preset = key
            break
    if preset is not None:
        try:
            dirs = None if scope == "global" else write_dirs(scope)
        except ValueError:
            dirs = None
        rules = [rule for rule in _permission_rules(preset, dirs) if rule[0] != "subagent"]
        rules += _subagent_rules(allowed, allow_all)
        lines[permission["start"]:permission["end"]] = ["permissions:"] + _rules_lines(rules)
        return text[:m.start(1)] + sep.join(lines) + text[m.end(1):]
    if allow_all:
        task_lines = ["  task: allow"]
    else:
        names = sorted(set(allowed))
        if not names:
            task_lines = ["  task: deny"]
        else:
            task_lines = ["  task:", '    "*": deny']
            task_lines += ["    " + agent + ": allow" for agent in names]
    start, end = permission["start"], permission["end"]
    task_index = None
    for index in range(start + 1, end):
        if re.match(r"^[ \t]+task:", lines[index]):
            task_index = index
            break
    if task_index is None:
        lines[end:end] = task_lines
    else:
        indent = len(lines[task_index]) - len(lines[task_index].lstrip(" \t"))
        task_end = task_index + 1
        while task_end < end:
            if not lines[task_end].strip():
                task_end += 1
                continue
            if len(lines[task_end]) - len(lines[task_end].lstrip(" \t")) <= indent:
                break
            task_end += 1
        while task_end > task_index + 1 and not lines[task_end - 1].strip():
            task_end -= 1
        lines[task_index:task_end] = task_lines
    return text[:m.start(1)] + sep.join(lines) + text[m.end(1):]


def agent_prompt_scaffold(aufgabe, ergebnis, grenzen=""):
    """Gerüst, das die Aufgabe in den Mittelpunkt stellt und sie abkapselt."""
    aufgabe = str(aufgabe or "").strip()
    ergebnis = str(ergebnis or "").strip()
    if not aufgabe or not ergebnis:
        raise ValueError("Aufgabe und Ergebnis müssen beschrieben sein.")
    limits = str(grenzen or "").strip() or (
        "Der Agent entscheidet Ausführung und Detailtiefe selbst, aber nur "
        "innerhalb seines eigenen Bereichs."
    )
    return (
        "## Aufgabe\n" + aufgabe + "\n\n"
        "## Ergebnis\n" + ergebnis + "\n\n"
        "## Grenzen\n" + limits + "\n\n"
        "Die Aufgabe ist abzukapseln: Der Agent bearbeitet ausschließlich "
        "seinen eigenen Bereich und trifft keine Entscheidungen außerhalb davon.\n"
    )


def agent_version(refresh=False):
    """Erkennt die opencode-Version einmal je Prozess."""
    global _AGENT_VERSION
    if refresh or _AGENT_VERSION is None:
        _AGENT_VERSION = vibe_opencode.probe()
    return _AGENT_VERSION

def agent_version_warning():
    """Hinweis, wenn die installierte opencode-Version nicht exakt geprüft ist.

    Die Agentenregeln und das Verzeichnis ``.opencode/agents`` gelten
    unabhängig von der erkannten Version (V-007). Ein harter Riegel würde die
    Agentenverwaltung nach jedem opencode-Update ohne fachlichen Grund sperren;
    deshalb wird der Unterschied nur gemeldet (F26). Auch eine über ein
    Fallback-Profil behandelte Version (assumed) bleibt eine ungeprüfte
    Version und wird gemeldet.
    """
    info = agent_version()
    if info.checked: return ""
    return (info.message + " Die Agentenregeln gelten unverändert; "
            "der Schreibvorgang wird nicht gesperrt.")

def _agent_overlay(rows):
    """Konflikte und wirksame Priorität je Agentenname.

    Geprüfte opencode-Priorität (2.1.4): Ein Projektagent überschreibt einen
    gleichnamigen globalen Agenten. Der globale Agent bleibt in allen anderen
    Projekten wirksam. Gleichnamige Projektagenten verschiedener Projekte
    überschneiden sich nicht und sind deshalb kein Konflikt.
    """
    scopes = {}
    for row in rows:
        scopes.setdefault(row["name"], []).append(row["scope"])
    result = {}
    for name, entries in scopes.items():
        project_scopes = sorted(scope for scope in entries if scope != "global")
        has_global = "global" in entries
        result[name] = {
            "global": has_global,
            "projects": project_scopes,
            "conflict": has_global and bool(project_scopes),
            "overrides": "global" if has_global and project_scopes else "",
            "overridden_in": project_scopes if has_global else [],
        }
    return result

def agents_all():
    out, scopes = [], ["global"] + projects()
    roles = profiles_load().get("rollen", {})
    meta = agent_meta_load().get("agents", {})
    for scope in scopes:
        try: d = agent_dir(scope)
        except SystemExit: continue
        if not os.path.isdir(d): continue
        for f in sorted(os.listdir(d)):
            if not f.endswith(".md"): continue
            n = f[:-3]
            with open(os.path.join(d, f), encoding="utf-8", errors="replace") as fh:
                text = fh.read()
            try:
                parsed = _parse_agent_text(text)
                agent_validate(text)
                valid = True
            except ValueError:
                try: parsed = _parse_agent_text(text)
                except ValueError: parsed = {}
                valid = False
            raw_model = (parsed.get("model") or "").strip()
            policy = agent_task_policy(text)
            out.append({"name": n, "scope": scope, "model": raw_model or "-", "mode": parsed.get("mode") or "all",
                        "description": (parsed.get("description") or "")[:110], "valid": valid,
                        "role": roles.get(n, "") if scope == "global" else "",
                        "result": meta.get(n, {}).get("result", "") if scope == "global" else "",
                        "is_vibe": scope == "global" and roles.get(n) == "vibe",
                        "model_missing": not raw_model,
                        "allowed_agents": policy["allowed"] if scope == "global" else [],
                        "task_mode": policy["mode"] if scope == "global" else "none"})
    overlay = _agent_overlay(out)
    for row in out:
        info = overlay[row["name"]]
        row["conflict"] = info["conflict"]
        row["shadow"] = info["conflict"]
        row["overrides"] = info["overrides"]
        row["overridden_in"] = list(info["overridden_in"])
        if row["scope"] == "global":
            row["priority"] = ("wird überschrieben in: " + ", ".join(info["overridden_in"])) if info["overridden_in"] else "gilt global"
        else:
            row["priority"] = "überschreibt global" if info["global"] else "gilt nur in " + row["scope"]
    return out

# ---------- Agentenauswahl je Projekt (F17/AP03) ----------
# Projekte verwenden ausschließlich systemweite Agenten. Gespeichert wird in
# Version 2 die ausdrückliche Liste der aktiven Agenten (``aktiv``) sowie
# optionale Modellüberschreibungen (``modelle``). Ohne Datei ist nur der
# Vibe-Agent aktiv. Version 1 (``deaktiviert``) wird beim Lesen migriert.
PROJECT_AGENTS_VERSION = 3
PROJECT_AGENTS_KEYS = ("version", "aktiv", "modelle", "opencode")
PROJECT_AGENT_MODEL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$")
# opencode-eigene Subagenten (AP2-Korbat): keine Dateiagenten, werden allein
# über die opencode-Subagenten-Mechanik gesteuert (disabled/model je Projekt).
OPENCODE_AGENTS = ("general", "explore")
OPENCODE_AGENT_DESCRIPTIONS = {
    "general": "Allzweck-Subagent für Recherche, Code-Suche und mehrstufige Aufgaben.",
    "explore": "Schneller Subagent, der Codebestände gezielt durchsucht (Dateien, Muster, Begriffe).",
}


def project_agents_path(name):
    """Ablage der projektspezifischen Agentenauswahl."""
    return os.path.join(ppath(name), ".vibe", "agents.json")


def _project_agents_check(data):
    """Prüft und normalisiert die Projektkonfiguration ohne sie zu schreiben."""
    if not isinstance(data, dict):
        raise ValueError("Die Agentenauswahl muss ein JSON-Objekt sein.")
    unknown = sorted(set(data) - set(PROJECT_AGENTS_KEYS))
    if unknown:
        raise ValueError("Unbekannte Felder in der Agentenauswahl: " + ", ".join(unknown))
    version = data.get("version", PROJECT_AGENTS_VERSION)
    if version != PROJECT_AGENTS_VERSION:
        raise ValueError(f"Unbekannte Version der Agentenauswahl: {version!r}")
    active = data.get("aktiv", [])
    if not isinstance(active, list) or any(not isinstance(item, str) for item in active):
        raise ValueError("'aktiv' muss eine Liste von Agentennamen sein.")
    for item in active:
        if not NAME_RE.match(item):
            raise ValueError("Ungültiger Agentenname in 'aktiv': " + repr(item))
        if item in OPENCODE_AGENTS:
            raise ValueError("Der opencode-Agent '" + item + "' ist kein Startagent und darf nicht in 'aktiv' stehen.")
    models = data.get("modelle", {})
    if not isinstance(models, dict):
        raise ValueError("'modelle' muss ein Objekt mit Agentenname und Modell sein.")
    clean_models = {}
    for agent, model in models.items():
        if not isinstance(agent, str) or not NAME_RE.match(agent):
            raise ValueError("Ungültiger Agentenname in 'modelle': " + repr(agent))
        if not isinstance(model, str):
            raise ValueError("Das Modell muss eine Zeichenkette sein.")
        value = model.strip()
        if value:
            if not PROJECT_AGENT_MODEL_RE.match(value):
                raise ValueError("Das Modell muss die Form 'anbieter/modell' ohne Leerzeichen haben.")
            clean_models[agent] = value
    opencode = data.get("opencode", {})
    if not isinstance(opencode, dict):
        raise ValueError("'opencode' muss ein Objekt mit den Agenten general/explore sein.")
    opencode_unknown = sorted(set(opencode) - set(OPENCODE_AGENTS))
    if opencode_unknown:
        raise ValueError("Unbekannte opencode-Agenten: " + ", ".join(opencode_unknown))
    clean_opencode = {}
    for name in OPENCODE_AGENTS:
        entry = opencode.get(name, {"aktiv": True, "modell": ""})
        if not isinstance(entry, dict):
            raise ValueError("Der opencode-Eintrag '" + name + "' muss ein Objekt sein.")
        entry_unknown = sorted(set(entry) - {"aktiv", "modell"})
        if entry_unknown:
            raise ValueError("Unbekannte Felder beim opencode-Agenten '" + name + "': " + ", ".join(entry_unknown))
        aktiv = entry.get("aktiv", True)
        if not isinstance(aktiv, bool):
            raise ValueError("'aktiv' des opencode-Agenten '" + name + "' muss ein JSON-Bool sein.")
        modell = entry.get("modell", "")
        if not isinstance(modell, str):
            raise ValueError("Das Modell muss eine Zeichenkette sein.")
        value = modell.strip()
        if value:
            if not PROJECT_AGENT_MODEL_RE.match(value):
                raise ValueError("Das Modell muss die Form 'anbieter/modell' ohne Leerzeichen haben.")
            clean_opencode[name] = {"aktiv": aktiv, "modell": value}
        else:
            clean_opencode[name] = {"aktiv": aktiv, "modell": ""}
    return {"version": PROJECT_AGENTS_VERSION,
            "aktiv": sorted(set(active)),
            "modelle": dict(sorted(clean_models.items())),
            "opencode": clean_opencode}


def _default_opencode():
    return {name: {"aktiv": True, "modell": ""} for name in OPENCODE_AGENTS}


def _project_agents_default():
    vibe = vibe_agent_name()
    return {"version": PROJECT_AGENTS_VERSION,
            "aktiv": [vibe] if vibe else [],
            "modelle": {},
            "opencode": _default_opencode()}


def _project_agents_read(snapshot):
    """Liest die Agentenauswahl aus einem Snapshot; fehlend heißt Standardzustand."""
    if not snapshot.exists:
        return _project_agents_default()
    try:
        data = json.loads(snapshot.text)
    except (TypeError, ValueError):
        raise ValueError("Die Agentenauswahl ist kein gültiges JSON: " + snapshot.path)
    if not isinstance(data, dict):
        raise ValueError("Die Agentenauswahl muss ein JSON-Objekt sein.")
    version = data.get("version", 1)
    if version == 1:
        unknown = sorted(set(data) - {"version", "deaktiviert", "modelle"})
        if unknown:
            raise ValueError("Unbekannte Felder in der Agentenauswahl: " + ", ".join(unknown))
        disabled = data.get("deaktiviert", [])
        if not isinstance(disabled, list) or any(not isinstance(item, str) for item in disabled):
            raise ValueError("'deaktiviert' muss eine Liste von Agentennamen sein.")
        names = set(_global_agent_map())
        active = names - set(disabled)
        vibe = vibe_agent_name()
        if vibe:
            active.add(vibe)
        data = {"version": PROJECT_AGENTS_VERSION, "aktiv": sorted(active),
                "modelle": data.get("modelle", {})}
    elif version == 2:
        data = dict(data)
        data["version"] = PROJECT_AGENTS_VERSION
        data.setdefault("opencode", _default_opencode())
    return _project_agents_check(data)


def project_agents_load(name, snapshot=None):
    """Liefert (Konfiguration, Snapshot); eine fehlende Datei bleibt unverändert."""
    snapshot = snapshot or vibe_storage.read_snapshot(project_agents_path(name))
    return _project_agents_read(snapshot), snapshot


def project_agents_save(name, data, expected=None):
    """Schreibt die Agentenauswahl atomar und prüft eine erwartete Prüfsumme."""
    config = _project_agents_check(data)
    text = json.dumps(config, indent=1, ensure_ascii=False, sort_keys=True) + "\n"
    vibe_storage.write_text(project_agents_path(name), text, expected=expected)
    return config


def project_agent_inventory(name):
    """Verfügbare Agenten eines Projekts: ausschließlich systemweite Agenten."""
    return {
        agent: {key: value for key, value in info.items() if key != "text"}
        for agent, info in _global_agent_map().items()
    }


def project_agent_rows(name):
    """Agenten eines Projekts mit Auswahl, Überschreibung und wirksamem Modell."""
    global_agents = _global_agent_map()
    inventory = {agent: {key: value for key, value in info.items() if key != "text"}
                 for agent, info in global_agents.items()}
    config, _snapshot = project_agents_load(name)
    active = set(config["aktiv"])
    overrides = config["modelle"]
    roles = profiles_load().get("rollen", {})
    meta = agent_meta_load().get("agents", {})
    rows = []
    for agent in sorted(inventory):
        row = dict(inventory[agent])
        is_vibe = roles.get(agent) == "vibe"
        configured = agent in active or is_vibe
        base = row["model"] or "-"
        override = overrides.get(agent, "")
        policy = agent_task_policy(global_agents[agent]["text"])
        row.update(configured=configured, selected=configured, is_vibe=is_vibe,
                   model=base, override=override,
                   effective_model=override or base,
                   result=meta.get(agent, {}).get("result", ""),
                   role=roles.get(agent, ""),
                   allowed_agents=policy["allowed"] if policy["mode"] == "custom" else [],
                   task_mode=policy["mode"])
        rows.append(row)
    # opencode-eigene Subagenten general/explore: keine Dateiagenten, werden
    # allein über die Projektkonfiguration (aktiv/modell) gesteuert.
    opencode = config.get("opencode", {})
    for agent in OPENCODE_AGENTS:
        entry = opencode.get(agent, {"aktiv": True, "modell": ""})
        aktiv = entry.get("aktiv", True)
        modell = entry.get("modell", "")
        rows.append({
            "name": agent,
            "scope": "opencode",
            "opencode": True,
            "model": "",
            "mode": "subagent",
            "description": OPENCODE_AGENT_DESCRIPTIONS.get(agent, ""),
            "configured": aktiv,
            "selected": aktiv,
            "is_vibe": False,
            "override": modell,
            "effective_model": modell,
            "result": "",
            "role": "",
            "allowed_agents": [],
            "task_mode": "none",
        })
    return rows


def project_agent_set(name, agent, selected=None, model=None):
    """Ändert Auswahl oder Modellüberschreibung genau eines Agenten.

    Es wird ausschließlich die Projektdatei geschrieben; Agentendateien und
    andere Projekte bleiben unverändert. Der Vibe-Agent bleibt immer aktiv.
    Für ``general``/``explore`` wird nur der opencode-Abschnitt geschrieben.
    """
    if not NAME_RE.match(agent or ""):
        raise ValueError("Agentenname: nur a-z, 0-9, _ und -")
    if selected is not None and not isinstance(selected, bool):
        raise ValueError("'selected' muss wahr oder falsch sein.")
    if agent in OPENCODE_AGENTS:
        return _opencode_agent_set(name, agent, selected, model)
    inventory = project_agent_inventory(name)
    if agent not in inventory:
        raise ValueError(f"Agent '{agent}' ist für dieses Projekt nicht verfügbar.")
    config, snapshot = project_agents_load(name)
    active = set(config["aktiv"])
    vibe = vibe_agent_name()
    if vibe:
        active.add(vibe)
    models = dict(config["modelle"])
    if selected is not None:
        if selected:
            active.add(agent)
        else:
            if agent == vibe:
                raise ValueError("Der Vibe-Agent kann nicht abgewählt werden.")
            active.discard(agent)
    if model is not None:
        if not isinstance(model, str):
            raise ValueError("Das Modell muss eine Zeichenkette sein.")
        value = model.strip()
        if value:
            if not PROJECT_AGENT_MODEL_RE.match(value):
                raise ValueError("Das Modell muss die Form 'anbieter/modell' ohne Leerzeichen haben.")
            models[agent] = value
        else:
            models.pop(agent, None)
    if active == set(config["aktiv"]) and models == config["modelle"]:
        return config
    return project_agents_save(name, {"version": PROJECT_AGENTS_VERSION,
                                      "aktiv": sorted(active), "modelle": models,
                                      "opencode": config.get("opencode", {})},
                               expected=snapshot.digest if snapshot.exists else vibe_storage.MISSING)


def _opencode_agent_set(name, agent, selected, model):
    """Schreibt nur den opencode-Abschnitt für general/explore."""
    config, snapshot = project_agents_load(name)
    opencode = {key: dict(value) for key, value in config.get("opencode", {}).items()}
    entry = opencode.setdefault(agent, {"aktiv": True, "modell": ""})
    changed = False
    if selected is not None and entry.get("aktiv", True) != selected:
        entry["aktiv"] = selected
        changed = True
    if model is not None:
        if not isinstance(model, str):
            raise ValueError("Das Modell muss eine Zeichenkette sein.")
        value = model.strip()
        if value:
            if not PROJECT_AGENT_MODEL_RE.match(value):
                raise ValueError("Das Modell muss die Form 'anbieter/modell' ohne Leerzeichen haben.")
            if entry.get("modell", "") != value:
                entry["modell"] = value
                changed = True
        elif entry.get("modell", ""):
            entry["modell"] = ""
            changed = True
    if not changed:
        return config
    new_config = dict(config)
    new_config["opencode"] = opencode
    return project_agents_save(name, new_config,
                               expected=snapshot.digest if snapshot.exists else vibe_storage.MISSING)


def run_agent_selection(name, agent):
    """Prüft die Projektauswahl und liefert die Modellüberschreibung (oder '').

    Erst mit einem definierten Vibe-Agenten gilt die Projektauswahl. Solange
    keiner eingerichtet ist, bleibt ein ausdrücklich gewählter systemweiter
    Agent lauffähig; so starten bestehende Installationen vor der
    Rollenzuweisung weiterhin.
    """
    config, _snapshot = project_agents_load(name)
    active = set(config["aktiv"])
    vibe = vibe_agent_name()
    if vibe:
        active.add(vibe)
        if agent not in active:
            raise ValueError(f"Agent '{agent}' ist für dieses Projekt nicht ausgewählt oder nicht konfiguriert.")
    return config["modelle"].get(agent, "")


def repair_project_agent(name, agent):
    """Setzt AGENT in .vibe/project.env ohne Anführungszeichen und erhält alle anderen Zeilen.

    Der Startagent wird bewusst unquoted geschrieben, damit die von Hand
    gepflegte Projektdatei ihr bisheriges Format behält. Die Prüfsumme
    verhindert, dass eine gleichzeitige Änderung still überschrieben wird.
    """
    if not NAME_RE.match(agent or ""):
        raise ValueError("Ungültiger Agentenname für den Start: " + repr(agent))
    fp = os.path.join(ppath(name), ".vibe", "project.env")
    snapshot = vibe_storage.read_snapshot(fp)
    if not snapshot.exists:
        raise ValueError("Nicht für vibe vorbereitet: " + fp)
    text = snapshot.text
    newline = "\r\n" if "\r\n" in text else "\n"
    pattern = re.compile(r"^(\s*)AGENT[ \t]*=[^\r\n]*(\r\n|\n|\r|$)", re.M)
    if pattern.search(text):
        updated = pattern.sub(
            lambda hit: hit.group(1) + "AGENT=" + agent + hit.group(2),
            text,
            count=1,
        )
    else:
        if text and not text.endswith(("\n", "\r")):
            text += newline
        updated = text + "AGENT=" + agent + newline
    if updated == snapshot.text:
        return
    vibe_storage.write_text(fp, updated, expected=snapshot.digest)


def effective_agent(name, scope="global"):
    """Bereich, dessen Datei für einen Agentennamen tatsächlich gilt."""
    if not NAME_RE.match(name or ""): raise ValueError("Name: nur a-z, 0-9, _ und -")
    if scope != "global" and os.path.exists(agent_path(scope, name)):
        return scope
    if os.path.exists(agent_path("global", name)):
        return "global"
    raise ValueError("Agent nicht gefunden: " + name)

def agent_path(scope, name):
    if not NAME_RE.match(name or ""): raise ValueError("Name: nur a-z, 0-9, _ und -")
    return os.path.join(agent_dir(scope), name + ".md")

def agent_read(scope, name):
    p = agent_path(scope, name)
    if not os.path.exists(p): raise ValueError("Agent nicht gefunden: " + name)
    with open(p, encoding="utf-8") as fh:
        return fh.read()

def agent_validate(text):
    parsed = _parse_agent_text(text)
    for key in AGENT_FIELDS:
        value = parsed.get(key, "")
        if value:
            _validate_agent_field(key, value)
    if not parsed.get("description"):
        raise ValueError("Im Frontmatter fehlt 'description' (Pflichtfeld in opencode).")
    fm = {key: parsed[key] for key in AGENT_FIELDS if parsed.get(key)}
    vibe_opencode.validate_agent(fm, parsed["prompt"])
    return fm

def agent_backup_dir(scope):
    return os.path.join(BACKUPS, safe(scope))

def agent_backups(scope, name):
    """Vorhandene Sicherungen eines Agenten, älteste zuerst."""
    if not NAME_RE.match(name or ""): raise ValueError("Name: nur a-z, 0-9, _ und -")
    # list_backups() arbeitet mit Präfixen. "tester-2-..." beginnt ebenfalls
    # mit "tester-" und wäre sonst eine Sicherung des Agenten "tester".
    # Deshalb wird der vollständige Sicherungsname geprüft.
    pattern = re.compile(r"^" + re.escape(name)
                         + r"-\d{8}-\d{6}-\d{6}-[0-9a-f]{4}(?:-\d+)?\.md$")
    return [item for item in vibe_storage.list_backups(agent_backup_dir(scope), label=name)
            if pattern.match(item)]

def agent_backup(scope, name):
    """Sichert die unveränderte Agentendatei im Bereichssicherungsordner.

    Unbekannte Agenten und unsichere Namen werfen ``ValueError``; keine
    Sicherung wird angelegt. Die Agentendatei selbst bleibt byte-identisch.
    """
    p = agent_path(scope, name)
    if not vibe_storage.read_snapshot(p).exists:
        raise ValueError("Agent nicht gefunden: " + str(name))
    return vibe_storage.backup_file(p, agent_backup_dir(scope), label=name)

def agent_restore(scope, name, backup=None):
    """Stellt eine Sicherung wieder her; ohne Angabe die neueste."""
    items = agent_backups(scope, name)
    if not items:
        raise ValueError(f"Keine Sicherung für Agent '{name}' in {agent_backup_dir(scope)}")
    chosen = backup or items[-1]
    if chosen not in items:
        raise ValueError("Sicherung gehört nicht zu diesem Agenten: " + chosen)
    p = agent_path(scope, name)
    current = vibe_storage.read_snapshot(p)
    expected = current.digest if current.exists else vibe_storage.MISSING
    return vibe_storage.restore_backup(agent_backup_dir(scope), chosen, p,
                                      expected=expected, label=name)

def agent_snapshot(scope, name):
    """Inhalt und Prüfsumme eines Agenten für konfliktfreies Speichern."""
    p = agent_path(scope, name)
    snapshot = vibe_storage.read_snapshot(p)
    if not snapshot.exists: raise ValueError("Agent nicht gefunden: " + name)
    return snapshot

def agent_write(scope, name, text, create=False, expected=None):
    fm = agent_validate(text); p = agent_path(scope, name)
    snapshot = vibe_storage.read_snapshot(p)
    if create and snapshot.exists: raise ValueError(f"Agent '{name}' existiert in diesem Bereich schon.")
    if expected is not None:
        vibe_storage.check_expected(p, snapshot, expected)
    content = text if text.endswith("\n") else text + "\n"
    vibe_storage.write_text_with_backup(
        p, content, agent_backup_dir(scope), label=name,
        expected=snapshot.digest if snapshot.exists else vibe_storage.MISSING)
    warn = []
    version_warning = agent_version_warning()
    if version_warning: warn.append(version_warning)
    ml = models_list()
    if fm.get("model") and ml and fm["model"] not in ml: warn.append(f"Modell '{fm['model']}' steht nicht in 'opencode models' (Anbieter verbunden?).")
    notes = vibe_storage.filesystem_notes(p)
    if notes["warning"]: warn.append(notes["warning"])
    return warn

def agent_delete(scope, name):
    p = agent_path(scope, name)
    # Sicherung und Löschen unter derselben Sperre: kein Speichervorgang kann
    # dazwischen den neuesten Stand schreiben, der dann nicht gesichert wäre.
    with vibe_storage.locked(p):
        snapshot = vibe_storage.read_snapshot(p)
        if not snapshot.exists: raise ValueError("Agent nicht gefunden: " + name)
        vibe_storage.backup_bytes(p, snapshot.data, agent_backup_dir(scope), label=name)
        os.remove(p)

def agent_copy(scope, name, to_scope):
    if scope == to_scope: raise ValueError("Quelle und Ziel sind gleich.")
    text = agent_read(scope, name)
    if to_scope != "global" and _edit_grants_write(text):
        text = _rewrite_edit_block(text, write_dirs(to_scope))
    return agent_write(to_scope, name, text, create=True, expected=vibe_storage.MISSING)

def agent_template(description, mode="subagent", model="", temperature="", steps="", perm="lesen", prompt="", write_dirs=None):
    if perm not in PERMS: perm = "lesen"
    # Ein Entwurf darf den Platzhalter "Beschreibung fehlt" enthalten; erst
    # agent_write/agent_validate verlangt eine echte Beschreibung. Geprüft wird
    # hier nur, was das Frontmatter zerstören würde (Zeilenumbrüche, YAML-Sonderzeichen).
    description = str(description or "").strip()
    description = description or "Beschreibung fehlt"
    mode = _validate_agent_field("mode", mode or "subagent")
    model = _validate_agent_field("model", model) if str(model or "").strip() else ""
    temperature = _validate_agent_field("temperature", temperature) if str(temperature or "").strip() else ""
    steps = _validate_agent_field("steps", steps) if str(steps or "").strip() else ""
    lines = ["---", f"description: {_front_value(description)}", f"mode: {mode}"]
    if model: lines.append(f"model: {model}")
    if temperature: lines.append(f"temperature: {temperature}")
    if steps: lines.append(f"steps: {steps}")
    lines += ["permissions:", permission_block(perm, write_dirs), "---", "", prompt.strip() or "You are a helpful agent. Describe the task, rules and output format here."]
    return "\n".join(lines) + "\n"

def _rewrite_edit_block(text, write_dirs):
    """Ersetzt im Frontmatter nur die edit-Regeln und erhält alle anderen Zeilen."""
    m, fm, _body, lines = _frontmatter_parts(text)
    sep = "\r\n" if "\r\n" in fm else "\n"
    v2 = next((section for section in _front_sections(lines) if section["key"] == "permissions"), None)
    if v2 is not None:
        if v2["inline"]:
            raise ValueError("permissions: wird nur in Blockform unterstützt; Inline-Rechte werden nicht verändert.")
        rules = [rule for rule in (_v2_rules(lines) or []) if rule.get("action") != "edit"]
        rules += _edit_rules(write_dirs)
        lines[v2["start"]:v2["end"]] = ["permissions:"] + _rules_lines(rules)
        return text[:m.start(1)] + sep.join(lines) + text[m.end(1):]
    for line in lines:
        inline = re.match(r"^permission:[ \t]*(.*)$", line)
        if inline and inline.group(1).strip():
            raise ValueError("permission: wird nur in Blockform unterstützt; Inline-Rechte werden nicht verändert.")
    p_idx = next((i for i, l in enumerate(lines) if re.match(r"^permission:\s*$", l)), None)
    if p_idx is None:
        # Ohne jeden Rechteblock wird ein neuer v2-Block angelegt (Neuerzeugung ist v2).
        new_fm = sep.join(lines + ["permissions:"] + _rules_lines(_edit_rules(write_dirs)))
        return text[:m.start(1)] + new_fm + text[m.end(1):]
    block = _v1_edit_lines(write_dirs)
    p_end = p_idx + 1
    while p_end < len(lines) and (lines[p_end].startswith((" ", "\t")) or not lines[p_end].strip()): p_end += 1
    while p_end > p_idx + 1 and not lines[p_end - 1].strip(): p_end -= 1
    e_idx = next((i for i in range(p_idx + 1, p_end) if re.match(r"^  edit:.*$", lines[i])), None)
    if e_idx is None:
        lines[p_idx + 1:p_idx + 1] = block
    else:
        e_end = e_idx + 1
        while e_end < p_end and (lines[e_end].startswith(("   ", "\t")) or not lines[e_end].strip()): e_end += 1
        while e_end > e_idx + 1 and not lines[e_end - 1].strip(): e_end -= 1
        lines[e_idx:e_end] = block
    return text[:m.start(1)] + sep.join(lines) + text[m.end(1):]

def _edit_grants_write(text):
    """True, wenn das Frontmatter Schreiben erlaubt (keine edit-Regel = Standard allow)."""
    try:
        _m, _fm, _body, lines = _frontmatter_parts(text)
    except ValueError:
        return False
    v2 = next((section for section in _front_sections(lines) if section["key"] == "permissions"), None)
    if v2 is not None and not v2["inline"]:
        edit = [rule for rule in (_v2_rules(lines) or []) if rule.get("action") == "edit"]
        if not edit:
            return True
        return any(rule.get("effect") == "allow" for rule in edit)
    for i, line in enumerate(lines):
        inline = re.match(r"^permission:[ \t]*(.*)$", line)
        if inline and inline.group(1).strip():
            value = re.search(r"\bedit\s*:\s*[\"']?([A-Za-z]+)", inline.group(1))
            return value is None or value.group(1) != "deny"
        hit = re.match(r"^  edit:[ \t]*(.*)$", line)
        if not hit: continue
        value = hit.group(1).strip()
        if value: return value != "deny"
        for follow in lines[i + 1:]:
            if follow and not follow.startswith((" ", "\t")): break
            if re.match(r"^ {0,2}\S", follow): break
            sub = re.match(r'^ {4}"?[^"]*"?[ \t]*:[ \t]*(\S+)\s*$', follow)
            if sub and sub.group(1) != "deny": return True
        return False
    return True

def _planned_write_dirs(scope, name, write_dirs):
    """(Pfad, Snapshot, neu) für einen Agenten mit Schreibrecht; sonst None."""
    p = agent_path(scope, name)
    snapshot = vibe_storage.read_snapshot(p)
    if not snapshot.exists: raise ValueError("Agent nicht gefunden: " + name)
    old = snapshot.text
    if not _edit_grants_write(old): return None
    new = _rewrite_edit_block(old, write_dirs)
    agent_validate(new)
    if not new.endswith("\n"): new += "\n"
    return p, snapshot, new

def apply_write_dirs(scope, name, write_dirs):
    """Schreibt die erlaubten Verzeichnisse in den edit-Block eines Agenten mit Schreibrecht."""
    planned = _planned_write_dirs(scope, name, write_dirs)
    if planned is None: return agent_read(scope, name)
    p, snapshot, new = planned
    vibe_storage.write_text_with_backup(p, new, agent_backup_dir(scope),
                                        label=name, expected=snapshot.digest)
    return new

def apply_write_dirs_to_project(name):
    """Aktualisiert alle schreibberechtigten Projektagenten mit der aktuellen Verzeichnisliste."""
    dirs = write_dirs(name); folder = agent_dir(name); changed = []
    if not os.path.isdir(folder): return changed
    planned = []
    for f in sorted(os.listdir(folder)):
        if not f.endswith(".md") or not NAME_RE.match(f[:-3]): continue
        item = _planned_write_dirs(name, f[:-3], dirs)
        if item is not None: planned.append((f[:-3], item))
    for agent_name, (p, snapshot, new) in planned:
        vibe_storage.write_text_with_backup(p, new, agent_backup_dir(name),
                                            label=agent_name, expected=snapshot.digest)
        changed.append(agent_name)
    return changed

MODELS_CACHE_FILE = os.path.join(PATHS.state, "models-cache.json")

def _models_cache():
    """Gelesener Modell-Cache oder ``None`` (fehlend/unlesbar)."""
    snapshot = vibe_storage.read_snapshot(MODELS_CACHE_FILE)
    if not snapshot.exists:
        return None
    try:
        data = json.loads(snapshot.text)
    except (TypeError, ValueError):
        return None
    if not isinstance(data, dict) or not isinstance(data.get("models"), list):
        return None
    return {"models": [str(model) for model in data["models"]],
            "stand": str(data.get("stand") or "")}

def models_list():
    """Alle Modelle des aktiven Harness; ein vorhandener Cache hat Vorrang."""
    cached = _models_cache()
    if cached is not None:
        return list(cached["models"])
    return vibe_harness.list_models(state_dir=PATHS.state)["models"]

def models_state():
    """Modelle samt Cache-Stand und Fehlermeldung des Live-Laufs."""
    cached = _models_cache()
    if cached is not None:
        return {"models": list(cached["models"]), "stand": cached["stand"], "error": ""}
    try:
        result = vibe_harness.list_models(state_dir=PATHS.state)
    except vibe_harness.HarnessError as error:
        return {"models": [], "stand": "", "error": str(error)}
    return {"models": list(result.get("models") or []), "stand": "",
            "error": str(result.get("error") or "")}

def models_refresh():
    """Holt die Modelle live und schreibt den Cache; nur hier wird geschrieben."""
    try:
        result = vibe_harness.list_models(state_dir=PATHS.state)
    except vibe_harness.HarnessError as error:
        return False, str(error)
    if not result.get("ok"):
        return False, str(result.get("error") or "Modelle konnten nicht geladen werden")
    stand = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    try:
        vibe_storage.write_text(
            MODELS_CACHE_FILE,
            json.dumps({"stand": stand, "models": list(result.get("models") or [])},
                       ensure_ascii=False))
    except OSError as error:
        return False, "Modell-Cache konnte nicht geschrieben werden: " + str(error)
    return True, "Modelle aktualisiert (Stand " + stand + ")"

def models_info():
    """Modellkatalog als normalisierte Sicht inklusive Prüfbefunden."""
    return vibe_models.load(MODELS_FILE)

def models_info_map(): return {m["id"]: m for m in models_info().get("models", [])}

def cmd_agents():
    rows = agents_all()
    if not rows: sys.exit("Keine Agenten gefunden. Globaler Ordner: " + AGENTS_DIR)
    print(col("b", f"{'Agent':28}{'Geltung':16}{'Modus':10}{'Modell':40}Beschreibung"))
    for a in rows:
        tags = []
        if a["role"]: tags.append("Rolle " + a["role"])
        if a["conflict"]: tags.append("Konflikt")
        if not a["valid"]: tags.append("defekt")
        tag = " (" + ", ".join(tags) + ")" if tags else ""
        print(f"{(a['name'] + tag)[:27]:28}{('global' if a['scope'] == 'global' else 'Projekt ' + a['scope'])[:15]:16}{a['mode']:10}{a['model'][:39]:40}{a['description'][:50]}")
        print(col("d", "  " + a["priority"]))
    print(col("d", "Projektagenten überschreiben gleichnamige globale Agenten (opencode 2.1.4). Rollen sind in profiles.json konfiguriert."))

def cmd_project_agents(name):
    """Zeigt Auswahl und Modellüberschreibungen eines Projekts."""
    rows = project_agent_rows(name)
    if not rows: sys.exit("Keine Agenten gefunden. Globaler Ordner: " + AGENTS_DIR)
    print(col("b", f"{'Agent':28}{'Geltung':16}{'Auswahl':8}{'Modell':40}Überschreibung"))
    for row in rows:
        if row.get("opencode"):
            scope = "opencode"
        else:
            scope = "global" if row["scope"] == "global" else "Projekt " + row["scope"]
        print(f"{row['name'][:27]:28}{scope[:15]:16}{('ja' if row['selected'] else 'nein'):8}"
              f"{row['effective_model'][:39]:40}{row['override']}")
    print(col("d", "Auswahl und Modellüberschreibung gelten nur für dieses Projekt; "
                   "ohne Überschreibung gilt das Modell aus der Agentendatei. "
                   "general/explore sind opencode-eigene Subagenten (kein Dateiagent)."))

def _editor(path):
    ed = os.environ.get("EDITOR") or shutil.which("nano") or shutil.which("vi") or "vi"
    subprocess.run([ed, path])

def cmd_agent(action, name, scope="global", backup=None):
    try:
        if scope != "global" and scope not in projects(): sys.exit("Unbekannter Bereich '" + scope + "' (global oder Projektname).")
        if action == "show": print(agent_read(scope, name)); return
        if action == "backups":
            rows = agent_backups(scope, name)
            folder = agent_backup_dir(scope)
            if not rows: print("Keine Sicherung für", name, "in", folder); return
            print(col("b", f"Sicherungen für {name} ({folder}):"))
            for row in reversed(rows):
                path = os.path.join(folder, row)
                print(f"  {row}  ({os.path.getsize(path)} Bytes)")
            print(col("d", "Wiederherstellen: vibe agent restore " + name + " " + scope + " <sicherung>"))
            return
        if action == "restore":
            result = agent_restore(scope, name, backup)
            print(col("g", "Wiederhergestellt: " + agent_path(scope, name) + " aus " + result["backup"]))
            if result["safety"]: print("Vorheriger Stand gesichert:", result["safety"])
            return
        if action == "rm":
            agent_delete(scope, name); print("Gelöscht (Sicherung in " + BACKUPS + "):", name); return
        if action in ("new", "edit"):
            if action == "new":
                base_text, expected = agent_template("Kurzbeschreibung eintragen", prompt=""), vibe_storage.MISSING
            else:
                snapshot = agent_snapshot(scope, name)
                base_text, expected = snapshot.text, snapshot.digest
            tf = tempfile.NamedTemporaryFile("w", suffix=".md", delete=False, encoding="utf-8")
            tf.write(base_text); tf.close()
            _editor(tf.name); text = open(tf.name, encoding="utf-8").read(); os.unlink(tf.name)
            warn = agent_write(scope, name, text, create=(action == "new"), expected=expected)
            print(col("g", "Gespeichert: " + agent_path(scope, name)))
            for x in warn: print(col("y", "Hinweis: " + x))
            return
        sys.exit("vibe agent new|edit|show|rm|backups|restore <name> [global|<projekt>] [sicherung]")
    except ValueError as e:
        sys.exit(str(e))

def _model_value(model, section, key):
    node = (model.get(section) or {}).get(key)
    return vibe_models.assertion_text(node)

def _model_sources(info):
    """Eindeutige Quellen mit Datum aus Katalogkopf und Angaben."""
    rows, seen = [], set()
    for item in info.get("quellen") or []:
        if not isinstance(item, dict): continue
        name, datum = str(item.get("name") or "").strip(), str(item.get("datum") or "").strip()
        if name and (name, datum) not in seen:
            seen.add((name, datum)); rows.append((name, datum))
    if rows: return rows
    for model in info.get("models") or []:
        for section in ("fakten", "einschaetzungen"):
            for node in (model.get(section) or {}).values():
                if not isinstance(node, dict): continue
                name, datum = str(node.get("quelle") or "").strip(), str(node.get("datum") or "").strip()
                if name and (name, datum) not in seen:
                    seen.add((name, datum)); rows.append((name, datum))
    return rows

def _model_detail(model):
    print(col("b", model.get("name") or model.get("id")) + "  " + col("d", model.get("id", "")))
    print("Anbieter:", model.get("anbieter") or "unbekannt", "| ID-Status:", model.get("id_status") or "unbekannt")
    beleg = model.get("id_beleg") or {}
    if beleg: print(col("d", f"  ID-Beleg: {beleg.get('quelle', '?')} ({beleg.get('datum', '?')})"))
    price = model.get("preis") or {}
    line = "Preis: " + vibe_models.price_text(price)
    if price.get("status") != "unbekannt":
        line += f" | Quelle: {price.get('quelle', '?')} | Stand: {price.get('stand', '?')}"
    elif price.get("grund"):
        line += " | Grund: " + str(price.get("grund"))
    print(line)
    print("Fakten:")
    for key, node in (model.get("fakten") or {}).items():
        text = vibe_models.assertion_text(node)
        if vibe_models.is_unknown(node.get("wert") if isinstance(node, dict) else None):
            print(f"  {key}: {text}")
        else:
            print(f"  {key}: {text} [{node.get('art', '?')}] Quelle: {node.get('quelle', '?')}, Datum: {node.get('datum', '?')}")
    print("Einschätzungen:")
    for key, node in (model.get("einschaetzungen") or {}).items():
        text = vibe_models.assertion_text(node)
        if vibe_models.is_unknown(node.get("wert") if isinstance(node, dict) else None):
            print(f"  {key}: {text}")
        else:
            print(f"  {key}: {text} [{node.get('art', '?')}] Quelle: {node.get('quelle', '?')}, Datum: {node.get('datum', '?')}")
    for key, label in (("staerken", "Stärken"), ("schwaechen", "Schwächen")):
        rows = model.get(key) or []
        print(label + ":")
        if not rows: print("  keine Angaben")
        for node in rows:
            print(f"  - {vibe_models.assertion_text(node)} [{node.get('art', '?')}] Quelle: {node.get('quelle', '?')}, Datum: {node.get('datum', '?')}")

def cmd_models(model_id=None):
    info = models_info(); mp = {m["id"]: m for m in info.get("models", [])}
    if model_id:
        if model_id in mp: _model_detail(mp[model_id]); return
        print("Unbekanntes Modell:", model_id, "(kein Katalogeintrag, keine Einschätzung)")
        return
    if not info.get("models"):
        print("Kein Modellkatalog gefunden: " + MODELS_FILE + " (install-vibe.sh ausführen).")
        current = models_list()
        if current: print("Verfügbar laut aktivem Harness (ohne Katalog): " + ", ".join(current))
        return
    current = models_list()
    findings = list(info.get("findings") or [])
    if current: findings += vibe_models.compare(info, current)
    ids = [i for i in current if i in mp or i.startswith("opencode/")] or list(mp)
    for mid in mp:
        if mid not in ids: ids.append(mid)
    print(col("b", f"{'Modell':34}{'Preis':46}{'Tempo':13}{'Daten':12}{'Coder':14}Reviewer"))
    for mid in ids:
        m = mp.get(mid)
        if not m:
            print(f"{mid[:33]:34}{'unbekannt (kein Katalogeintrag)':46}{'unbekannt':13}{'unbekannt':12}{'unbekannt':14}unbekannt")
            continue
        mark = " (nicht mehr gelistet)" if current and mid not in current and m.get("id_status") != "entfernt" else ""
        price = vibe_models.price_text(m.get("preis") or {})[:40]
        print(f"{(mid + mark)[:33]:34}{price:46}{_model_value(m, 'einschaetzungen', 'tempo')[:12]:13}"
              f"{_model_value(m, 'fakten', 'daten')[:11]:12}{_model_value(m, 'einschaetzungen', 'coder')[:13]:14}"
              f"{_model_value(m, 'einschaetzungen', 'reviewer')}")
    print(col("d", f"\nStand {info.get('stand') or '?'}. Katalog {info.get('version') or '?'}. {info.get('hinweis', '')}"))
    sources = _model_sources(info)
    if sources:
        print(col("d", "Quellen: " + "; ".join(f"{name} ({datum or 'ohne Datum'})" for name, datum in sources)))
    for finding in findings:
        print(col("y", "Hinweis: " + finding["text"]))
    print(col("d", "Details: vibe models <modell-id>"))

def cmd_model(agent, model, scope="global", out=None):
    out = out or sys.stdout
    try:
        snapshot = agent_snapshot(scope, agent)
        t = snapshot.text
        ml = models_list()
        if ml and model not in ml: sys.exit(f"Modell '{model}' ist beim aktiven Harness nicht verfügbar (Anbieter verbinden).")
        m = re.search(r"^model:[ \t]*(\S+)", t, flags=re.M)
        t2 = t.replace(m.group(1), model) if m else t.replace("\n---", f"\nmodel: {model}\n---", 1)
        agent_write(scope, agent, t2, expected=snapshot.digest); print("Modell von", agent, "->", model, file=out)
    except ValueError as e:
        sys.exit(str(e))

# ---------- Profile: Modelle pro Rolle umschalten (Standard / kostenlos / mittel / hoch) ----------
# Die Standardprofile beginnen ohne Modellwerte: Jede Rolle fällt dann auf die
# Agent-Einstellungen und schließlich auf das Modell des Vibe-Agenten zurück.
STANDARD_PROFILES = ("default", "free", "mid", "high")
DEFAULT_PROFILES = {
 "aktiv": "default",
 # Rollen sind bewusst leer: vibe kennt keine fest eingebauten Agentennamen.
 # Die Zuordnung erfolgt in der Oberfläche oder in profiles.json.
 "rollen": {},
 "profile": {"default": {}, "free": {}, "mid": {}, "high": {}}}

def profiles_load(return_snapshot=False):
    snapshot = vibe_storage.read_snapshot(PROFILES_FILE)
    try: d = json.loads(snapshot.text) if snapshot.exists else json.loads(json.dumps(DEFAULT_PROFILES))
    except Exception: d = json.loads(json.dumps(DEFAULT_PROFILES))
    if not isinstance(d, dict): d = json.loads(json.dumps(DEFAULT_PROFILES))
    for k, v in DEFAULT_PROFILES.items(): d.setdefault(k, json.loads(json.dumps(v)))
    if not isinstance(d.get("profile"), dict): d["profile"] = {}
    # Standardprofile werden nur ergänzt; nutzerdefinierte Profile bleiben.
    for name in STANDARD_PROFILES: d["profile"].setdefault(name, {})
    if d.get("aktiv") not in d["profile"]: d["aktiv"] = "default"
    return (d, snapshot) if return_snapshot else d

def profiles_save(d, expected=None):
    os.makedirs(PATHS.state, exist_ok=True)
    vibe_storage.write_text(PROFILES_FILE, json.dumps(d, indent=1, ensure_ascii=False), expected=expected)

def profile_backup_dir():
    """Ablage der Sicherungen von profiles.json."""
    return os.path.join(PATHS.state, "profile-backups")

def default_role_models():
    """Rolle → Modell des ersten globalen Agenten mit dieser Rolle.

    Ohne Zuordnung oder ohne Modell bleibt der Wert leer; die Fallback-Kette
    überspringt ihn dann, statt einen Platzhalter zu schreiben.
    """
    result = {}
    for row in agents_all():
        if row.get("scope") != "global": continue
        role = row.get("role") or ""
        if not role or role in result: continue
        model = row.get("model") or ""
        result[role] = "" if model == "-" else model
    return result

def profile_apply(name):
    d, before = profiles_load(return_snapshot=True)
    if name not in d["profile"]: raise ValueError("Unbekanntes Profil: " + name)
    prof, ml, done, skipped = d["profile"][name], models_list(), [], []
    defaults = default_role_models()
    vibe_model = vibe_agent_status().get("model", "")
    resolved = []
    for agent, role in d["rollen"].items():
        # Wirksame Kette: Profilwert → Default-Profil (Agent-Einstellungen) →
        # Modell des Vibe-Agenten. Erst alle Werte prüfen, dann schreiben.
        model = prof.get(role) or defaults.get(role) or vibe_model
        resolved.append((agent, role, model))
        if not model: skipped.append(f"{agent}: für Rolle '{role}' ist kein Modell gesetzt"); continue
        if ml and model not in ml: raise ValueError(f"Modell '{model}' ist beim aktiven Harness nicht verfügbar. Anbieter zuerst verbinden (opencode: /connect oder 'opencode auth login'; Pi: /login). Nichts wurde geändert.")
    for agent, role, model in resolved:
        if not model: continue
        try: snapshot = agent_snapshot("global", agent)
        except ValueError: skipped.append(f"{agent}: Agent nicht gefunden"); continue
        t = snapshot.text
        m = re.search(r"^model:[ \t]*(\S+)", t, flags=re.M)
        agent_write("global", agent, t.replace(m.group(1), model) if m else t.replace("\n---", f"\nmodel: {model}\n---", 1), expected=snapshot.digest); done.append(f"{agent} -> {model}")
    d["aktiv"] = name
    profiles_save(d, expected=before.digest if before.exists else vibe_storage.MISSING)
    return done, skipped

def cmd_profile(action="list", name=None):
    d = profiles_load()
    try:
        if action == "use" and name:
            done, skipped = profile_apply(name); print(col("g", f"Profil '{name}' angewendet:"))
            for x in done: print("  ", x)
            for x in skipped: print(col("y", "   übersprungen: " + x))
            return
    except ValueError as e:
        sys.exit(str(e))
    print(col("b", "Profile") + f" (aktiv: {d['aktiv']})")
    for pn, pv in d["profile"].items(): print(f"  {'*' if pn == d['aktiv'] else ' '} {pn:10} " + ", ".join(f"{r}={m or '—'}" for r, m in pv.items()))
    print("Rollen:", ", ".join(f"{a}={r}" for a, r in d["rollen"].items()))
    print("Anwenden: vibe profile use <name>")

# ---------- Kostenermittlung je Arbeitspaket und Projekt (F12) ----------
# Preise werden in Euro je 1 Mio. Tokens geführt. Unbekannte Preise werden mit
# 0 angesetzt; die Eingabe des Nutzers je Projekt überschreibt systemische
# Werte. Die opencode-Datenbank wird ausschließlich lesend geöffnet.
COSTS_FILE = os.path.join(TOOLS, "costs.json")
PRICES_FILE = os.path.join(TOOLS, "prices.json")
COSTS_CURRENCY = "EUR"
GLOBAL_PRICES_FILE = os.path.join(PATHS.state, "global-prices.json")
COSTS_UNIT_TOKENS = 1_000_000
COSTS_MAX_PRICE = 1_000_000.0
PRICE_FIELDS = ("input", "cached_input", "output")


def _zero_tokens():
    return {"input": 0, "cached": 0, "output": 0}


def _add_tokens(target, source):
    for field in ("input", "cached", "output"):
        target[field] += source[field]


def _month_key(epoch):
    """Kalendermonat (YYYY-MM, UTC) einer Sitzung; unlesbare Zeit bleibt leer."""
    try:
        value = int(epoch)
    except (TypeError, ValueError, OverflowError):
        return ""
    if value <= 0:
        return ""
    return time.strftime("%Y-%m", time.gmtime(value))


def _month_bucket():
    """Zähler für einen Monat: Tokens, Kosten, Sitzungen."""
    return {"tokens": _zero_tokens(), "cost": 0.0, "sessions": 0}


def _add_month(target, month, tokens, cost=0.0, sessions=0):
    """Fügt einem Monatszähler Tokens, Kosten und Sitzungen hinzu."""
    bucket = target.setdefault(month, _month_bucket())
    _add_tokens(bucket["tokens"], tokens)
    bucket["cost"] += cost
    bucket["sessions"] += sessions


def _month_rows(months):
    """Monatsliste, neueste zuerst (additiv zu den bestehenden Feldern)."""
    return [dict(month=month, **_month_view(months[month]))
            for month in sorted(months, reverse=True)]


def _month_view(bucket):
    """Kopie eines Monatszählers ohne interne Referenzen."""
    return {"tokens": dict(bucket["tokens"]), "cost": bucket["cost"],
            "sessions": bucket["sessions"]}


def _int_tokens(value):
    """Nichtnegative Ganzzahl; kaputte Werte zählen als 0."""
    try:
        number = int(value)
    except (TypeError, ValueError):
        return 0
    return number if number > 0 else 0


def package_catalog(name):
    """Bekannte Paket-IDs mit Kurztitel aus dem Ticketspeicher.

    Grundlage ist der Ticketspeicher (``.vibe/tickets.json``); die erste
    Fundstelle gewinnt.
    """
    root = project_map().get(name)
    if not root:
        return {}
    found = {}
    for record in vibe_tickets.load(root):
        pid = record.get("id")
        if pid:
            found.setdefault(pid, (record.get("title") or "")[:80])
    return found


def package_ids(name):
    return set(package_catalog(name))


def package_for_title(title, ids):
    """Ordnet einen Sitzungstitel dem genannten Paket zu.

    Es zählt die früheste Fundstelle einer bekannten Paket-ID als eigenes
    Wort; bei gleicher Stelle gewinnt die längere ID (F12 vor F1).
    """
    text = title or ""
    best = None
    for pid in ids:
        if not pid:
            continue
        match = re.search(r"(?<![A-Za-z0-9_-])" + re.escape(pid) + r"(?![A-Za-z0-9_-])", text)
        if not match:
            continue
        key = (match.start(), -len(pid))
        if best is None or key < best[0]:
            best = (key, pid)
    return best[1] if best else ""


def _normalize_price(price):
    """Prüft einen Preis (Euro je 1 Mio. Tokens) und liefert ihn als Zahlen."""
    if not isinstance(price, dict):
        raise ValueError("Preis muss ein Objekt mit input, cached_input und output sein")
    extra = set(price) - set(PRICE_FIELDS)
    if extra:
        raise ValueError("Unbekannte Preisfelder: " + ", ".join(sorted(map(str, extra))))
    out = {}
    for field in PRICE_FIELDS:
        if field not in price:
            raise ValueError("Preis unvollständig: " + field + " fehlt")
        value = price[field]
        if isinstance(value, bool) or not isinstance(value, (int, float)):
            raise ValueError("Preis für " + field + " muss eine Zahl sein")
        number = float(value)
        if not math.isfinite(number) or number < 0:
            raise ValueError("Preis für " + field + " muss eine nichtnegative Zahl sein")
        if number > COSTS_MAX_PRICE:
            raise ValueError("Preis für " + field + " ist unrealistisch hoch")
        out[field] = number
    return out


def _costs_data():
    """Nutzerpreise lesen; liefert (Daten, Snapshot) ohne still zu reparieren."""
    snapshot = vibe_storage.read_snapshot(COSTS_FILE)
    if not snapshot.exists:
        return {"version": 1, "projects": {}}, snapshot
    try:
        data = json.loads(snapshot.text)
    except ValueError:
        raise ValueError("Preisdatei ist nicht lesbar (kein gültiges JSON): " + COSTS_FILE)
    if not isinstance(data, dict) or not isinstance(data.get("projects", {}), dict):
        raise ValueError("Preisdatei hat ein unbekanntes Format: " + COSTS_FILE)
    data.setdefault("version", 1)
    data.setdefault("projects", {})
    return data, snapshot


def _project_prices_from(data, name):
    entry = data["projects"].get(name)
    if not isinstance(entry, dict):
        return {}
    models = entry.get("models")
    if not isinstance(models, dict):
        return {}
    out = {}
    for model, price in models.items():
        try:
            out[str(model)] = _normalize_price(price)
        except ValueError:
            continue
    return out


def project_prices(name):
    data, _ = _costs_data()
    return _project_prices_from(data, name)


def _known_project(name):
    path = project_map().get(name)
    if not path:
        raise ValueError("Unbekanntes Projekt: " + str(name))
    return path


def _normalize_prices(prices):
    """Validiert eine Preis-Map und liefert ``Modell-ID → Preis oder None``.

    ``None`` entfernt die Nutzereingabe. Ungültige Eingaben lösen ``ValueError``
    aus und schreiben nichts; die Meldungen sind Teil des API-Vertrags.
    """
    if not isinstance(prices, dict):
        raise ValueError("prices muss ein Objekt sein")
    normalized = {}
    for model, price in prices.items():
        model = str(model).strip()
        if not model:
            raise ValueError("Modellname fehlt")
        if len(model) > 200 or any(char in model for char in "\r\n\t"):
            raise ValueError("Modellname ist ungültig: " + model[:60])
        normalized[model] = None if price is None else _normalize_price(price)
    return normalized


def costs_set_prices(name, prices, expected=None):
    """Speichert Nutzerpreise für genau ein Projekt.

    ``prices`` bildet Modell-ID auf ``{input, cached_input, output}`` ab. Ein
    Wert ``None`` entfernt die Nutzereingabe, sodass wieder der systemische
    Preis gilt. Ungültige Eingaben ändern die Datei nicht.
    """
    _known_project(name)
    normalized = _normalize_prices(prices)
    data, snapshot = _costs_data()
    entry = data["projects"].get(name)
    if not isinstance(entry, dict):
        entry = {"models": {}}
    models = entry.get("models")
    if not isinstance(models, dict):
        models = {}
    for model, price in normalized.items():
        if price is None:
            models.pop(model, None)
        else:
            models[model] = price
    entry["models"] = models
    if models:
        data["projects"][name] = entry
    else:
        data["projects"].pop(name, None)
    if expected is None:
        expected = snapshot.digest if snapshot.exists else vibe_storage.MISSING
    os.makedirs(TOOLS, exist_ok=True)
    vibe_storage.write_text(
        COSTS_FILE, json.dumps(data, indent=1, ensure_ascii=False) + "\n",
        expected=expected)
    return project_prices(name)


def costs_set_global_prices(prices):
    """Speichert persönliche globale Modellpreise im Zustandsordner.

    ``prices`` bildet Modell-ID auf ``{input, cached_input, output}`` ab; ein
    ``None``-Wert entfernt den Eintrag. Ungültige Eingaben lösen
    ``ValueError`` aus und schreiben nichts. Liefert ``global_prices()``.
    """
    normalized = _normalize_prices(prices)
    kept = {model: price for model, price in normalized.items()
            if price is not None}
    vibe_storage.write_text(
        GLOBAL_PRICES_FILE,
        json.dumps(kept, indent=1, ensure_ascii=False, sort_keys=True) + "\n")
    return global_prices()


def global_prices():
    """Globale Nutzerpreise: Modell → ``{input, cached_input, output}``.

    Fehlende Datei ist das leere Objekt. Rangfolge bei der Berechnung:
    Projektpreise > globale Nutzerpreise > Katalog.
    """
    snapshot = vibe_storage.read_snapshot(GLOBAL_PRICES_FILE)
    if not snapshot.exists:
        return {}
    try:
        data = json.loads(snapshot.text)
    except ValueError:
        raise ValueError("Globale Preise sind nicht lesbar (kein gültiges JSON): "
                         + GLOBAL_PRICES_FILE)
    if not isinstance(data, dict):
        raise ValueError("Globale Preise haben ein unbekanntes Format: "
                         + GLOBAL_PRICES_FILE)
    out = {}
    for model, price in data.items():
        try:
            out[str(model)] = _normalize_price(price)
        except ValueError:
            continue
    return out


def _global_user_prices(name):
    """Nutzerpreise mit globalen Preisen: Projekt überlagert global."""
    merged = global_prices()
    merged.update(project_prices(name))
    return merged


def _system_prices():
    """Optionale systemische Preise in Euro aus ``_toolchain/prices.json``.

    Eine andere Währung wird nicht als Euro ausgegeben; solche Einträge gelten
    als unbekannt. Ungültige Einzelpreise werden übersprungen.
    """
    try:
        with open(PRICES_FILE, encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    currency = str(data.get("waehrung") or "").strip().upper()
    if currency and currency != COSTS_CURRENCY:
        return {}
    models = data.get("modelle")
    if not isinstance(models, dict):
        return {}
    out = {}
    for model, price in models.items():
        try:
            out[str(model)] = _normalize_price(price)
        except ValueError:
            continue
    return out


def _price_for(model, user_prices, system_prices, catalog):
    """Preis und Herkunft: Nutzer vor systemisch vor kostenlos vor unbekannt."""
    if model in user_prices:
        return dict(user_prices[model]), "user"
    if model in system_prices:
        return dict(system_prices[model]), "system"
    info = catalog.get(model)
    if vibe_models.is_free(info):
        return {"input": 0.0, "cached_input": 0.0, "output": 0.0}, "kostenlos"
    return {"input": 0.0, "cached_input": 0.0, "output": 0.0}, "unbekannt"


def _cost_of(tokens, price):
    """Euro-Kosten; gecachte Eingabe wird zum Cachepreis gerechnet."""
    uncached = max(tokens["input"] - tokens["cached"], 0)
    return (uncached / COSTS_UNIT_TOKENS * price["input"]
            + tokens["cached"] / COSTS_UNIT_TOKENS * price["cached_input"]
            + tokens["output"] / COSTS_UNIT_TOKENS * price["output"])



def _session_month(usage, costs, session_id):
    """Monat einer Session: gespeicherter Monat, sonst Flush-Zeitpunkt."""
    month = usage.get("month") if isinstance(usage, dict) else None
    if isinstance(month, str) and re.fullmatch(r"\d{4}-\d{2}", month):
        return month
    months = costs.get("months") if isinstance(costs, dict) else None
    if isinstance(months, dict):
        fallback = months.get(session_id)
        if isinstance(fallback, str) and re.fullmatch(r"\d{4}-\d{2}", fallback):
            return fallback
    return ""


def _project_stats(name, tickets, user_prices, system_prices, catalog):
    """Paket- und Modellstatistik aus den persistierten Paketkosten (GH-99).

    Die opencode-Datenbank ist keine Quelle der Übersicht mehr; sie wird nur
    beim Spülen gelesen. Ein Paket erscheint, sobald es gespeicherten Verbrauch
    besitzt. Monatsbuckets kommen aus dem gespeicherten Session-Monat, sonst
    aus dem beim Spülen festgehaltenen Rückfallmonat.
    """
    packages = {}
    for record in tickets:
        pid = str(record.get("id") or "")
        if not pid:
            continue
        costs = vibe_tickets.usage_of(record)
        sessions = costs.get("sessions") if isinstance(costs, dict) else {}
        if not isinstance(sessions, dict) or not sessions:
            continue
        package = packages.setdefault(pid, {
            "id": pid,
            "title": str(record.get("title") or ""),
            "sessions": 0, "models": {}, "tokens": _zero_tokens(), "cost": 0.0,
            "_months": {}, "_month_sessions": {}})
        for session_id, usage in sessions.items():
            if not isinstance(usage, dict):
                continue
            package["sessions"] += 1
            month = _session_month(usage, costs, session_id)
            if month:
                package["_month_sessions"][month] = (
                    package["_month_sessions"].get(month, 0) + 1)
            models = usage.get("models")
            if not isinstance(models, dict):
                continue
            for model, entry in models.items():
                if not isinstance(entry, dict):
                    continue
                agent = str(entry.get("agent") or "")
                tokens = {
                    "input": _int_tokens(entry.get("input")),
                    "cached": _int_tokens(entry.get("cached_input")),
                    "output": _int_tokens(entry.get("output")),
                }
                model_entry = package["models"].setdefault((agent, model), {
                    "agent": agent, "model": model,
                    "tokens": _zero_tokens(), "cost": 0.0, "_by_month": {}})
                _add_tokens(model_entry["tokens"], tokens)
                if month:
                    _add_month(model_entry["_by_month"], month, tokens)
    total = {"tokens": _zero_tokens(), "cost": 0.0,
             "sessions": sum(p["sessions"] for p in packages.values())}
    total_months = {}
    models = {}
    for package in packages.values():
        for key in sorted(package["models"]):
            entry = package["models"][key]
            price, source = _price_for(entry["model"], user_prices, system_prices, catalog)
            entry["price"] = price
            entry["price_source"] = source
            entry["cost"] = _cost_of(entry["tokens"], price)
            for month, bucket in entry.pop("_by_month", {}).items():
                tokens = bucket["tokens"]
                month_cost = _cost_of(tokens, price)
                _add_month(package["_months"], month, tokens, month_cost)
                _add_month(total_months, month, tokens, month_cost)
            _add_tokens(package["tokens"], entry["tokens"])
            package["cost"] += entry["cost"]
            aggregated = models.setdefault(entry["model"], {
                "model": entry["model"], "agents": [], "tokens": _zero_tokens(),
                "cost": 0.0, "price": price, "price_source": source})
            if entry["agent"] not in aggregated["agents"]:
                aggregated["agents"].append(entry["agent"])
            _add_tokens(aggregated["tokens"], entry["tokens"])
            aggregated["cost"] += entry["cost"]
        for month, count in package.pop("_month_sessions").items():
            _add_month(package["_months"], month, _zero_tokens(), 0.0, count)
            _add_month(total_months, month, _zero_tokens(), 0.0, count)
        _add_tokens(total["tokens"], package["tokens"])
        total["cost"] += package["cost"]
        package["months"] = {month: _month_view(bucket)
                             for month, bucket in package.pop("_months").items()}
        monthly = _month_rows(package["months"])
        package["monthly"] = monthly
        package["month"] = monthly[0]["month"] if monthly else ""
        package["models"] = [package["models"][key] for key in sorted(package["models"])]
    ordered = [packages[pid] for pid in
               sorted(packages, key=lambda pid: (pid == "", _natural_key(pid)))]
    return {"packages": ordered, "total": total,
            "models": [models[key] for key in sorted(models)],
            "monthly": _month_rows(total_months)}


def _natural_key(value):
    return [int(part) if part.isdigit() else part.lower()
            for part in re.split(r"(\d+)", value or "")]


def costs_project(name):
    """Kostenübersicht eines Projekts aus den persistierten Paketkosten."""
    path = _known_project(name)
    tickets = vibe_tickets.load(path)
    stats = _project_stats(name, tickets, _global_user_prices(name),
                           _system_prices(), models_info_map())
    return {
        "available": True, "message": "", "db": "",
        "currency": COSTS_CURRENCY, "unit": "1M",
        "project": name, "sessions": stats["total"]["sessions"],
        "packages": stats["packages"], "total": stats["total"],
        "models": stats["models"], "monthly": stats["monthly"],
        "user_prices": project_prices(name),
        "global_prices": global_prices(),
    }


def costs_overview():
    """Kostenübersicht aller Projekte aus den persistierten Paketkosten."""
    projects = {name: path for name, path in project_map().items()}
    system_prices = _system_prices()
    catalog = models_info_map()
    rows = []
    total = {"tokens": _zero_tokens(), "cost": 0.0, "sessions": 0}
    monthly = {}
    for name in sorted(projects):
        try:
            tickets = vibe_tickets.load(projects[name])
        except (OSError, ValueError):
            tickets = []
        stats = _project_stats(name, tickets, _global_user_prices(name),
                               system_prices, catalog)
        row = {"name": name, "packages": len(stats["packages"]),
               "sessions": stats["total"]["sessions"],
               "tokens": stats["total"]["tokens"], "cost": stats["total"]["cost"],
               "monthly": stats["monthly"]}
        rows.append(row)
        for entry in stats["monthly"]:
            _add_month(monthly, entry["month"], entry["tokens"],
                       entry["cost"], entry["sessions"])
        _add_tokens(total["tokens"], row["tokens"])
        total["cost"] += row["cost"]
        total["sessions"] += row["sessions"]
    return {"available": True, "message": "", "db": "",
            "currency": COSTS_CURRENCY, "unit": "1M",
            "projects": rows, "total": total, "monthly": _month_rows(monthly),
            "global_prices": global_prices()}


def _num(value):
    return f"{int(value):,}".replace(",", ".")


def _euro(value):
    return f"{value:,.4f}".replace(",", "X").replace(".", ",").replace("X", ".") + " €"


def cmd_costs(name=None):
    """Kosten je Projekt oder je Arbeitspaket eines Projekts anzeigen."""
    if name:
        data = costs_project(name)
        print(col("b", f"Kosten je Arbeitspaket — {name} "
                       f"({data['currency']}, Preise je 1 Mio. Tokens)"))
        if not data["available"]:
            print(col("y", data["message"]))
        print(f"{'Paket':14}{'Sitzungen':>10}{'Eingabe':>12}{'davon cached':>14}"
              f"{'Ausgabe':>12}{'Kosten':>14}")
        for package in data["packages"]:
            tokens = package["tokens"]
            print(f"{(package['id'] or '—'):14}{package['sessions']:>10}"
                  f"{_num(tokens['input']):>12}{_num(tokens['cached']):>14}"
                  f"{_num(tokens['output']):>12}{_euro(package['cost']):>14}")
        tokens = data["total"]["tokens"]
        print(f"{'Summe':14}{data['total']['sessions']:>10}"
              f"{_num(tokens['input']):>12}{_num(tokens['cached']):>14}"
              f"{_num(tokens['output']):>12}{_euro(data['total']['cost']):>14}")
        unknown = [m["model"] for m in data["models"] if m["price_source"] == "unbekannt"]
        if unknown:
            print(col("y", "Preis unbekannt (0 € angesetzt): " + ", ".join(unknown)
                        + " — im Dashboard unter „Kosten“ eintragen."))
        return
    data = costs_overview()
    print(col("b", f"Kosten je Projekt ({data['currency']}, Preise je 1 Mio. Tokens)"))
    if not data["available"]:
        print(col("y", data["message"]))
    print(f"{'Projekt':22}{'Pakete':>8}{'Sitzungen':>10}{'Eingabe':>12}"
          f"{'davon cached':>14}{'Ausgabe':>12}{'Kosten':>14}")
    for row in data["projects"]:
        tokens = row["tokens"]
        print(f"{row['name'][:21]:22}{row['packages']:>8}{row['sessions']:>10}"
              f"{_num(tokens['input']):>12}{_num(tokens['cached']):>14}"
              f"{_num(tokens['output']):>12}{_euro(row['cost']):>14}")
    tokens = data["total"]["tokens"]
    print(f"{'Gesamt':22}{'':>8}{data['total']['sessions']:>10}"
          f"{_num(tokens['input']):>12}{_num(tokens['cached']):>14}"
          f"{_num(tokens['output']):>12}{_euro(data['total']['cost']):>14}")


# ---------- Emulator, Server, Dashboard, Doctor ----------
def cmd_emu(action):
    if action not in ("start", "stop"):
        sys.exit("Unbekannte Emulator-Aktion '" + str(action) + "' (start|stop)")
    p = next((project_map()[n] for n in projects() if ptype(n) == "android"), None)
    if not p: sys.exit("Kein Android-Projekt vorhanden")
    script = os.path.join(p, "scripts", "emulator-" + action + ".sh")
    rc, out = run(["bash", "-lc", 'source ~/.bashrc; exec bash "$1"', "vibe-emu", script], timeout=300)
    if out: print(out)

def server_health():
    """Nur ein gesunder opencode-Server zählt; ein fremder 200er nicht.

    opencode antwortet auf ``/global/health`` mit einem JSON-Objekt, das
    ``healthy: true`` und eine Version enthält. Ein beliebiger Webserver auf
    demselben Port darf nicht als laufender opencode-Server gelten.
    """
    argv = ["curl", "-sf", "--max-time", "2"]
    try:
        with open(opencode_password_path(), encoding="utf-8") as handle:
            password = handle.read().strip()
    except OSError:
        password = ""
    if password:
        # Der lokale opencode-Server ist seit F19 mit Basic-Auth geschützt.
        # Ohne Anmeldung würde der Gesundheitscheck fälschlich "aus" melden.
        argv.extend(["-u", "opencode:" + password])
    # opencode v2 antwortet auf /api/info mit Version und Prozessdaten; der
    # frühere Endpunkt /global/health wird nur noch ohne Kennwort als
    # Rückfall für ältere Installationen geprüft.
    endpoints = [(OC_URL + "/api/info", True)]
    if not password:
        endpoints.append((OC_URL + "/global/health", False))
    for url, modern in endpoints:
        rc, out = run(argv + [url])
        if rc != 0:
            continue
        try:
            data = json.loads(out)
        except ValueError:
            continue
        if not isinstance(data, dict):
            continue
        version = data.get("version")
        if not isinstance(version, str) or not version.strip():
            continue
        if modern or data.get("healthy") is True:
            return out
    return None

def server_session():
    return profile_session("vibe-server")

def opencode_password_path():
    return os.path.join(LOGS, "opencode.password")

def ensure_opencode_password():
    """Legt das Kennwort des lokalen opencode-Servers an oder liest es.

    Das Kennwort bleibt in der Laufzeit; es wird nie als Argument übergeben.
    Der Serverprozess liest es beim Start über eine Datei-Referenz. Auf
    FUSE/NTFS sind Unix-Rechte nicht garantiert; die Datei wird trotzdem mit
    restriktiven Rechten angelegt, soweit das Dateisystem sie trägt.
    """
    path = opencode_password_path()
    try:
        with open(path, encoding="utf-8") as handle:
            existing = handle.read().strip()
    except OSError:
        existing = ""
    if existing:
        return path
    value = secrets.token_urlsafe(24)
    try:
        os.makedirs(LOGS, exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(value + "\n")
    except OSError as error:
        sys.exit("opencode-Kennwort konnte nicht angelegt werden: " + str(error))
    return path

def cmd_server(action="status", out=None):
    out = out or sys.stdout
    session = server_session()
    if action == "start":
        if server_health(): print("opencode-Server läuft:", OC_URL, file=out); return
        if port_in_use("127.0.0.1", PATHS.opencode_port):
            sys.exit(f"Port {PATHS.opencode_port} ist belegt, aber kein gesunder "
                     "opencode-Server erkannt; nichts gestartet.")
        if tmux_session_exists(session):
            if not session_owned(session, "server"):
                sys.exit(f"tmux-Sitzung {session} gehört nicht zu vibe; nichts gestartet.")
            print("opencode-Server startet bereits (tmux attach -t " + session + ").", file=out)
            return
        # F26: Die Version wird einmal erkannt und dem Adapter übergeben, so
        # dass Startbefehl und Hinweis aus derselben Prüfung stammen.
        version_info = vibe_opencode.probe()
        try:
            command = vibe_opencode.server_command(PATHS.opencode_port, info=version_info)
        except vibe_opencode.CompatibilityError as error:
            sys.exit(str(error))
        if not version_info.checked:
            print("Hinweis: " + version_info.message, file=out)
        # F19: Der Server erhält ein eigenes Kennwort für angemeldete
        # Zusatzanweisungen. Das Kennwort selbst steht nie in der Befehlszeile;
        # der Kindprozess liest es beim Start aus der Laufzeitdatei.
        password_file = ensure_opencode_password()
        # Port ist validiert (1..65535) und damit kein Shell-Freitext; der
        # Adapter liefert eine Argumentliste, die shlex.join sicher quotet.
        rc, output = run(["tmux", "new-session", "-d", "-s", session,
                       "-e", MANAGED_VAR + "=server",
                       "-e", "OPENCODE_SERVER_PASSWORD_FILE=" + password_file,
                       "bash", "-lc",
                       'source ~/.bashrc; unset OPENCODE_PASSWORD; export OPENCODE_SERVER_PASSWORD="$(cat "$OPENCODE_SERVER_PASSWORD_FILE")"; exec ' + shlex.join(command)])
        if rc != 0:
            sys.exit("opencode-Server nicht gestartet: " + output)
        time.sleep(4); print("Gestartet:" if server_health() else "Start angestoßen, Server antwortet noch nicht (tmux attach -t " + session + "):", OC_URL, file=out)
    elif action == "stop":
        if not tmux_session_exists(session):
            print("opencode-Server läuft nicht (keine vibe-Sitzung).", file=out)
            return
        if not session_owned(session, "server"):
            sys.exit(f"tmux-Sitzung {session} gehört nicht zu vibe; nichts beendet.")
        run(["tmux", "kill-session", "-t", session]); print("opencode-Server beendet.", file=out)
    else:
        h = server_health(); print("opencode-Server:", col("g", "läuft " + OC_URL + " " + h, stream=out) if h else "aus", file=out)

# ---------- Schrankeneinstellungen des Läufers (AP10) ----------
# Die Schranken sind global in <Zustand>/gates.json abgelegt und können je
# Projekt in .vibe/project.env optional abweichen (Priorität: Projekt >
# global > Voreinstellung). Sie steuern Reparaturrunden, Assistenzrunden,
# Wiederholungen, das Durchgangslimit und die Rückfrage an blockierten Paketen.
GATES_USAGE = ("Aufruf: vibe gates [--project <projekt>] [status] "
               "[<schranke> <wert>]  Schranken: "
               + ", ".join(vibe_gates.DEFAULTS) if vibe_gates else
               "Aufruf: vibe gates — vibe_gates.py fehlt in der Installation")

def project_for_cwd():
    """Name und Pfad des Projekts, in dem der Aufruf läuft (oder None, None).

    Ein Projekt gilt als gefunden, wenn der aktuelle Ordner der registrierte
    Projektpfad ist oder darin liegt. So zeigt `vibe gates status` im
    Projektordner automatisch dessen abweichende Werte.
    """
    cwd = os.path.realpath(os.getcwd())
    for name, path in project_map().items():
        real = os.path.realpath(path)
        if cwd == real or cwd.startswith(real + os.sep):
            return name, real
    return None, None

def _gates_show(project_name=None):
    """Zeigt die wirksamen Schranken samt Herkunft (AP10)."""
    if vibe_gates is None:
        sys.exit("vibe_gates.py fehlt in der Installation; "
                 "bitte Setup --update ausführen.")
    project_dir = None
    if project_name is not None:
        project_dir = ppath(project_name)
    else:
        project_name, project_dir = project_for_cwd()
    result = vibe_gates.effective(PATHS.state, project_dir)
    where = f" (Projekt: {project_name})" if project_name else ""
    print(col("b", "Wirksame Schranken des Läufers" + where + ":"))
    for key, entry in result["gates"].items():
        print(f"  {key:<14}{str(entry['value']):<6}{entry['origin']}")
    for message in result["problems"]:
        print(col("y", "Hinweis: " + message))

def cmd_gates(rest=None):
    """Zeigt oder setzt die Läufer-Schranken (AP10).

    Ohne Argumente bzw. mit ``status`` werden die wirksamen Werte samt
    Herkunft gezeigt (Projekt aus dem aktuellen Ordner, falls registriert,
    oder mit ``--project <name>``, an beliebiger Position). ``<schranke>
    <wert>`` setzt global; ``--project <name> <schranke> <wert>`` schreibt den Projektwert, ein
    leerer Wert entfernt ihn. Unbekannte Schranken und ungültige Werte
    werden ohne Schreibvorgang mit Fehler abgewiesen.
    """
    if vibe_gates is None:
        sys.exit("vibe_gates.py fehlt in der Installation; "
                 "bitte Setup --update ausführen.")
    args = list(rest or [])
    project_name = None
    # --project <name> wird in jeder Position erkannt, auch nach "status",
    # damit "vibe gates status --project proj" nicht still das falsche
    # Projekt zeigt.
    while "--project" in args:
        index = args.index("--project")
        if len(args) <= index + 1:
            sys.exit(GATES_USAGE)
        project_name = args[index + 1]
        args = args[:index] + args[index + 2:]
    if not args or args[0] == "status":
        _gates_show(project_name)
        return
    if len(args) != 2: sys.exit(GATES_USAGE)
    key, value = args
    if project_name is not None and value == "":
        # Leerer Wert entfernt den Projektwert (set_env_values löscht die
        # Zeile); der Schlüssel wird trotzdem gegen die bekannten Schranken
        # geprüft, damit Tippfehler nicht still durchlaufen.
        gate_env = vibe_gates.PROJECT_ENV_KEYS.get(key)
        if gate_env is None:
            sys.exit("Unbekannte Schranke: " + key)
        try:
            set_env_values(project_name, {gate_env: None}, quote=False)
        except (OSError, ValueError) as error:
            sys.exit("Projektschranke nicht entfernt: " + str(error))
        print(f"Projektschranke entfernt ({project_name}): {gate_env}")
        _gates_show(project_name)
        return
    try:
        parsed = vibe_gates.validate(key, value)
    except ValueError as error:
        sys.exit(str(error))
    if project_name is None:
        try:
            vibe_gates.save(PATHS.state, key, parsed)
        except OSError as error:
            sys.exit("Schranke nicht gespeichert: " + str(error))
        print(f"Gespeichert (global): {key}={parsed}")
    else:
        gate_env = vibe_gates.PROJECT_ENV_KEYS[key]
        try:
            set_env_values(project_name, {gate_env: str(parsed)}, quote=False)
        except (OSError, ValueError) as error:
            sys.exit("Projektschranke nicht gespeichert: " + str(error))
        print(f"Gespeichert (Projekt {project_name}): {gate_env}={parsed}")
    _gates_show(project_name)

def cmd_harness(action="status", name=None, out=None):
    """Zeigt, wechselt und erklärt den Harness; die Auswahl liegt im Zustandsordner."""
    out = out or sys.stdout
    try:
        if action in ("status", "list"):
            data = vibe_harness.status(PATHS.state)
            print("Harness:", data["selected"], file=out)
            for item in data["harnesses"]:
                marker = "*" if item["selected"] else " "
                version = " " + item["version"] if item["version"] else ""
                print(f" {marker} {item['harness']:<9}{item['status']:<9}{version}  {item['message']}", file=out)
                if item["install_command"]:
                    print("     Einrichten: " + shlex.join(item["install_command"]), file=out)
                if not item["installed"]:
                    print("     Hinweis: " + item["hint"], file=out)
            return
        if action == "use":
            if not name:
                sys.exit("Aufruf: vibe harness use <opencode|pi>")
            path = vibe_harness.write_selection(PATHS.state, name)
            print("Harness gespeichert:", name, "(" + path + ")", file=out)
            return
        if action == "setup":
            chosen = name or vibe_harness.read_selection(PATHS.state)
            plan = vibe_harness.setup_plan(chosen)
            print("Harness:", plan["harness"], file=out)
            print("Installiert:", "ja" if plan["installed"] else "nein", file=out)
            print("Hinweis:", plan["hint"], file=out)
            print("Offiziell:", plan["official"], file=out)
            if plan["install_command"]:
                print("Einrichten:", " ".join(plan["install_command"]), file=out)
            return
        sys.exit("Aufruf: vibe harness [status|list|use <name>|setup [name]]")
    except vibe_harness.HarnessError as error:
        sys.exit(str(error))

def cmd_keys(args):
    """AP23: Secrets im lokalen Vault speichern, auswählen und auflisten."""
    usage = ("Aufruf: vibe keys add <name> [--provider P] [--secret S] | "
             "vibe keys select <name> | vibe keys list | vibe keys remove <name>")
    if not args:
        sys.exit(usage)
    action, rest = args[0], args[1:]
    try:
        if action == "add":
            if not rest:
                sys.exit(usage)
            name = rest[0]
            provider, secret, index = "generic", None, 1
            while index < len(rest):
                if rest[index] == "--provider" and index + 1 < len(rest):
                    provider, index = rest[index + 1], index + 2
                elif rest[index] == "--secret" and index + 1 < len(rest):
                    secret, index = rest[index + 1], index + 2
                else:
                    sys.exit(usage)
            if secret is None:
                secret = getpass.getpass("Secret: ")
            entry = vibe_keys.add_entry(PATHS.state, name, provider, secret)
            print(f"Gespeichert: {entry['name']} ({entry['provider']}, {entry['id'][:8]})")
        elif action == "select":
            if not rest:
                sys.exit(usage)
            entry = vibe_keys.select_entry(PATHS.state, rest[0])
            print(f"Ausgewählt: {entry['name']} ({entry['provider']})")
        elif action == "list":
            entries = vibe_keys.list_entries(PATHS.state)
            print("Keine Einträge vorhanden" if not entries else "Name                 Provider          Maske")
            for entry in entries:
                print(f"{entry['name']:<20} {entry['provider']:<16} {entry['masked']}")
        elif action == "remove":
            if not rest:
                sys.exit(usage)
            ok, message = vibe_keys.remove_entry(PATHS.state, rest[0])
            print(message)
            if not ok:
                sys.exit(2)
        else:
            sys.exit(usage)
    except (ValueError, OSError) as error:
        sys.exit("Keys: " + str(error))

def ui_session():
    return profile_session("vibe-ui")

UI_PASSWORD_USAGE = "Aufruf: vibe ui password [set [--stdin]|clear|status]"

def _ui_password(sub, use_stdin=False):
    """Setzt, entfernt oder zeigt das Dashboard-Anmeldekennwort (AP18).

    Das Kennwort läuft nie über Kommandozeilenargumente (Prozessliste und
    Shell-History): interaktiv liest getpass ohne Echo und verlangt eine
    Wiederholung, für Skripte liest ``--stdin`` genau eine Zeile. Die
    Fachlogik (Mindestlänge 8, atomares Schreiben, nur der Hash landet in
    ui.json) bleibt in vibe_ui_config — CLI und Web nutzen dieselbe
    Prüfung. Ein laufendes Dashboard liest ui.json vor jeder Kennwort-
    Anmeldung neu, daher ist kein Neustart nötig.
    """
    if vibe_ui_config is None:
        sys.exit("vibe_ui_config.py fehlt in der Installation; "
                 "bitte Setup --update ausführen.")
    if sub == "status":
        try:
            data = vibe_ui_config.load(PATHS.state)
        except (vibe_ui_config.ConfigError, vibe_paths.ConfigError) as error:
            sys.exit("Dashboard-Konfiguration: " + str(error))
        if data.get("password_hash"):
            print("Dashboard-Kennwort: gesetzt")
        else:
            print("Dashboard-Kennwort: nicht gesetzt (Anmeldung nur mit Instanz-Token)")
        return
    if sub == "clear":
        try:
            removed = vibe_ui_config.clear_password(PATHS.state)
        except (vibe_ui_config.ConfigError, vibe_paths.ConfigError) as error:
            sys.exit("Dashboard-Kennwort nicht entfernt: " + str(error))
        print("Dashboard-Kennwort entfernt." if removed is not None
              else "Kein Dashboard-Kennwort gesetzt; nichts geändert.")
        return
    # sub == "set": Kennwort beschaffen, nie als Argument annehmen.
    if use_stdin:
        password = sys.stdin.readline().rstrip("\r\n")
        if not password:
            sys.exit("Kein Kennwort von der Standardeingabe gelesen; nichts geändert.")
    else:
        if not sys.stdin.isatty():
            sys.exit("Kennwort-Eingabe erfordert ein Terminal; "
                     "für Skripte: vibe ui password set --stdin.")
        import getpass
        password = getpass.getpass(
            "Dashboard-Kennwort (Eingabe bleibt unsichtbar): ")
        if password != getpass.getpass("Dashboard-Kennwort (Wiederholung): "):
            sys.exit("Die Eingaben stimmen nicht überein; nichts geändert.")
    try:
        vibe_ui_config.set_password(PATHS.state, password)
    except (vibe_ui_config.ConfigError, vibe_paths.ConfigError) as error:
        sys.exit("Dashboard-Kennwort nicht gesetzt: " + str(error))
    print("Dashboard-Kennwort gesetzt; Anmeldung im Dashboard mit diesem "
          "Kennwort (Eintrag „Zugriffssicherheit“ zeigt den Zustand).")

def _ui_arguments(arguments):
    """Zerlegt ``vibe ui``-Argumente in Aktion und Port-/Bind-Übergaben.

    ``start``/``stop``/``password`` werden nur an Position 0 als Aktion
    gelesen, damit sie nicht mit Werten verwechselt werden;
    ``--port``/``--bind`` sind anywhere erlaubt. Rückgabe (aktion,
    overrides-dict); bei ``password`` liegt die Unteraktion in
    ``password_sub`` und die ``--stdin``-Marke in ``password_stdin``.
    """
    args = list(arguments or [])
    action = None
    if args and args[0] in ("start", "stop", "password"):
        action = args.pop(0)
    if action == "password":
        sub = None
        use_stdin = False
        while args:
            value = args.pop(0)
            if value in ("set", "clear", "status") and sub is None:
                sub = value
            elif value == "--stdin":
                use_stdin = True
            else:
                sys.exit(UI_PASSWORD_USAGE)
        if use_stdin and sub != "set":
            # Review AP18 Runde 1 (Minor): --stdin gehört ausdrücklich zu
            # set; sonst würde ein Skript eine Statusausgabe erhalten und
            # sein Kennwort nie lesen.
            sys.exit(UI_PASSWORD_USAGE)
        return "password", {"password_sub": sub or "status",
                            "password_stdin": use_stdin}
    overrides = {}
    while args:
        flag = args[0]
        if flag == "--port" and len(args) >= 2:
            overrides["ui_port"] = args[1]
        elif flag == "--bind" and len(args) >= 2:
            overrides["ui_bind"] = args[1]
        else:
            sys.exit("Aufruf: vibe ui [start|stop] [--port <n>] [--bind <ip>]")
        args = args[2:]
    return action or "start", overrides

def cmd_ui(arguments=None):
    """Startet oder beendet das Dashboard (AP13: Port/Bind je Aufruf) oder
    verwaltet das Anmeldekennwort (AP18: ``vibe ui password …``).

    Priorität: Defaults < ui.json (Zustandsordner) < Umgebung < CLI-Übergabe
    — „CLI überschreibt immer Konfiguration". CLI-Werte werden vorab
    validiert: Eine ungültige Übergabe beendet den Aufruf, bevor etwas
    gestartet oder geändert wird.
    """
    session = ui_session()
    # Rückwärtskompatibel: Ältere Aufrufer (Tests, Menü) übergeben die Aktion
    # als einzelnen String statt als Argumentliste.
    if isinstance(arguments, str):
        arguments = [arguments]
    action, overrides = _ui_arguments(arguments)
    if action == "password":
        _ui_password(overrides["password_sub"], overrides["password_stdin"])
        return
    try:
        for key in ("ui_port", "ui_bind"):
            if key in overrides:
                validator = (vibe_paths.validate_port if key == "ui_port"
                             else vibe_paths.validate_bind)
                overrides[key] = validator(overrides[key])
    except vibe_paths.ConfigError as error:
        sys.exit(str(error))
    if action == "stop":
        if not tmux_session_exists(session):
            print("Dashboard läuft nicht.")
            return
        if not session_owned(session, "ui"):
            sys.exit(f"tmux-Sitzung {session} gehört nicht zu vibe; nichts beendet.")
        run(["tmux", "kill-session", "-t", session]); print("Dashboard beendet."); return
    extra_config = {}
    if vibe_ui_config is not None:
        try:
            extra_config = vibe_ui_config.config_extra(PATHS.state)
        except (vibe_ui_config.ConfigError, vibe_paths.ConfigError) as error:
            sys.exit("Dashboard-Konfiguration: " + str(error))
    try:
        paths = PATHS if not (overrides or extra_config) else vibe_paths.resolve(
            overrides=overrides or None, extra_config=extra_config or None)
    except vibe_paths.ConfigError as error:
        sys.exit("Pfadkonfiguration: " + str(error))
    try:
        vibe_paths.ensure(PATHS, "runtime")
    except vibe_paths.ConfigError as error:
        sys.exit("Pfadkonfiguration: " + str(error))
    if dashboard_health(paths.ui_bind, paths.ui_port):
        print("Dashboard läuft bereits:", f"http://{paths.ui_bind}:{paths.ui_port}/")
        return
    if port_in_use(paths.ui_bind, paths.ui_port):
        sys.exit(f"Port {paths.ui_port} ist belegt, aber kein eigenes Dashboard erkannt; nichts gestartet.")
    if tmux_session_exists(session):
        if not session_owned(session, "ui"):
            sys.exit(f"tmux-Sitzung {session} gehört nicht zu vibe; nichts gestartet.")
        print("Dashboard-Sitzung läuft bereits, antwortet aber noch nicht:", f"http://{paths.ui_bind}:{paths.ui_port}/")
        return
    # Aufgelöste Pfade und Ports ausdrücklich übergeben, damit der
    # Kindprozess dieselbe Konfiguration verwendet; shlex.quote schützt
    # Pfade mit Leerzeichen und Sonderzeichen.
    inner = "source ~/.bashrc; " + child_exports(paths) + ' exec python3 "$1"'
    rc, out = run(["tmux", "new-session", "-d", "-s", session,
                   "-e", MANAGED_VAR + "=ui", "bash", "-lc",
                   inner, "vibe-ui", os.path.join(BIN, "vibe-web.py")])
    if rc != 0:
        sys.exit("Dashboard nicht gestartet: " + out)
    time.sleep(2)
    tokf = os.path.join(LOGS, "web.token")
    tok = open(tokf).read().strip() if os.path.exists(tokf) else "?"
    print(col("g", f"Dashboard ({PATHS.profile}): http://{paths.ui_bind}:{paths.ui_port}/#t={tok}"))
    if paths.ui_bind == "127.0.0.1":
        print("(nur lokal erreichbar; Beenden: Knopf im Dashboard oder vibe ui stop)")
    else:
        # AP13: Netzexposition nicht verschweigen. Die gedruckte URL trägt
        # die Bind-Adresse (z. B. 0.0.0.0), die auf fremden Rechnern nicht
        # adressierbar ist; andere Rechner erreichen das Dashboard über die
        # IP-Adresse dieses Rechners. Die Gegenmaßnahmen (IP-Allowlist,
        # Kennwort) werden an ihrer Stelle in der Karte „Zugriffssicherheit"
        # des Dashboards gepflegt.
        print("(Achtung: über das Netzwerk erreichbar. Vom anderen Rechner "
              "aus erreichst du das Dashboard über die IP-Adresse dieses "
              "Rechners. Allowlist und Kennwort stellst du im Dashboard in "
              "der Karte „Zugriffssicherheit“ ein; Beenden: vibe ui stop)")

def cmd_paths(*arguments):
    """Zeigt Profil, Pfade und Ports; ändert nichts und startet nichts."""
    options = [str(value) for value in arguments if value]
    as_json = "--json" in options
    requested = [value for value in options if value != "--json"]
    if len(requested) > 1 or any(value not in vibe_paths.PROFILES for value in requested):
        sys.exit("Aufruf: vibe paths [prod|dev] [--json]")
    try:
        paths = PATHS if not requested else vibe_paths.resolve(profile=requested[0])
    except vibe_paths.ConfigError as error:
        sys.exit("Pfadkonfiguration: " + str(error))
    if as_json:
        print(json.dumps(paths.as_dict(), indent=2, ensure_ascii=False)); return
    def presence(target): return "vorhanden" if os.path.isdir(target) else "fehlt"
    print(col("b", "Profil, Pfade und Ports"))
    for label, value in (
        ("Profil", paths.profile),
        ("Quellen", paths.source),
        ("Arbeitsbereich", paths.workspace),
        ("Installation", paths.install),
        ("Laufzeit", paths.runtime),
        ("Zustand", paths.state),
        ("Konfiguration", paths.config_file),
        ("Agenten", paths.agents_dir),
        ("Container", paths.container),
    ):
        suffix = "" if label in ("Profil", "Container") else "  (" + presence(value) + ")"
        print(f"  {label + ':':<16}{value}{suffix}")
    print(f"  {'Dashboard:':<16}http://{paths.ui_bind}:{paths.ui_port}/")
    print(f"  {'opencode:':<16}{paths.opencode_url}/")
    print("(Priorität: Defaults < persönliche Datei < Umgebung < Übergabe; nur diese Anzeige, keine Änderung)")

def doctor_checks():
    r = []
    def chk(label, ok, hint="", warn=False):
        # F26: Ein Hinweis bei bestandener Prüfung erscheint nur mit warn=True;
        # sonst bleibt ok+hint die gewohnte reine OK-Zeile (Installationshinweise).
        r.append((label, bool(ok), hint if (warn or not ok) else ""))
    chk("im Container", in_container(), "distrobox enter " + CONTAINER)
    chk(f"VIBE-Ordner beschreibbar ({VIBE})", os.access(VIBE, os.W_OK))
    for tool, hint in (("git", ""), ("tmux", "sudo dnf install -y tmux"), ("java", "sudo dnf install -y java-25-openjdk-devel"), ("android", "Android CLI installieren"), ("adb", "android sdk install platform-tools"), ("python3", ""), ("curl", ""), ("flock", "util-linux")):
        chk(tool, shutil.which(tool) is not None, hint)
    try:
        selected = vibe_harness.read_selection(PATHS.state)
    except vibe_harness.HarnessError as error:
        selected = None
        chk("Harness-Auswahl", False, str(error))
    if selected:
        info = vibe_harness.definition(selected)
        chk(info["name"] + " installiert (" + info["binary"] + ")",
            shutil.which(info["binary"]) is not None, info["hint"])
        if selected == "opencode":
            version = vibe_opencode.probe()
            if version.checked:
                chk("opencode-Version " + version.version, True, "")
            elif version.supported:
                # F26: Vermutlich kompatibel über das Fallback-Profil; kein
                # Fehler, aber sichtbarer Hinweis mit der ungeprüften Version.
                chk("opencode-Version " + version.version + " (nicht geprüft)",
                    True, version.message, warn=True)
            else:
                chk("opencode-Version " + (version.version or "?"), False, version.message)
        else:
            chk("node für " + info["name"] + " (22.19+)",
                shutil.which("node") is not None,
                "Node.js 22.19 oder neuer installieren: " + info["official"])
            probe = vibe_harness.probe(selected)
            chk(info["name"] + "-Version " + (probe["version"] or "?"),
                probe["status"] == "ready", probe["message"])
    chk("/dev/kvm", os.path.exists("/dev/kvm"), "KVM fehlt")
    chk("ANDROID_HOME gesetzt", bool(os.environ.get("ANDROID_HOME")), "source ~/.bashrc im Container")
    chk("Abnahme-Dateien + Prüfsummen", os.path.exists(os.path.join(VERIFY, "verify.sh")) and run(["sha256sum", "-c", os.path.expanduser("~/.config/schreibfuchs-verify.sha"), "--quiet"], cwd=VERIFY)[0] == 0, "install.sh / install2.sh ausführen")
    for a, role in sorted(profiles_load().get("rollen", {}).items()):
        chk(f"Agent {a} ({role})", os.path.exists(os.path.join(AGENTS_DIR, a + ".md")))
    catalog = models_info()
    chk("models.json (Modellkatalog)", bool(catalog.get("models")), "install-vibe.sh ausführen")
    chk("Modellkatalog belegt", not catalog.get("findings"),
        "vibe models zeigt Quellen, Datum und Befunde")
    if os.path.isdir(VIBE):
        st = shutil.disk_usage(VIBE); chk(f"freier Platz auf Datenpartition: {st.free // 2**30} GB", st.free > 10 * 2**30, "unter 10 GB")
    h = shutil.disk_usage(os.path.expanduser("~")); chk(f"freier Platz im Home: {h.free // 2**30} GB", h.free > 5 * 2**30, "unter 5 GB")
    return r

def cmd_doctor():
    release = vibe_paths.release_info(PATHS)
    origin = {"installation": "Installation", "quelle": "Quelle"}.get(
        release["origin"], "unbekannt"
    )
    print(col("b", "Umgebung"))
    print("  Release: Version " + release["version"]
          + (" · Commit " + release["commit"] if release["commit"] else "")
          + " · " + origin)
    for label, ok, hint in doctor_checks():
        if ok and hint:
            print(f"  {col('y','HINW')} {label} -> {hint}")
        else:
            print(f"  {col('g','OK  ') if ok else col('r','FEHL')} {label}" + (f"  -> {hint}" if not ok and hint else ""))

def cmd_mcp(action="list", name=None, scope="global", backup=None):
    import vibe_mcp
    vibe_mcp.cli(action, name, scope, backup)

# ---------- Rückfragen (F16) ----------
ASK_DEFAULT_TIMEOUT = 90.0
ASK_AUTONOMOUS_HINT = ("Der Nutzer ist nicht erreichbar. Entscheide selbst und "
                       "dokumentiere die Entscheidung in deinem Abschlussbericht.")

def _ask_number(text, name):
    try:
        value = float(text)
    except (TypeError, ValueError):
        sys.exit(name + " ist keine Zahl: " + str(text))
    if value < 0:
        sys.exit(name + " darf nicht negativ sein.")
    return value

def _ask_value(args, index, option):
    if index >= len(args):
        sys.exit("Option " + option + " braucht einen Wert.")
    return args[index]

def _ask_answer_text(answer):
    return answer.get("option_text") or answer.get("text") or ""

def _ask_timeout(qid, timeout, seconds, runtime):
    print("Rückfrage " + qid + " noch offen (keine Antwort innerhalb von " + f"{timeout:g}" + " s).")
    print("Fortsetzen mit: vibe ask --wait " + qid + " --runtime " + runtime
          + " --timeout " + f"{seconds:g}" + "   (oder im Dashboard beantworten)")

def _ask_autonomous(qid, record=None, runtime=LOGS):
    """Hinweis an den Agenten, wenn der autonome Modus die Antwort ersetzt."""
    print("Autonomer Modus aktiv: Das Warten auf eine Antwort ist beendet; der Nutzer ist nicht erreichbar.")
    choice = '--option <nummer> --text "..."' if record and record.get("options") else '--text "..."'
    print("Entscheide selbst und dokumentiere die Entscheidung mit: vibe answer --runtime "
          + runtime + " " + qid + " " + choice + " --by agent")

def _project_for_cwd(runtime=None):
    """Projektname für das aktuelle Verzeichnis — auch aus einer Arbeitskopie."""
    name = vibe_questions.project_for_path(os.getcwd(), project_map())
    if name:
        return name
    if not runtime:
        return None
    # Agenten laufen in Worktrees außerhalb des Projektpfads: Die Registry
    # verknüpft den Arbeitskopie-Pfad mit dem echten Projektpfad.
    cwd = os.path.realpath(os.getcwd())
    projects = project_map()
    matches = []
    for entry in vibe_runs.WorktreeRegistry(runtime).all():
        path = str(entry.get("path") or "").strip()
        if not path:
            continue
        candidate = os.path.realpath(path)
        if cwd == candidate or cwd.startswith(candidate + os.sep):
            matches.append((len(candidate), str(entry.get("project") or "")))
    for _, project_root in sorted(matches, reverse=True):
        for mapped_name, mapped_path in projects.items():
            if _real(mapped_path) == _real(project_root):
                return mapped_name
    return None

def _ask_wait(qid, project, timeout, runtime):
    """Wartet auf eine Antwort; der autonome Modus beendet das Warten sofort."""
    if vibe_autonomous.is_enabled(runtime, project):
        return "stop", None
    return vibe_questions.wait_for(
        runtime, qid, timeout=timeout,
        stop=lambda: vibe_autonomous.is_enabled(runtime, project),
    )

def cmd_ask(args):
    """Stellt eine Rückfrage oder wartet auf die Antwort einer bestehenden."""
    text_parts, options = [], []
    project, wait_id = None, None
    timeout, free_text = ASK_DEFAULT_TIMEOUT, True
    runtime = LOGS
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--option":
            i += 1; options.append(_ask_value(args, i, "--option"))
        elif arg == "--runtime":
            i += 1; runtime = _ask_value(args, i, "--runtime")
        elif arg == "--project":
            i += 1; project = _ask_value(args, i, "--project")
        elif arg == "--timeout":
            i += 1; timeout = _ask_number(_ask_value(args, i, "--timeout"), "Zeitlimit")
        elif arg == "--wait":
            i += 1; wait_id = _ask_value(args, i, "--wait")
        elif arg == "--no-wait": timeout = 0.0
        elif arg == "--no-free": free_text = False
        elif arg.startswith("-"): sys.exit("Unbekannte Option: " + arg)
        else: text_parts.append(arg)
        i += 1
    text = " ".join(text_parts).strip()
    try:
        if wait_id:
            record = vibe_questions.load(runtime, wait_id)
            if record["answer"] is not None:
                print("Antwort: " + _ask_answer_text(record["answer"]))
                return
            mode, answer = _ask_wait(wait_id, record.get("project") or "", timeout, runtime)
            if mode == "answer":
                print("Antwort: " + _ask_answer_text(answer))
                return
            if mode == "stop" or vibe_autonomous.is_enabled(runtime, record.get("project") or ""):
                _ask_autonomous(wait_id, record, runtime); return
            _ask_timeout(wait_id, timeout, ASK_DEFAULT_TIMEOUT, runtime); sys.exit(3)
        if not text:
            sys.exit('Frage fehlt: vibe ask "Frage" [--option "A"] ...')
        if not project:
            # GH-58: Ein leerer --project-Wert gilt wie „nicht angegeben“,
            # sonst umginge er die Projektauflösung und damit den Wächter.
            project = _project_for_cwd(runtime) or ""
        else:
            ppath(project)
        if vibe_autonomous.is_enabled(runtime, project):
            print(vibe_questions.autonomous_message(project))
            print(ASK_AUTONOMOUS_HINT)
            return
        qid = vibe_questions.create(runtime, project=project, text=text, options=options, free_text=free_text)
        print("Rückfrage " + qid + " gestellt: " + text)
        print("Der Nutzer sieht sie im Dashboard; Antwort im Terminal: vibe answer --runtime "
              + runtime + " " + qid + " ...")
        if timeout <= 0:
            return
        mode, answer = _ask_wait(qid, project, timeout, runtime)
        if mode == "answer":
            print("Antwort: " + _ask_answer_text(answer)); return
        if mode == "stop" or vibe_autonomous.is_enabled(runtime, project):
            _ask_autonomous(qid, vibe_questions.load(runtime, qid), runtime); return
        _ask_timeout(qid, timeout, ASK_DEFAULT_TIMEOUT, runtime); sys.exit(3)
    except vibe_questions.AutonomousActiveError as error:
        # Wettlauf: Der Modus wurde zwischen Vorabprüfung und create aktiv.
        print(str(error))
        print(ASK_AUTONOMOUS_HINT)
        return
    except ValueError as error:
        sys.exit(str(error))

def cmd_answer(args):
    """Beantwortet eine Rückfrage aus dem Terminal."""
    qid, option, text, by = None, None, None, "cli"
    runtime = LOGS
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--option":
            i += 1; raw = _ask_value(args, i, "--option")
            if not raw.isdigit():
                sys.exit("--option braucht eine Nummer ab 1.")
            option = int(raw) - 1
        elif arg == "--runtime":
            i += 1; runtime = _ask_value(args, i, "--runtime")
        elif arg == "--text":
            i += 1; text = _ask_value(args, i, "--text")
        elif arg == "--by":
            i += 1; by = _ask_value(args, i, "--by")
        elif arg.startswith("-"): sys.exit("Unbekannte Option: " + arg)
        elif qid is None: qid = arg
        else: sys.exit("Nur eine Rückfrage-ID erlaubt.")
        i += 1
    if not qid:
        sys.exit('Rückfrage-ID fehlt: vibe answer <id> [--option <nummer>|--text "..."]')
    if option is None and text is None:
        sys.exit('Antwort fehlt: --option <nummer> oder --text "..."')
    try:
        answer = vibe_questions.answer(runtime, qid, option=option, text=text or "", by=by)
    except ValueError as error:
        sys.exit(str(error))
    print("Antwort gespeichert: " + _ask_answer_text(answer))

def cmd_autonomous(args):
    """Schaltet den autonomen Modus um oder zeigt seinen Zustand."""
    action, project, given = "status", None, False
    runtime = LOGS
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--project":
            i += 1; project = _ask_value(args, i, "--project")
        elif arg == "--runtime":
            i += 1; runtime = _ask_value(args, i, "--runtime")
        elif arg.startswith("-"): sys.exit("Unbekannte Option: " + arg)
        else:
            if given: sys.exit("Nur eine Aktion erlaubt (on, off, status).")
            action, given = arg, True
        i += 1
    if action not in ("on", "off", "status"):
        sys.exit("Unbekannte Aktion: " + action + " (erlaubt: on|off|status)")
    if project is None:
        project = _project_for_cwd(runtime) or ""
    elif project:
        ppath(project)
    try:
        if action == "status":
            state = vibe_autonomous.status(runtime, project)
            where = " für " + project if project else ""
            print("Autonomer Modus" + where + ": " + ("aktiv" if state["enabled"] else "aus"))
            if state["changed"]:
                print("Geändert: " + state["changed"])
            return
        state = vibe_autonomous.set_enabled(runtime, project, action == "on")
        where = " für " + project if project else ""
        print("Autonomer Modus" + where + (" aktiviert." if state["enabled"] else " ausgeschaltet."))
        if state["enabled"]:
            print("Ohne Antwort entscheidet der Agent selbst und dokumentiert die Entscheidung mit vibe answer.")
    except ValueError as error:
        sys.exit(str(error))


def cmd_questions():
    """Zeigt alle offenen Rückfragen mit ihren Auswahlmöglichkeiten."""
    items = vibe_questions.open_questions(LOGS)
    if not items:
        print("Keine offenen Rückfragen.")
        return
    for item in items:
        where = " [" + item["project"] + "]" if item["project"] else ""
        print(item["id"] + where + " " + item["text"])
        for number, label in enumerate(item["options"], 1):
            print("  " + str(number) + ") " + label)
        if not item["options"]:
            print("  (freie Antwort)")

# ---------- Menü ----------
def pick(title, options):
    print("\n" + col("b", title))
    for i, o in enumerate(options, 1): print(f"  {i}) {o}")
    print("  0) zurück")
    s = input("> ").strip()
    return int(s) - 1 if s.isdigit() and 1 <= int(s) <= len(options) else None

def project_menu(name):
    acts = ["Status / offene Arbeitspakete", "Agentenlauf starten", "An Lauf anhängen (tmux)", "Log verfolgen", "Lauf beenden",
            "Prüfung quick", "Prüfung package", "Prüfung full", "Feedback eintragen", "Git-Verlauf (10)", "opencode-Sitzungen", "Lauf mit anderem Agent", "Für vibe vorbereiten (init)", "Neuer Projekt-Agent", "MCP-Tools des Projekts", "Schreibrechte (Verzeichnisse)", "Pause nach aktuellem Arbeitspaket (an/aus)", "Sandbox (Shell und Build-Tools)"]
    while True:
        i = pick(f"Projekt {name} ({ptype(name)})", acts)
        if i is None: return
        p = ppath(name)
        {0: lambda: cmd_status(name), 1: lambda: cmd_run(name), 2: lambda: cmd_attach(name), 3: lambda: cmd_logs(name), 4: lambda: cmd_stop(name),
         5: lambda: cmd_verify(name, "quick"), 6: lambda: cmd_verify(name, "package"), 7: lambda: cmd_verify(name, "full"), 8: lambda: cmd_feedback(name),
         9: lambda: print(git_run(p, "log", "--oneline", "-10")[1]), 10: lambda: print(run(["opencode", "session", "list"], cwd=p)[1]),
         11: lambda: cmd_run(name, input("Agent-Name: ").strip() or None), 12: lambda: cmd_init(name),
         13: lambda: cmd_agent("new", input("Agent-Name: ").strip(), name), 14: lambda: cmd_mcp("list", None, name), 15: lambda: cmd_rights(name),
         16: lambda: cmd_pause(name, "off" if pause_after_active(name) else "on"), 17: lambda: cmd_sandbox(name)}[i]()

def menu():
    while True:
        ps = projects()
        print(); cmd_list()
        i = pick("Hauptmenü", ["Projekt öffnen", "Neues Projekt", "Entwicklungsordner verwalten", "Agenten anzeigen", "Agent anlegen/bearbeiten (global)", "Modelle (Einschätzung, Preis)", "Modell eines Agenten ändern",
                               "Profil wechseln (kostenlos/bezahlt)", "MCP-Tools anzeigen", "Emulator starten", "Emulator stoppen", "Dashboard (Browser) starten", "opencode-Server (Weboberfläche) starten", "Projekttypen anzeigen", "Doctor (Umgebung prüfen)",
                               "Harness anzeigen/wechseln (opencode/Pi)"])
        if i is None: return
        if i == 0:
            if not ps: print("Keine Projekte."); continue
            j = pick("Projekt wählen", ps)
            if j is not None: project_menu(ps[j])
        elif i == 1:
            n = input("Name (a-z, 0-9, -): ").strip(); ts = types(); k = pick("Typ", ts)
            if n and k is not None: cmd_new(n, ts[k])
        elif i == 2:
            cmd_roots(); p = input("Pfad hinzufügen (leer = nichts): ").strip()
            if p: cmd_roots("add", p)
        elif i == 3: cmd_agents()
        elif i == 4:
            n = input("Agent-Name: ").strip()
            if n: cmd_agent("edit" if os.path.exists(os.path.join(AGENTS_DIR, n + ".md")) else "new", n, "global")
        elif i == 5: cmd_models()
        elif i == 6: cmd_model(input("Agent: ").strip(), input("Modell (z. B. opencode/glm-5.3-flash-free): ").strip())
        elif i == 7: cmd_profile("list"); n = input("Profil anwenden (leer = nichts): ").strip(); (cmd_profile("use", n) if n else None)
        elif i == 8: cmd_mcp("list")
        elif i == 9: cmd_emu("start")
        elif i == 10: cmd_emu("stop")
        elif i == 11: cmd_ui(["start"])
        elif i == 12: cmd_server("start")
        elif i == 13: cmd_types()
        elif i == 14: cmd_doctor()
        elif i == 15:
            cmd_harness("status")
            n = input("Harness (opencode/pi, leer = nichts): ").strip()
            if n: cmd_harness("use", n)

def main():
    if not in_container() and not os.environ.get("VIBE_NO_CONTAINER") and shutil.which("distrobox"):
        os.execvp("distrobox", ["distrobox", "enter", CONTAINER, "--", "python3", os.path.realpath(__file__)] + sys.argv[1:])
    a = sys.argv[1:]
    if not a: return menu()
    c, r = a[0], a[1:]
    try:
        table = {"list": lambda: cmd_list(), "status": lambda: cmd_status(r[0]), "run": lambda: cmd_run_cli(r),

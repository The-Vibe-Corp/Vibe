# Quellen (BIN), Installation (TOOLS), Laufzeit (LOGS) und Zustand (CONF,
# PROFILES_FILE, BACKUPS) sind getrennte Rollen; siehe bin/vibe_paths.py.
# state bleibt standardmäßig der Installationsordner, damit bestehende
# Installationen ihre Einstellungen und Sicherungen wiederfinden.
VIBE = PATHS.workspace
TOOLS = PATHS.install
BIN = PATHS.code_bin
TPL = os.path.join(TOOLS, "templates")
VERIFY = os.path.join(TOOLS, "verify")
CONF = os.path.join(PATHS.state, "vibe.json")
MODELS_FILE = os.path.join(TOOLS, "models.json")
PROFILES_FILE = os.path.join(PATHS.state, "profiles.json")
BACKUPS = os.path.join(PATHS.state, "agent-backups")
LOGS = PATHS.runtime
INSTFILE = os.path.join(LOGS, "web.instance")
MANAGED_VAR = "VIBE_MANAGED"
AGENTS_DIR = PATHS.agents_dir

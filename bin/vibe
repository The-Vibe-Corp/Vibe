                 "runs": lambda: cmd_runs(r[0] if r else "list"),
                 "sessions": lambda: cmd_sessions(r),
                 "pause": lambda: cmd_pause(r[0], r[1] if len(r) > 1 else None),
                 "ask": lambda: cmd_ask(r), "questions": lambda: cmd_questions(),
                 "answer": lambda: cmd_answer(r),
                 "autonomous": lambda: cmd_autonomous(r),
                 "verify": lambda: cmd_verify(r[0], r[1] if len(r) > 1 else "quick"), "feedback": lambda: cmd_feedback(r[0]),
                 "new": lambda: cmd_new(r[0], r[1] if len(r) > 1 else "generic", r[2] if len(r) > 2 else None),
                 "clone": lambda: (lambda parsed: cmd_clone(parsed[0], parsed[1], branch=parsed[2]))(_parse_clone_cli(r)),
                 "init": lambda: cmd_init(r[0], r[1] if len(r) > 1 else None),
                 "roots": lambda: cmd_roots(r[0] if r else None, r[1] if len(r) > 1 else None), "scan": lambda: cmd_roots(),
                 "agents": lambda: cmd_agents(), "agent": lambda: cmd_agent(r[0], r[1], r[2] if len(r) > 2 else "global", r[3] if len(r) > 3 else None),
                 "project-agents": lambda: cmd_project_agents(r[0]),
                 "rights": lambda: cmd_rights(r[0], r[1] if len(r) > 1 else None, r[2] if len(r) > 2 else None),
                 "priority": lambda: cmd_priority(r[0], r[1] if len(r) > 1 else None, " ".join(r[2:]) if len(r) > 2 else None),
                 "sandbox": lambda: cmd_sandbox(r[0], r[1] if len(r) > 1 else None, r[2] if len(r) > 2 else None),
                 "models": lambda: cmd_models(r[0] if r else None), "model": lambda: cmd_model(r[0], r[1], r[2] if len(r) > 2 else "global"),
                 "profile": lambda: cmd_profile(r[0] if r else "list", r[1] if len(r) > 1 else None),

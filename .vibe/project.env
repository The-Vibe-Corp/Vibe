TYPE=generic
VERIFY_TOOLS="bash python3 git"
VERIFY_QUICK="python3 scripts/check-import-manifest.py && python3 scripts/check-syntax.py && python3 scripts/check-no-secrets.py"
VERIFY_PACKAGE="python3 scripts/check-import-manifest.py && python3 scripts/check-syntax.py && python3 scripts/check-no-secrets.py"
VERIFY_FULL="python3 scripts/check-import-manifest.py && python3 scripts/check-syntax.py && python3 scripts/check-no-secrets.py && python3 -m unittest discover -s tests/unit -v && python3 -m unittest discover -s tests/browser -v"
VERIFY_TESTS="tests/unit tests/browser"
VERIFY_TEST_PATTERN="Ran ([0-9]+) tests?"
VERIFY_MIN_TESTS=1
# MAX_PACKAGES=80   # Kostenbremse: bei bezahlten Modellen z. B. 5 setzen
SANDBOX="on"
SANDBOX_TOOLS="git python3 pylint"
TESTER=test-agent
GITHUB_ENABLED="1"
GITHUB_REPO="M0P/Vibe"
GITHUB_LABEL="vibe_marc"
GITHUB_API=""
